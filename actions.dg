(extension version)
	(line) Hittite action processing version 0.1 by Daniel Stelzer

(action logging) (fail)

(action log $Closure)
	(action logging)
	(log) (query $Closure)
(action log $) %% Always succeed

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Look: not really an action, but we implement it as one for now
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

(update description)
	(update environment around player)
	%% Do this in a status area if at all possible, either top or inline
	(if) (interpreter supports status bar) ($Lines lines needed for status bar) (then)
		(status bar @status with height $Lines) (describe environment)
	(elseif) (interpreter supports inline status bar) (then)
		(inline status bar @status) (describe environment)
	(else) %% Otherwise fall back to a div
		(div @status) (describe environment)
	(endif)
	(if) (using separate panels) (then)
		(compass rose panel)
		(verbs list panel)
	(endif)

($Lines lines needed for status bar)
	%% 1 header
	%% 1 line break
	%% If objects:
		%% 1 general
		%% 1 per container
		%% 1 line break
	%% If inventory:
		%% 1 inventory
		%% 1 line break
	%% If worn:
		%% 1 worn
		%% 1 line break
	%% 1 verbs
	
	%% Which means:
	%% Base 3
	%% +2 if objects
	%% +1 per container
	%% +2 if inventory
	%% +2 if worn
	
	(current player $Player)
	(current room $Room)
	
	(accumulate $N)
		($N = 3) (or)
		{ (something in the room) ($N = 2) } (or)
		{ *($Obj is #in $Room) ($ is #in $Obj) ($N = 1) } (or)
		{ ($ is #heldby $Player) ($N = 2) } (or)
		{ ($ is #wornby $Player) ($N = 2) }
	(into $Lines)

(something in the room)
	(current room $Room)
	*($Obj is #in $Room)
	~(current player $Obj)

(header (room $Room))
	($Room uses preverb $Prep)
	Nu=za
	(if) ($Prep is one of [#in #on #behind]) (then) %% anda, šēr, appa
		(no space) =kan
	(endif)
	(#dative $Room)
	(preverb $Prep)
	ešun.
(short name (inherently dark $Room))
	(current player $Player)
	~($Player has a light source)
	~($Room has a light source)
	dankui %% "Dark"
(short name (logogram $Room)) (name $Room in #bare)
(short name (room $Room)) (name $Room in #dative)
(short name (door $Door)) (name $Door in #accusative)
(short name $Obj) $Obj %% Don't crash

#darkness
(add * to scope)
(inherently dark *) %% Make the "go to a dark room" rules apply to this
(name * in #dative) dankui
(refuse [$Action $]) %% Prevent any interaction with this noun
	(* is one of $Action)
	~{ ($Action = [go *]) (or) ($Action = [travel *]) }
	(div @error) { Since the "darkness" is insubstantial, it's unclear what this action would entail. }

(describe environment)
	
	%% Compass rose belongs off to one side, but in debugger it has to be inline
	(if) (interpreter supports status bar) ~(using separate panels) (then)
		(compass rose)
	(endif)
	
	%% First paragraph: "I was at [location]."
	(current room $Loc)
	(action log {Current room: $Loc} )
	(header $Loc)
	
	%% Second paragraph: Nu apiya ("there", or kā "here"?) OBJECTS-ACC ōḫḫun.
	(collect $Obj)
		*($Obj is #in $Loc)
		~(current player $Obj)
	(into $HereList)
	(action log {Here: $HereList} )
	(if) (nonempty $HereList) (then)
		(par) Nu apiya
		(room description $HereList)
		ōḫḫun.
	(endif)
	
	%% Subsequent lines: Nu OBJECT-NOM CONTAINER-DAT anda ēšta/ešer
	(collect $Obj)
		*($Obj is #in $Loc)
		($ is $ $Obj)
	(into $ContainerList)
	(action log {Containers: $ContainerList} )
	(exhaust) {
		*($Container is one of $ContainerList)
		($Container wants relation $Rel)
		(collect $Obj)
			*($Obj is $ $Container)
		(into $ContentsList)
		(line) Nu
		(#nominative $ContentsList)
		(#dative $Container)
		(preverb $Rel)
		(if) ($ContentsList = [$]) (then) ēšta (else) ešer (endif)
		.
	}
	
	%% Third paragraph: Nu INVENTORY-ACC ḫarkun.
	(current player $Player)
	(collect $Obj)
		*($Obj is #heldby $Player)
	(into $HeldList)
	(action log {Held: $HeldList} )
	(if) (nonempty $HeldList) (then)
		(par) Nu
		(#accusative $HeldList)
		ḫarkun.
	(endif)
	
	%% Fourth paragraph: Nu CLOTHES-ACC waššiyanun.
	(collect $Obj)
		*($Obj is #wornby $Player)
	(into $WornList)
	(action log {Worn: $WornList} )
	(if) (nonempty $WornList) (then)
		(par) Nu
		(#accusative $WornList)
		waššiyanun.
	(endif)
	
	%% Final paragraph: verbs
	(if) ~(using separate panels) (then)
		(par) (div @verbs) (verbs list)
	(endif)
	
	%% Compass rose belongs off to one side, but in debugger it has to be inline
	(if) ~(interpreter supports status bar) ~(using separate panels) (then)
		(compass rose)
	(endif)

%% Some objects override this to add more detail if (and only if) they're on their own
(room description [$Single]) (room description $Single)
(room description $Whatever) (#accusative $Whatever)

(using separate panels) %% Only do this if it won't interfere with the normal stuff
	(interpreter supports status bar) (interpreter supports inline status bar)

(verbs list) ~(given first message)
(verbs list)
	(span @bold) { Verbs: }
	(collect $Verb)
		*(verb $Verb)
		(verb $Verb unlocked)
	(into $VerbList)
	(listing $VerbList {(hittite name $_)} @, 0)

(hittite name $Obj) (span @hittite) (name $Obj) %% TODO workaround for Dialog bug

(verbs list panel)
	(inline status bar @p-verbs) (verbs list)
(style class @p-verbs)
	margin-left: 2em;
	text-indent: -2em;
	data-language: en; %% Verbs are in @hittite spans inside this

(style class @verbs)
	width: 100\%;
	text-align: center;
	font-style: italic;
	data-language: en;

(interface ($<Dir on the compass rose is $>Obj))
($Dir on the compass rose is $Obj)
	(current room $Loc)
	(from $Loc go $Dir to $Obj)
	{ (room $Obj) (or) (door $Obj) }
($ on the compass rose is []) %% Use [] if there's no room that way

(length of single word $Word is $Length)
	(split word $Word into $List)
	(accumulate 1) *($ is one of $List) (into $Length)
(short name of $Obj needs $Num characters)
	(collect words) (short name $Obj) (into $Name)
	(if) ($Name = [$Word]) (then)
		(length of single word $Word is $Intermediate)
	(endif)
	(if) (direction numbers enabled) (then)
		($Intermediate plus 2 into $Num) %% 1 for digit 1 for space
	(else)
		($Intermediate = $Num)
	(endif)

(print name of [] number $ with alignment $ in $Width characters) %% Empty space
	(space $Width)
(print name of $Obj number $N with alignment $Align in $Width characters)
	
	%% First, figure out the alignment needed
	(short name of $Obj needs $Needed characters)
	(if) ($Needed > $Width) (then)
		(div @realerror) { $Obj too long! } (fail)
	(endif)
	($Width minus $Needed into $Excess)
	(if) ($Align = @l) (then) %% Left
		($Left = 0)
		($Right = $Excess)
	(elseif) ($Align = @r) (then) %% Right
		($Left = $Excess)
		($Right = 0)
	(elseif) ($Align = @u) (then) %% Center, top (offset left if odd)
		($Excess divided by 2 into $Right)
		($Excess minus $Right into $Left)
	(else) %% Center, bottom (offset right if odd)
		($Excess divided by 2 into $Left)
		($Excess minus $Left into $Right)
	(endif)
	
	%% Then, do the actual printing
	%% This should only be done in a fixed-width div or span, for obvious reasons
	(space $Left)
	(print name of $Obj number $N)
	(space $Right)

%% If the interpreter supports text alignment, we can also do a simpler thing
(print name of [] number $)
	(space 1) %% Keep alignment roughly consistent by ensuring the divs are never entirely empty
(print name of $Obj number $N)
	(if) (direction numbers enabled) (then) (link) $N (space 1) (endif)
	(short name $Obj)

%% Fancy one involving injecting into specific HTML elements
%% This should be changed to use (status panel $) when I get that proposal through
%% Right now it's using a hacked interpreter that makes (inline status bar $) act like (status panel $) eventually will
(compass rose panel) ~(given first message)
(compass rose panel)
	(#north on the compass rose is $North)
	(#east on the compass rose is $East)
	(#south on the compass rose is $South)
	(#west on the compass rose is $West)
	(#up on the compass rose is $Up)
	(#down on the compass rose is $Down)
	
	(inline status bar @c-north) (print name of $North number 2)
	(inline status bar @c-up) (print name of $Up number 5)
	(inline status bar @c-west) (print name of $West number 4)
	(inline status bar @c-rose) (rose star)
	(inline status bar @c-east) (print name of $East number 3)
	(inline status bar @c-down) (print name of $Down number 6)
	(inline status bar @c-south) (print name of $South number 1)

%% Set alignment for all the individual boxes
(style class @c-north)
	text-align: center;
(style class @c-up)
	text-align: right;
(style class @c-west)
	text-align: right;
(style class @c-rose)
	text-align: center;
	font-size: 2em;
(style class @c-east)
	text-align: left;
(style class @c-down)
	text-align: left;
(style class @c-south)
	text-align: center;

%% Normal one that works on any backend
(compass rose) ~(given first message)
(compass rose)
	(#north on the compass rose is $North)
	(#east on the compass rose is $East)
	(#south on the compass rose is $South)
	(#west on the compass rose is $West)
	(#up on the compass rose is $Up)
	(#down on the compass rose is $Down)
	
	(div @compass) {
		(div @compassline) { %% Line 1: north and up
			(if) (empty $Up) (then) %% Give more space to north
				(space 9)
				(print name of $North number 2 with alignment @u in 15 characters)
				(space 9)
			(else)
				(space 10)
				(space 1)
				(print name of $North number 2 with alignment @u in 10 characters)
				(space 2)
				(print name of $Up number 5 with alignment @r in 10 characters)
			(endif)
		}
		(div @compassline) { %% Line 2: west, rose, east
			(print name of $West number 4 with alignment @r in 15 characters)
			(space 1) (rose star) (space 1)
			(print name of $East number 3 with alignment @l in 15 characters)
		}
		(div @compassline) { %% Line 3: down, south
			(if) (empty $Down) (then) %% As above with up
				(space 9)
				(print name of $South number 1 with alignment @d in 15 characters)
				(space 9)
			(else)
				(print name of $Down number 6 with alignment @l in 10 characters)
				(space 2)
				(print name of $South number 1 with alignment @d in 10 characters)
				(space 1)
				(space 10)
			(endif)
		}
	}

(rose star) ✧ %% U+2727 WHITE FOUR POINTED STAR
(style class @compass)
	width: 33ch; %% 15 3 15, or 9 15 9, or 10 1 10 2 10
	float: right;
(style class @compassline)
	font-family: monospace, monospace;
	width: 100\%;
	height: 1em;

(verb @look/@oḫḫun/@ōḫḫun/@uḫḫun/@ūḫḫun means @ōḫḫun)
(@ōḫḫun wants cases [])
(@ōḫḫun wants cases [#accusative])
(translate [$ ōḫḫun $ [] | $] into [look])
(translate [$ ōḫḫun $ $Acc | $] into [examine $Acc])
(perform [[look] | $])
	(now) (update needed)
(perform [[examine $] | $]) %% Not a useful action in this game
	(now) (update needed)

#v-look
(verb *)
(name *) ōḫḫun
(verb * unlocked)

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% GO (and TRAVEL)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

(verb @go/@paun/@pāun means @pāun)
(@pāun wants cases [#dative])
(translate [$ pāun $ $ $Dat | $] into [go $Dat])
	(adjacent $Dat)
(translate [$ pāun $ $ $Dat | $] into [travel $Dat])
	~(adjacent $Dat)

(adjacent $Room)
	(current room $Loc)
	{ (from $Loc go $ to $Room) (or) (from $Loc through $ to $Room) }
(adjacent (current room $Room))
(adjacent #darkness)

%% For these specific actions, don't require targets to be in the same room
~(refuse [[go $] $])
~(refuse [[travel $] $])

(prevent [[go $Dest] $Details])
	(current room $Source)
	(from $Source through $Door to $Dest)
	(action log {Found door $Door})
	($Door blocks passage)
	(describe failed action [[go $Dest] $Details])
	(describe $Door blocking passage)

(describe $Door blocking passage) %% This should be overridden for each door if possible
	Nu (#nominative $Door) ḫattalwantaš ēšta. %% "The DOOR was closed."
(($Door is closed) blocks passage)
($ is closed) (fail) %% TODO do we even want this in the world model?

(prevent [[go (inherently dark $Dest)] $]) %% See also under CROSS
	(current player $Player)
	~($Player has a light source)
	~($Dest has a light source)
	Nu pēdan kuit dankui ēšta, %% "Because the place was dark..."
	parā natta taruḫḫun pāun. %% "...I was not able to go onward."

($Parent has a light source)
	*($Obj has ancestor $Parent)
	($Obj provides light)

(prevent [[go (current room $Dest)] $Details])
	(describe failed action [[go $Dest] $Details])
	Nu=za apēdani pēdi karū ešun. %% "I was already in that place."

(prevent [[go $Dest] $])
	~(room $Dest)
	(div @error) { This line is likely a scribal error. The verb (span @hittite) pāun "go" is generally used with locations, not objects; for things like doors and thresholds, the verb (span @hittite) šarraḫḫun "pass through" is used instead. }

(prevent [[go $Dest] $])
	(current room $Source)
	~{ (from $Source go $ to $Dest) (or) (from $Source through $ to $Dest) }
	(div @realerror) { ERROR: no immediate connection from source $Source to destination $Dest! How was this action created? }

(perform [[go $Dest] $])
	(enter $Dest)

%% "Travel" is the action invoked when the room isn't adjacent; it plots out a route and tries to move along it

(prevent [[travel $Dest] $Details])
	(current room $Source)
	~(first step from $Source to $Dest is $)
	(describe failed action [[travel $Dest] $Details])
	(div @error) { It seems there was no easy route between those locations, since the narrator states it as a simple fact that he could not travel from one to the other. }

(perform [[travel $Dest] $])
	(current room $Source)
	(shortest path from $Source to $Dest is $Path)
	(action log {Path: $Path})
	(attempt to travel along $Path)

(attempt to travel along [])
	(action log {Travel finished!})
	(inhibit next tick)
	(now) (update needed)
(attempt to travel along [$Head|$Rest])
	(current room $Source)
	(action log {Direction: $Head})
	(from $Source go $Head to $Dest)
	(action log {From $Source go $Head to $Dest})
	(try [[go $Dest] [[] pāon [] [] $Dest []]])
	(tick)
	(attempt to travel along $Rest) %% Recurse

#v-go
(verb *)
(name *) pāun
(verb * unlocked)

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% CROSS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%% Default Dialog uses the same verb for going to a room and going through a door, but in Hittite there are separate verbs for them

(verb @cross/@šarraḫḫun means @šarraḫḫun)
(@šarraḫḫun wants cases [#accusative])
(translate [$ šarraḫḫun $ $Acc | $] into [cross $Acc])

(prevent [[cross $Door] $])
	~(door $Door)
	(div @error) { This line is likely a scribal error. The verb (span @hittite) šaraḫḫun "pass through" is generally used with things like doors and thresholds. For going to a place, the verb (span @hittite) pāun is used instead. }

(prevent [[cross $Door] $Details])
	($Door blocks passage) %% See above under GO for details
	(describe failed action [[cross $Door] $Details])
	(describe $Door blocking passage)

(prevent [[cross $Door] $Details]) %% Copied from GO
	(current room $Room)
	(from $Room through $Door to $Dest)
	(inherently dark $Dest)
	(current player $Player)
	~($Player has a light source)
	~($Dest has a light source)
	Nu pēdan kuit dankui ēšta, %% "Because the place was dark..."
	(describe raw failed action [[cross $Door] $Details]) %% "raw" = no connective, caps, or punctuation
	.

(prevent [[cross $Door] $])
	~{ (current room $Room) (from $Room through $Door to $Dest) (room $Dest) }
	(div @realerror) { ERROR: Cannot go through $Door ! What's going on? }

(perform [[cross $Door] $])
	(current room $Room)
	(from $Room through $Door to $Dest)
	(enter $Dest)

#v-cross
(verb *)
(name *) šarraḫḫun
(verb * unlocked)
	(#watchtower is visited)

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% GO shorthand: raw numbers
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%% 1: south
%% 2: north
%% 3: east
%% 4: west
%% 5: up (not attested)
%% 6: down (not attested)

(parse number list $Numbers)
	(stoppable) {
		(exhaust) {
			*($Num is one of $Numbers)
			(use direction number $Num)
		}
	}

(use direction number ~(number $Num))
	(div @realerror) { ERROR: How did non-number $Num get into the direction list? }
	(stop)
(use direction number $Num)
	{ ($Num < 1) (or) ($Num > 6) }
	(div @error) { Only the numbers 1 through 4 were used as shorthand for directions \( plus 5 and 6 in this particular text \) , so it's not clear what $Num would mean. }
	(stop)

(use direction number $Num)
	(number $Num means direction $Dir)
	(current room $Room)
	(if) (from $Room go $Dir to $Next) (then)
		(line) $Num (space 3)
		(if) (room $Next) (then)
			(try [[go $Next] [[$Num] pāun [] [] $Next []]])
		(elseif) (door $Next) (then)
			(try [[cross $Next] [[$Num] šarraḫḫun [] $Next [] []]])
		(else)
			(div @realerror) { ERROR: $Dir from $Room is $Next which is neither room nor door! }
			(stop)
		(endif)
	(else)
		(div @error) {
			The number $Num here presumably means going (name $Dir)(no space)ward, but it's unclear what would be in that direction.
		}
		(stop)
	(endif)

(number 1 means direction #south)
(number 2 means direction #north)
(number 3 means direction #east)
(number 4 means direction #west)
(number 5 means direction #up)
(number 6 means direction #down)

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% TAKE
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

(verb @take/@dāḫḫun/@daḫḫun means @dāḫḫun)
(@dāḫḫun wants cases [#accusative])
(@dāḫḫun wants cases [#accusative #ablative])
(translate [$ dāḫḫun $ $Acc $ []] into [take $Acc])
(translate [$ dāḫḫun $ $Acc $ $Abl] into [take $Acc from $Abl])

(instead of [[take $Obj] $Details]) %% Change to TAKE FROM if there's a holder
	($Obj is $ $Holder)
	~(room $Holder)
	~(current player $Holder)
	(action log {Redirecting TAKE $Obj to TAKE $Obj FROM $Holder})
	(if) ($Details = [$Raw $Verb $Adv $Obj [] []]) (then) %% Last two should always be empty
		(try [[take $Obj from $Holder] [$Raw $Verb $Adv $Obj [] $Holder]])
	(else)
		(div @realerror) { ERROR: Something went wrong converting TAKE to TAKE FROM. Details are $Details . }
	(endif)

(prevent [[take $Obj from $Holder] $Details])
	~($Obj is $ $Holder)
	($Holder wants relation $Rel)
	(describe failed action [[take $Obj from $Holder] $Details])
	Nu (#nominative $Obj) natta (#dative $Holder) (preverb $Rel) ēšta. %% "The OBJ was not REL the HOLDER."

(prevent [[take $Obj | $From] $Details]) %% Or is this message better?
	~(item $Obj)
	(describe failed action [[take $Obj | $From] $Details])
	(if) (neuter $Obj) (then)
		N=at mekki nakki
	(else)
		N=an mekki nakkiš
	(endif)
	ēšta. %% "It was very heavy."

(prevent [[take $Obj | $] $Details])
	(current player $Player)
	($Obj is #heldby $Player)
	(describe failed action [[take $Obj] $Details])
	(if) (neuter $Obj) (then)
		N=at
	(else)
		N=an
	(endif)
	karū ḫarkun. %% "I already held it"

(perform [[take $Obj | $] $])
	(narrate taking $Obj)
	(current player $Player)
	(now) ($Obj is #heldby $Player)
	(now) ($Obj is handled)
	(now) (update needed)

(narrate taking $) %% Nothing by default

#v-take
(verb *)
(name *) dāḫḫun
(verb * unlocked)
	(#street is visited)

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% DROP
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

(adverb @kattan/@katta/@down means @katta)

(verb @put/@tēḫḫun/@teḫḫun means @tēḫḫun)
(@tēḫḫun wants cases [#accusative #adverb])
(translate [$ tēḫḫun $Advs $Acc | $] into [drop $Acc]) (@katta is one of $Advs)

(refuse [[drop $Obj] $Details])
	(current player $Player)
	~($Obj has ancestor $Player)
	(describe failed action [[drop $Obj] $Details])
	(if) (neuter $Obj) (then)
		N=at
	(else)
		N=an
	(endif)
	natta ḫarkun. %% "I did not hold it."

(perform [[drop $Obj] $])
	(current room $Room)
	(now) ($Obj is #in $Room)
	(now) (update needed)

(verb #v-put) %% Ensure PUT is listed before DROP when both are unlocked

#v-drop
(verb *)
(name *) katta tēḫḫun
(verb * unlocked)
	(#ladder is handled)

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% PUT
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%% (verb $ means $) already done above
(@tēḫḫun wants cases [#accusative #dative])
(@tēḫḫun wants cases [#adverb #accusative #dative]) %% Optional preverb (currently ignored)
(translate [$ tēḫḫun $ $Acc (object $Dat) | $] into [put $Acc $Dat])

%% TODO: consider the preverb/postposition

%% We also handle tēḫḫun without dat or adv here, but only to give an error message
(@tēḫḫun wants cases [#accusative])
(translate [$ tēḫḫun [] $Acc [] | $] into [put $Acc])
(refuse [[put $] | $])
	(div @error) {
		This sentence seems to be incomplete. The verb (span @hittite) tēḫḫun should include a destination: either a noun in the dative, or an adverb like (span @hittite) katta "down" \( on the ground \) .
	}

(refuse [[put $Obj $Dest] $Details])
	(current player $Player)
	~($Obj has ancestor $Player)
	(describe failed action [[put $Obj $Dest] $Details])
	(if) (neuter $Obj) (then)
		N=at
	(else)
		N=an
	(endif)
	natta ḫarkun. %% "I did not hold it."

(prevent [[put $Obj $Dest] $Details])
	~(holder $Dest)
	(describe failed action [[put $Obj $Dest] $Details])
	(div @error) { Spatial relations in Hittite are a complicated topic, and it's not clear what arrangement the scribe was envisioning between the (span @hittite) (#accusative $Obj) and the (#dative $Dest). Whatever that arrangement was, it doesn't seem to have worked. }

(perform [[put $Obj $Dest] | $])
	(now) ($Obj is #in $Dest) %% TODO always #in?
	(now) (update needed)

#v-put
%% (verb *)
(name *) tēḫḫun
(verb * unlocked)
	(#gatehouse is visited)

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% SMITE
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

(verb @kuenun means @kuenun)
(@kuenun wants cases [#accusative #ablative])
(@kuenun wants cases [#adverb #accusative #ablative]) %% needs =kkan
(translate [$ kuenun $ $Acc | $] into [smite $Acc])

(prevent [[smite $] [$ $Advs | $]])
	~(@kan is one of $Advs)
	(div @error) { This sentence is likely a scribal error. The verb (span @hittite) kuenun "smite" requires the sentence particle =kan to be attached to the first word of the sentence. }

(prevent [[smite ~(animate $Obj)] $Details])
	(describe negative action [[smite $Obj] $Details]) %% negative, not failed: "did not" instead of "could not"
	(if) (neuter $Obj) (then)
		Na=at
	(else)
		Na=aš
	(endif)
	antuḫšaš natta ēšta. %% It was not a person.

(perform [[smite $Obj] $]) %% Remove a person from the game; prevent this if someone should be un-smiteable
	(now) ($Obj is nowhere)
	(now) (update needed)

#v-smite
(verb *)
(name *) kuenun
(verb * unlocked)
	(#foyer is visited)
