(extension version)
	(line) Hittite action processing version 0.1 by Daniel Stelzer

(action logging) (fail)

(action log $Closure)
	(action logging)
	(log) (query $Closure)
(action log $) %% Always succeed

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Look: not really an action, but we implement it as one for now
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

(update description)
	%% We'll eventually do this in a status area instead
	(update environment around player)
	(if) (interpreter supports inline status bar) (then)
		(inline status bar @inline) (describe environment)
%%	(elseif) (interpreter supports status bar) ($Lines lines needed for status bar) (then)
%%		(status bar @status with height $Lines) (describe environment)
	(else)
		(div @inline) (describe environment)
	(endif)

($Lines lines needed for status bar)
	%% 1 header
	%% 1 line break
	%% 3 compass rose
	%% 1 line break
	%% If objects:
		%% 1 general
		%% 1 per container
		%% 1 line break
	%% If inventory:
		%% 1 inventory
		%% 1 line break
	%% If worn:
		%% 1 worn
		%% 1 line break
	%% 1 verbs
	
	%% Which means:
	%% Base 7
	%% +2 if objects
	%% +1 per container
	%% +2 if inventory
	%% +2 if worn
	
	(current player $Player)
	(current room $Room)
	
	(accumulate $N)
		($N = 7) (or)
		{ (something in the room) ($N = 2) } (or)
		{ *($Obj is #in $Room) ($ is #in $Obj) ($N = 1) } (or)
		{ ($ is #heldby $Player) ($N = 2) } (or)
		{ ($ is #wornby $Player) ($N = 2) }
	(into $Lines)

(something in the room)
	(current room $Room)
	*($Obj is #in $Room)
	~(current player $Obj)

(header (room $Room)) Nu (#locative $Room) econ.
(short name (inherently dark $Room))
	(current player $Player)
	~($Player has a light source)
	~($Room has a light source)
	dankui %% "Dark"
(short name (logogram $Room)) (name $Room in #bare)
(short name (object $Room)) (name $Room in #dative)

#darkness
(add * to scope)
(inherently dark *) %% Make the "go to a dark room" rules apply to this
(name * in #dative) dankui
(refuse [$Action $]) %% Prevent any interaction with this noun
	(* is one of $Action)
	~{ ($Action = [go *]) (or) ($Action = [travel *]) }
	(div @error) { Since the "darkness" is insubstantial, it's unclear what this action would entail. }

(describe environment)
	%% First line: nu LOCATION-D econ.
	%% Compare: d^IŠKUR-ta [a]tta⸗šu[mmi] kuwapi ēšta URU^Liḫzini⸗w[a ]ešu[n] "Storm-god, our father, where were you?—I was in Lihzina"
	%% But we might want anda ec- instead of just ec- TODO
	(current room $Loc)
	(action log {Current room: $Loc} )
	(header $Loc)
	
	%% Second line: nu maninkuwan ("near") ROOM-N ēcta/ecer.
	%% TODO - do we want a compass rose instead? It would be better to have these names be in the dative, since that's what the player needs to use to go to them. But I can't think of a good phrasing that uses the dative.
	(collect $Room)
		*(from $Loc go $ to room $Room)
	(into $RoomList)
	(action log {Room list: $RoomList} )
%%	(if) (nonempty $RoomList) (then)
%%		(line) Nu maninkuwan
%%		(#nominative $RoomList)
%%		(if) ($RoomList = [$]) (then)
%%			ēcta
%%		(else)
%%			ecer
%%		(endif)
%%		.
%%	(endif)
	
	(compass rose) %% Experiment
	
	%% Second paragraph: Nu apiya ("there", or kā "here"?) OBJECTS-ACC ōhhon.
	(collect $Obj)
		*($Obj is #in $Loc)
		~(current player $Obj)
	(into $HereList)
	(action log {Here: $HereList} )
	(if) (nonempty $HereList) (then)
		(par) Nu apiya
		(#accusative $HereList)
		oohhon.
	(endif)
	
	%% Subsequent lines: Nu CONTAINER-DAT anda OBJECT-NOM ēcta/ecer
	%% Or should we use ecat/ecantat "to sit"?
	%% Solution: use forms of kitta "it lies"
		%% kittat(i) sg, kīyantat(i) pl
		%% Used for on, in, on top of...
		%% Anda(n) not necessary
	(collect $Obj)
		*($Obj is #in $Loc)
		($ is #in $Obj)
	(into $ContainerList)
	(action log {Containers: $ContainerList} )
	(exhaust) {
		*($Container is one of $ContainerList)
		(collect $Obj)
			*($Obj is #in $Container)
		(into $ContentsList)
		(line) Nu (#dative $Container)
		(#nominative $ContentsList)
		(if) ($ContentsList = [$]) (then) kittat (else) kīyantat (endif) %% Agreement
		.
	}
	
	%% Third paragraph: Nu INVENTORY-ACC harkon.
	(current player $Player)
	(collect $Obj)
		*($Obj is #heldby $Player)
	(into $HeldList)
	(action log {Held: $HeldList} )
	(if) (nonempty $HeldList) (then)
		(par) Nu
		(#accusative $HeldList)
		harkon.
	(endif)
	
	%% Fourth paragraph: Nu CLOTHES-ACC wēccon.
	(collect $Obj)
		*($Obj is #wornby $Player)
	(into $WornList)
	(action log {Worn: $WornList} )
	(if) (nonempty $WornList) (then)
		(par) Nu
		(#accusative $WornList)
		wēccon.
	(endif)
	
	%% Fifth paragraph: verbs. TODO how to phrase this?
	(par) Verbs:
	(collect $Verb)
		*(verb $Verb unlocked)
	(into $VerbList)
	(listing $VerbList {(name $_)} @, 0)

(interface ($<Dir on the compass rose is $>Obj))
($Dir on the compass rose is $Obj)
	(current room $Loc)
	(from $Loc go $Dir to $Obj)
	{ (room $Obj) (or) (door $Obj) }
($ on the compass rose is []) %% Use [] if there's no room that way

(compass rose)
	(#north on the compass rose is $North)
	(#east on the compass rose is $East)
	(#south on the compass rose is $South)
	(#west on the compass rose is $West)
	(#up on the compass rose is $Up)
	(#down on the compass rose is $Down)
	
	(div @compass) {
		(div @compassline) {
			(short name []) (short name $North) (short name $Up)
		}
		(div @compassline) {
			(short name $West) (space 3) <> (space 3) (short name $East)
		}
		(div @compassline) {
			(short name $Down) (short name $South) (short name [])
		}
	}

(short name []) (space 8)

(@look/@ohhon/@oohhon wants cases [])
(translate [$ look/ohhon/oohhon | $] into [look])
(perform [[look] $])
	(now) (update needed)

#v-look
(verb *)
(name *) ōhhon
(verb * unlocked)

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% GO
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

(@go/@paon wants cases [#dative])
(translate [$ go/paon/pāon $ $ $Dat | $] into [go $Dat])
	(adjacent $Dat)
(translate [$ go/paon/pāon $ $ $Dat | $] into [travel $Dat])
	~(adjacent $Dat)

(adjacent $Room)
	(current room $Loc)
	{ (from $Loc go $ to $Room) (or) (from $Loc through $ to $Room) }
(adjacent (current room $Room))
(adjacent #darkness)

%% For these specific actions, don't require targets to be in the same room
~(refuse [[go $] $])
~(refuse [[travel $] $])

(prevent [[go $Dest] $Details])
	(current room $Source)
	(from $Source through $Door to $Dest)
	(action log {Found door $Door})
	($Door blocks passage)
	(describe negative action [[go $Dest] $Details])
	(describe $Door blocking passage)

(describe $Door blocking passage)
	Nu (#nominative $Door) ictapanza ēcta. %% "The DOOR was closed."
(($Door is closed) blocks passage)

(prevent [[go (inherently dark $Dest)] $Details])
	(current player $Player)
	~($Player has a light source)
	~($Dest has a light source)
	(describe negative action [[go $Dest] $Details])
	Nu pedan dankuecta. %% "The place was dark."

($Parent has a light source)
	*($Obj has ancestor $Parent)
	($Obj provides light)

(prevent [[go (current room $Dest)] $Details])
	(describe negative action [[go $Dest] $Details])
	Nu=ci karū econ. %% "I was already there."

(prevent [[go $Dest] $Details])
	~(room $Dest)
	~(door $Dest)
	(describe negative action [[go $Dest] $Details])
	(div @error) { It's not clear what the verb "paon" would mean for something that can't be entered. It's primarily used for locations, or doors. }

(instead of [[go (door $Dest)] $Details])
	(current room $Loc)
	(action log { Tried to go a door; translating this action } )
	(if) (from $Loc through $Dest to $RealDest) (then) %% Put the door in the ablative, and the destination room in the dative
		($Details = [$Raw $Verb $Adv $Acc $ $Abl])
		($NewDetails = [$Raw $Verb $Adv $Acc [$RealDest] [$Dest|$Abl]])
		(action log { New action: [[go $RealDest] $NewDetails] } )
		(try [[go $RealDest] $NewDetails])
	(else)
		(describe negative action [[go $Dest] $Details]) %% This should never happen since a non-adjacent door shouldn't be in scope
		(div @realerror) { ERROR: Tried to enter a door \( $Dest \) but it is not adjacent! }
	(endif)

(prevent [[go (room $Dest)] $])
	(current room $Source)
	~{ (from $Source go $ to $Dest) (or) (from $Source through $ to $Dest) }
	(div @realerror) { ERROR: no path from source $Source to destination $Dest! }

(perform [[go $Dest] $])
	(enter $Dest)

%% "Travel" is the action invoked when the room isn't adjacent; it plots out a route and tries to move along it

(prevent [[travel $Dest] $Details])
	(current room $Source)
	~(first step from $Source to $Dest is $)
	(describe negative action [[travel $Dest] $Details])
	(div @error) { The author provided no further details, but it seems there was no easy route between those locations. }

(perform [[travel $Dest] $])
	(current room $Source)
	(shortest path from $Source to $Dest is $Path)
	(action log {Path: $Path})
	(attempt to travel along $Path)

(attempt to travel along [])
	(action log {Travel finished!})
	(now) (update needed)
(attempt to travel along [$Head|$Rest])
	(current room $Source)
	(action log {Direction: $Head})
	(from $Source go $Head to $Dest)
	(action log {From $Source go $Head to $Dest})
	(try [[go $Dest] [[] paon [] [] [$Dest] []]])
	(attempt to travel along $Rest) %% Recurse

#v-go
(verb *)
(name *) pāon
(verb * unlocked)

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% TAKE
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

(@take/@dahhon wants cases [#accusative])
(@take/@dahhon wants cases [#accusative #ablative])
(translate [$ take/dahhon $ $Acc $ []] into [take $Acc])
(translate [$ take/dahhon $ $Acc $ $Abl] into [take $Acc from $Abl])

(instead of [[take $Obj] $Details]) %% Change to TAKE FROM if there's a holder
	($Obj is #in $Holder)
	~(room $Holder)
	~(current player $Holder)
	(action log {Redirecting to take from $Holder})
	($Details = [$Raw $Verb $Adv [$Obj] [] []])
	(try [[take $Obj from $Holder] [$Raw $Verb $Adv [$Obj] [] [$Holder]]])

(prevent [[take $Obj from $Holder] $Details])
	~($Obj is #in $Holder)
	(describe negative action [[take $Obj from $Holder] $Details])
	Nu (#nominative $Obj) (#dative $Holder) (span @akk) {ūl} kittat. %% "The OBJ was not in the HOLDER."

(prevent [[take $Obj | $] $Details])
	~(item $Obj)
	(describe negative action [[take $Obj] $Details])
	N=an harkanna (span @akk) {ūl} tarhon. %% "I was not able to hold it"

(prevent [[take $Obj | $] $Details]) %% Or is this message better?
	~(item $Obj)
	(describe negative action [[take $Obj] $Details])
	N=an mekki
	(if) (neuter $Obj) (then)
		calli
	(else)
		callic
	(endif)
	ēcta. %% "It was very large."

(prevent [[take $Obj | $] $Details])
	(current player $Player)
	($Obj is #heldby $Player)
	(describe negative action [[take $Obj] $Details])
	N=an karū harkon. %% "I already held it"

(perform [[take $Obj | $] $])
	(narrate taking $Obj)
	(current player $Player)
	(now) ($Obj is #heldby $Player)
	(now) ($Obj is handled)
	(now) (update needed)

(narrate taking $) %% Nothing by default

#v-take
(verb *)
(name *) dahhon
(verb * unlocked)
	(#street is visited)

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% DROP
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

(adverb @kattan/@katta/@down means @katta)

(@put/@tehhon wants cases [#accusative #adverb])
(translate [$ put/tehhon katta $Acc | $] into [drop $Acc])

(refuse [[drop $Obj] $Details])
	(current player $Player)
	~($Obj has ancestor $Player)
	(describe negative action [[drop $Obj] $Details])
	N=an (span @akk) {ūl} harkon. %% "I did not hold it"

(perform [[drop $Obj] $])
	(current room $Room)
	(now) ($Obj is #in $Room)
	(now) (update needed)

#v-drop
(verb *)
(name *) katta tehhon
(verb * unlocked)
	(#ladder is handled)

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% PUT
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

(@put/@tehhon wants cases [#accusative #dative])
(translate [$ put/tehhon $ $Acc $Dat | $] into [put $Acc $Dat])

(refuse [[put $Obj $Dest] $Details])
	(current player $Player)
	~($Obj has ancestor $Player)
	(describe negative action [[put $Obj $Dest] $Details])
	N=an (span @akk) {ūl} harkon. %% "I did not hold it"

(prevent [[put $Obj $Dest] $Details])
	~(holder $Dest)
	(describe negative action [[put $Obj $Dest] $Details])
	N=an (#nominative $Dest) (span @akk) {ūl} harta. %% "The DEST did not hold it"

(perform [[put $Obj $Dest] $])
	(now) ($Obj is #in $Dest)
	(now) (update needed)

#v-put
(verb *)
(name *) tehhon
(verb * unlocked)
	(#gatehouse is visited)
