#me
(current player *)
(name * in #nominative/#bare) uuk
(name * in #genitive) ammel
(name * in #dative/#accusative/#ablative) ammuk
(* is #in #riverbank)

#riverbank
(room *)
(name * in #nominative) wappuc
(name * in #genitive) wappawac
(name * in #dative) wappi
(name * in #accusative) wappun
(name * in #ablative) wappuwaz
(name * in #bare) wappu
(from * go #north to #watchtower)

#river
(name * in #nominative/#genitive) hapac
(name * in #dative) hapi
(name * in #accusative) hapan
(name * in #ablative) hapaz
(name * in #bare) hapa
(dict * in $Case)
	*(dict #water in $Case)
(* is #in #riverbank)

(instead of [[take *] $])
	(current player $Player)
	(if) (#cup is #heldby $Player) ~(cup has water) (then)
		($Dest = #cup)
		(now) (cup has water)
	(elseif) (#urn is #heldby $Player) ~(urn has water) (then)
		($Dest = #urn)
		(now) (urn has water)
	(else)
		(fail) %% Fall back to the usual "I can't hold the water" message
	(endif)
	Nu (#accusative $Dest) (#ablative #water) cunnahon. %% "I filled the DEST with water."
	(now) (update needed)
	(tick)

#watchtower
(room *)
(name * in #nominative) awaric
(name * in #genitive/#dative) awariyac
(name * in #accusative) awarin
(name * in #ablative) awariyaz
(name * in #bare) awari
(from * go #south to #riverbank)
(from * go #west to #street)
(from * go #east to #wall)
(from * go #north through #gate to #gatehouse)

#gate
(door *)
(* blocks passage)
	{ (#bolt is #in *) (or) (#bolt is pristine) }
(describe * blocking passage)
	Nu ackac ciyanza ēcta. %% The gate was sealed.
(short name *) acki
(name * in #nominative)
	ackac (if) (* blocks passage) (then) ciyanza (else) haccanza (endif)
(name * in #genitive)
	ackac (if) (* blocks passage) (then) ciyandac (else) haccantac (endif)
(name * in #dative)
	acki (if) (* blocks passage) (then) ciyanti (else) haccanti (endif)
(name * in #accusative)
	ackan (if) (* blocks passage) (then) ciyantan (else) haccantan (endif)
(name * in #ablative)
	ackaz (if) (* blocks passage) (then) ciyantaz (else) haccantaz (endif)
(name * in #bare) acka

#street
(room *)
(name * in #nominative/#genitive) palcac
(name * in #dative) palci
(name * in #accusative) palcan
(name * in #ablative) palcaz
(name * in #bare) palca
(from * go #east to #watchtower)

#ladder
(item *)
(name * in #nominative/#genitive) ilac
(name * in #dative) ili
(name * in #accusative) ilan
(name * in #ablative) ilaz
(name * in #bare) ila
(* is #in #street)

#wall
(room *)
(header *) Nu kutti kattan econ. %% I was below the wall
(name * in #nominative) kuz
(name * in #genitive) kuttac
(name * in #dative) kutti
(name * in #accusative) kuttan
(name * in #ablative) kuttaz
(name * in #bare) kut
(dict * in *(grammatical case $)) kattan
(from * go #west to #watchtower)
(from * go #north to #corner)

#corner
(room *)
(neuter *)
(name * in #nominative/#accusative/#bare) halhaltomar
(name * in #genitive) halhaltomarac
(name * in #dative) halhaltomari
(name * in #ablative) halhaltomaraz
(* has modifier #wall)
(from * go #south to #wall)
(from * go #west through #window to #gatehouse)

#window
(door *)
(neuter *)
(* blocks passage)
	(current room $Room)
	~(#ladder is #in $Room)
(describe * blocking passage) Nu luttāi parku ēcta. %% "The window is high up"
(short name *) luttiya
(name * in #nominative/#accusative/#bare)
	(if) ~(current room #gatehouse) (then) hilamnac (endif) luttaai
(dict * in #nominative/#accusative/#bare)
	(if) ~(current room #gatehouse) (then) hilamnac (endif) luttai
(name * in #genitive)
	(if) ~(current room #gatehouse) (then) hilamnac (endif) luttiyac
(name * in #dative)
	(if) ~(current room #gatehouse) (then) hilamnac (endif) luttiya
(name * in #ablative)
	(if) ~(current room #gatehouse) (then) hilamnac (endif) luttanza
(* has modifier #gatehouse)
	~(current room #gatehouse)

#gatehouse
(room *)
(neuter *)
(name * in #nominative/#accusative/#bare) hilammar
(name * in #genitive) hilamnac
(name * in #dative) hilamni
(name * in #ablative) hilamnaz
(from * go #east through #window to #corner)
(from * go #south through #gate to #watchtower)
(from * go #west to #otherroom)

#bolt
(item *)
(neuter *)
(name * in #nominative/#accusative/#bare)
	(if) (bolt is burning) (then) warān (endif)
	GIC hattalu
(name * in #genitive)
	(if) (bolt is burning) (then) warantac (endif)
	GIC hattaluwac
(name * in #dative)
	(if) (bolt is burning) (then) waranti (endif)
	GIC hattaluwi
(name * in #ablative)
	(if) (bolt is burning) (then) warantaz (endif)
	GIC hattaluwaz

(after [[go #gatehouse] $]) %% Only describe it on the inside
	(* is pristine)
	(now) (* is #in #gate)

(narrate taking *)
	(* is pristine)
	Nu ackan hachon. %% "I opened the gate."
	(now) (update needed)

(instead of [[put * #hearth/#fire] $Details])
	(#fire is #in #hearth)
	(describe action [[put * #fire] $Details])
	Nu GIC hattalu lukket. %% "The bolt ignited."
	(now) (bolt is burning)
	(now) (update needed)
	(tick)

(instead of [[put * #river] $Details])
	(describe action [[put * #river] $Details])
	(now) ~(bolt is burning)
	(now) (update needed)
	(tick)

(* provides light)
	(bolt is burning)

#otherroom
(room *)
(name * in #nominative/#genitive) antalac
(name * in #dative) antali
(name * in #accusative) antalan
(name * in #ablative) antalaz
(name * in #bare) antala
(from * go #east to #gatehouse)
(from * go #north to #storeroom)

#hearth
(holder *)
(name * in #nominative/#genitive) haccac
(name * in #dative) hacci
(name * in #accusative) haccan
(name * in #ablative) haccaz
(name * in #bare) hacca
(* is #in #otherroom)

#fire
(neuter *)
(name * in #nominative/#accusative/#bare) pahhur
(name * in #genitive) pahhuenac
(name * in #dative) pahhueni
(name * in #ablative) pahhuenaz
(* is #in #hearth)

(prevent [[take $Obj from #hearth] $Details])
	(* is #in #hearth)
	(describe negative action [[take $Obj from #hearth] $Details])
	Nu pahhur ayyanza ēcta. %% "The fire was hot."

#cup
(item *)
(neuter *)
(name * in #nominative/#accusative/#bare) DUG zēri
(name * in #genitive) DUG zēriyac
(name * in #dative) DUG zēriya
(name * in #ablative) DUG zēriyaz
(* has modifier #water)
	(cup has water)
(dict * in $Case)
	(cup has water)
	*(dict #water in $Case)
(* is #in #hearth)

#watchman
(animate *)
(name * in #nominative) techallic LÚ halliyatallac %% Sleeping watchman
(name * in #genitive) techalliyac LÚ halliyatallac
(name * in #dative) techalliya LÚ halliyatalli
(name * in #accusative) techallin LÚ halliyatallan
(name * in #ablative) techalliyaz LÚ halliyatallaz
(name * in #bare) techalli LÚ halliyatalla
(* is #in #otherroom)

#storeroom
(room *)
(logogram *)
(name * in #bare) ARAH3
(inherently dark *)
(from * go #south to #otherroom)

#urn
(item *)
(logogram *)
(name * in #bare) DUG
(dict * in $Case)
	(urn has water)
	*(dict #water in $Case)
(* has modifier #water)
	(urn has water)
(* is #in #storeroom)

(instead of [[put * #hearth/#fire] $])
	(#fire is #in #hearth)
	(urn has water)
	(now) (#fire is nowhere)
	(now) ~(urn has water)
	Nu waatar pahheni tehhon. %% "I put the water on the fire..."
	N=an kictanunun. %% "...and extinguished it."
	(now) (update needed)

%% Never on-stage, but used by the parser
#water
(name * in #nominative/#accusative) waatar
(dict * in #nominative/#accusative) watar
(name * in #genitive) witenac
(name * in #dative) witeni
(name * in #ablative) wetenaz

(metacommand [test watchtower])
	(now) (#ladder is #in #corner)
	(now) (#ladder is handled)
	(now) (#street is visited)
	(now) (#bolt is pristine)
	(now) (#bolt is #in #gate)
	(enter #gatehouse)
