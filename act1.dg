(name * in #dative) antaki
(name * in #accusative) antakan
(name * in #ablative) antakaz
(name * in #bare) antaka
(inherently dark *)
(from * go #south to #foyer)

#amphora
(item *)
(name * in #nominative) DUG palhiš
(dict * in #nominative) DUG palhic
(name * in #accusative) DUG palhin
(name * in #genitive) DUG palhaš
(dict * in #genitive) DUG palhac
(name * in #dative) DUG palhi
(name * in #ablative) DUG palhaz
(dict * in $Case)
	(amphora has water)
	*(dict #water in $Case)
(* has modifier #water)
	(amphora has water)
(* is #in #storeroom)

(instead of [[put * #hearth/#fire] $])
	(#fire is #in #hearth)
	(amphora has water)
	(now) (#fire is nowhere)
	(now) ~(amphora has water)
	Nu wātar paḫḫeni tēḫḫon. %% "I put the water on the fire..."
	N=an kištanunun. %% "...and extinguished it."
	(now) (update needed)

%% Never on-stage, but used by the parser
#water
(name * in #nominative/#accusative) wātar
(dict * in #nominative/#accusative) watar
(name * in #genitive) witenaš
(dict * in #genitive) witenac
(name * in #dative) witeni
(name * in #ablative) witenaz

#backroom
(room *)
(neuter *)
(* uses preverb #in)
(name * in #nominative/#accusative/#bare) iškiša
(dict * in #nominative/#accusative/#bare) ickica
(name * in #genitive) iškišaš
(dict * in #genitive) ickicac
(name * in #dative) iškiši
(dict * in #dative) ickici
(name * in #ablative) iškišaz
(dict * in #ablative) ickicaz
(* has modifier #watchtower)
(from * go #south to #gatehouse)
(from * go #up to #roof)
(from * go #north to #enemyland)

(prevent [[cross #roof] $Details])
	(current room *)
	~(#ladder is #in *)
	(describe failed action [[cross #roof] $Details])
	Nu šuḫḫa parku ēšta. %% "The roof is high up"

(prevent [[cross #roof] $Details])
	(current player $Player)
	(#amphora is #heldby $Player)
	(describe failed action [[cross #roof] $Details])
	Nu palḫiš nakkiš ēšta. %% "The amphora is heavy."

#roof
(room *)
(neuter *)
(* uses preverb #on)
(name * in #nominative/#accusative/#bare) šuḫḫa
(dict * in #nominative/#accusative/#bare) cuhha
(name * in #genitive) šuḫḫaš
(dict * in #genitive) cuhhac
(name * in #dative) šuḫḫi
(dict * in #dative) cuhhi
(name * in #ablative) šuḫḫaz
(dict * in #ablative) cuhhaz
(from * go #down to #backroom)
(from * go #north to #precinct)

#precinct
(room *)
(neuter *)
(name * in #nominative/#accusative/#dative/#bare) ḫali
(dict * in #nominative/#accusative/#dative/#bare) hali
(name * in #genitive) ḫaliyaš
(dict * in #genitive) haliyac
(name * in #ablative) ḫaliyaz
(dict * in #ablative) haliyaz
(* has modifier @karimnaš)
(dict * in $) karimnac

%% For later: "temple" is É^karimmi, neuter: karimmi, karimnac, karimni, karimnaz

(instead of [[go *] $Details])
	(current player $Player)
	(if) (#cup is #heldby $Player) (cup has water) (then)
		(describe action [[go *] $Details])
		(div @narration) { The tablet breaks off here, as the soldier finally enters the temple precinct. }
		(game over { To be continued... } )
	(else)
		(describe failed action [[go *] $Details])
		Nu=za šaknuwanza ešon. Nu wātar natta ḫarkon. %% "I was impure. I did not have water."
	(endif)

#enemyland
(room *)
(* uses preverb #at)
(short name *) KÚR
(name * in #bare) URU LÚ KÚR
(logogram *)
(dict * in $) LU2 KUR2

(prevent [[go *] | $Details])
	(describe failed action [[go *] | $Details])
	%% Basic failure message should be enough, given the definitions of the words

(parse metacommand [\/test watchtower])
	(now) (#ladder is #in #corner)
	(now) (#ladder is handled)
	(now) (#street is visited)
	(now) (#bolt is pristine)
	(now) (#bolt is #in #gate)
	(enter #gatehouse)

(parse metacommand [\/test roof])
	(now) (#bolt is #heldby #me)
	(now) (bolt is burning)
	(now) (amphora has water)
