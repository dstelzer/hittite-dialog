(neuter *)
(name * in #nominative/#accusative/#bare) paḫḫur
(dict * in #nominative/#accusative/#bare) pahhur
(name * in #genitive) paḫḫuenaš
(dict * in #genitive) pahhuenac
(name * in #dative) paḫḫueni
(dict * in #dative) pahhueni
(name * in #ablative) paḫḫuenaz
(dict * in #ablative) pahhuenaz
