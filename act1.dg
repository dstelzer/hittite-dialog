(from * go #east to #watchtower)

#ladder
(item *)
(name * in #nominative) ilan
(name * in #genitive) ilanaš
(name * in #dative) ilani
(name * in #accusative) ilan
(name * in #ablative) ilanaz
(name * in #bare) ila
(* is #in #street)

(instead of [[cross *] $Details])
	($Details = [$Raw $Verb $Adv $ $Dat $Abl])
	(if) (current room #corner) (or) (current room #gatehouse) (then)
		(try [[cross #window] [$Raw $Verb $Adv #window $Dat $Abl]])
	(elseif) (current room #backroom) (then)
		(try [[go #roof] [$Raw $Verb $Adv #roof $Dat $Abl]])
	(else)
		(fail) %% Default message will say that non-doors can't be crossed
	(endif)

#wall
(room *)
(* uses preverb #under)
(name * in #nominative) kuzza
(name * in #genitive) kuttaš
(name * in #dative) kutti
(name * in #accusative) kuttan
(name * in #ablative) kuttaz
(name * in #bare) kut
(from * go #west to #watchtower)
(from * go #north to #corner)

#corner
