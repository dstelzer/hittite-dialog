(name * in #dative) ḫilamni
(name * in #ablative) ḫilamnaz
(from * go #east through #window to #corner)
(from * go #south through #gate to #watchtower)
(from * go #west to #foyer)
(from * go #north to #backroom)

#burning %% See below, only used for #bolt currently and thus has neuter declension
(adjective *)
(neuter *)
(name * in #nominative/#accusative/#bare) warān
(name * in #genitive) warantaš
(name * in #dative) waranti
(name * in #ablative) warantaz

#bolt
(item *)
(neuter *)
(determiner *) GIŠ
(* has modifier #burning) (bolt is burning)
(name * in #nominative/#accusative/#bare) ḫattalu
(name * in #genitive) ḫattaluwaš
(name * in #dative) ḫattaluwi
(name * in #ablative) ḫattaluwaz

(after [[cross #window] | $]) %% Only describe it on the inside
	(* is pristine)
	(now) (* is #in #gate)

(narrate taking *)
	(* is pristine)
	Nu āškan ḫašḫun. %% "I opened the gate."
	(now) (update needed)

(instead of [[put * #hearth/#fire] $Details])
	(#fire is #in #hearth)
	(describe action [[put * #fire] $Details])
	Nu (#nominative *) lukket. %% "The bolt ignited."
	(now) (bolt is burning)
	(now) (update needed)
	(tick)

(instead of [[put * #river] $Details])
	(describe action [[put * #river] $Details])
	(now) ~(bolt is burning)
	(now) (update needed)
	(tick)

(* provides light)
	(bolt is burning)

