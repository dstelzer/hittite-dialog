#me
(current player *)
(name * in #nominative/#bare) ūk
(name * in #genitive) ammel
(name * in #dative/#accusative/#ablative) ammuk
(* is #in #riverbank)

#riverbank
(room *)
(* uses preverb #at)
(name * in #nominative) wappuš
(dict * in #nominative) wappuc
(name * in #genitive) wappawaš
(dict * in #genitive) wappawac
(name * in #dative) wappi
(name * in #accusative) wappun
(name * in #ablative) wappuwaz
(name * in #bare) wappu
(from * go #north to #watchtower)

#river
(name * in #nominative/#genitive) ḫapaš
(dict * in #nominative/#genitive) hapac
(name * in #dative) ḫapi
(dict * in #dative) hapi
(name * in #accusative) ḫapan
(dict * in #accusative) hapan
(name * in #ablative) ḫapaz
(dict * in #ablative) hapaz
(name * in #bare) ḫapa
(dict * in #bare) hapa
(dict * in $Case)
	*(dict #water in $Case)
(* is #in #riverbank)

(instead of [[take *] $])
	(current player $Player)
	(if) (#cup is #heldby $Player) ~(cup has water) (then)
		($Dest = #cup)
		(now) (cup has water)
	(elseif) (#amphora is #heldby $Player) ~(amphora has water) (then)
		($Dest = #amphora)
		(now) (amphora has water)
	(else)
		(fail) %% Fall back to the usual "I can't hold the water" message
	(endif)
	Nu (#accusative $Dest) (#ablative #water) cunnahon. %% "I filled the DEST with water."
	(now) (update needed)
	(tick)

(prevent [[take *] $Details])
	(describe failed action [[take *] $Details])
	Nu wātar natta taruḫḫon ḫarkon. %% "I was not able to hold the water."

#watchtower
(room *)
(* uses preverb #infront)
(name * in #nominative) auriš
(dict * in #nominative) auric
(name * in #genitive) auriyaš
(dict * in #genitive) auriyac
(name * in #dative) auriya
(name * in #accusative) aurin
(name * in #ablative) auriyaz
(name * in #bare) auri
(* has modifier $Mod) ($Mod = {E2})
(from * go #south to #riverbank)
(from * go #west to #street)
(from * go #east to #wall)
(from * go #north through #gate to #gatehouse)

#gate
(door *)
(* blocks passage)
	{ (#bolt is #in *) (or) (#bolt is pristine) }
(describe * blocking passage) %% No extra description, "it's blocked" is in the adjective already
(short name *) aški
(name * in #nominative/#genitive)
	aškaš (if) (* blocks passage) (then) ḫattalwantaš (endif)
(dict * in #nominative/#genitive)
	ackac (if) (* blocks passage) (then) hattalwantac (endif)
(name * in #dative)
	aški (if) (* blocks passage) (then) ḫattalwanti (endif)
(dict * in #dative)
	acki (if) (* blocks passage) (then) hattalwanti (endif)
(name * in #accusative)
	aškan (if) (* blocks passage) (then) ḫattalwantan (endif)
(dict * in #accusative)
	ackan (if) (* blocks passage) (then) hattalwantan (endif)
(name * in #ablative)
	aškaz (if) (* blocks passage) (then) ḫattalwantaz (endif)
(dict * in #ablative)
	ackaz (if) (* blocks passage) (then) hattalwantaz (endif)
(name * in #bare) aška
(dict * in #bare) acka

#street
(room *)
(* uses preverb #at)
(name * in #nominative/#genitive) palšaš
(dict * in #nominative/#genitive) palcac
(name * in #dative) palši
(dict * in #dative) palci
(name * in #accusative) palšan
(dict * in #accusative) palcan
(name * in #ablative) palšaz
(dict * in #ablative) palcaz
(name * in #bare) palša
(dict * in #bare) palca
(from * go #east to #watchtower)

#ladder
(item *)
(name * in #nominative) ilaš
(dict * in #nominative) ilac
(name * in #genitive) ilanaš
(dict * in #genitive) ilanac
(name * in #dative) ilani
(name * in #accusative) ilan
(name * in #ablative) ilanaz
(name * in #bare) ila
(* is #in #street)

(instead of [[cross *] $Details])
	($Details = [$Raw $Verb $Adv $ $Dat $Abl])
	(if) (current room #corner) (or) (current room #gatehouse) (then)
		(try [[cross #window] [$Raw $Verb $Adv #window $Dat $Abl]])
	(elseif) (current room #backroom) (then)
		(try [[cross #roof] [$Raw $Verb $Adv #roof $Dat $Abl]])
	(else)
		(fail) %% Default message will say that non-doors can't be crossed
	(endif)

#wall
(room *)
(* uses preverb #under)
(name * in #nominative) kuzza
(name * in #genitive) kuttaš
(dict * in #genitive) kuttac
(name * in #dative) kutti
(name * in #accusative) kuttan
(name * in #ablative) kuttaz
(name * in #bare) kut
(from * go #west to #watchtower)
(from * go #north to #corner)

#corner
(room *)
(neuter *)
(* uses preverb #nextto)
(name * in #nominative/#accusative/#bare) ḫalḫaltomar
(dict * in #nominative/#accusative/#bare) ḫalḫaltomar
(name * in #genitive) ḫalḫaltomaraš
(dict * in #genitive) halhaltomarac
(name * in #dative) ḫalḫaltomari
(dict * in #dative) halhaltomari
(name * in #ablative) ḫalḫaltomaraz
(dict * in #ablative) halhaltomaraz
(* has modifier #wall)
(from * go #south to #wall)
(from * go #west through #window to #gatehouse)

#window
(door *)
(neuter *)
(* blocks passage)
	(current room $Room)
	~(#ladder is #in $Room)
(describe * blocking passage) N=at parku ēšta. %% "The window is high up"
(name * in #nominative/#accusative/#bare) luttāi
(dict * in #nominative/#accusative/#bare) luttai
(name * in #genitive) luttiyaš
(dict * in #genitive) luttiyac
(name * in #dative) luttiya
(name * in #ablative) luttiyaz
(* has modifier #gatehouse)
	~(current room #gatehouse)

#gatehouse
(room *)
(* uses preverb #in)
(neuter *)
(name * in #nominative/#accusative/#bare) ḫilammar
(dict * in #nominative/#accusative/#bare) hilammar
(name * in #genitive) ḫilamnaš
(dict * in #genitive) hilamnac
(name * in #dative) ḫilamni
(dict * in #dative) hilamni
(name * in #ablative) ḫilamnaz
(dict * in #ablative) hilamnaz
(* has modifier $Mod) ($Mod = {E2})
(from * go #east through #window to #corner)
(from * go #south through #gate to #watchtower)
(from * go #west to #foyer)
(from * go #north to #backroom)

#bolt
(item *)
(neuter *)
(name * in #nominative/#accusative/#bare)
	(if) (bolt is burning) (then) warān (endif)
	GIŠ ḫattalu
(dict * in #nominative)
	(if) (bolt is burning) (then) waran (endif)
	GIŠ hattalu
(name * in #genitive)
	(if) (bolt is burning) (then) warantaš (endif)
	GIŠ ḫattaluwaš
(dict * in #genitive)
	(if) (bolt is burning) (then) warantac (endif)
	GIŠ hattaluwac
(name * in #dative)
	(if) (bolt is burning) (then) waranti (endif)
	GIŠ ḫattaluwi
(dict * in #dative) hattaluwi
(name * in #ablative)
	(if) (bolt is burning) (then) warantaz (endif)
	GIŠ ḫattaluwaz
(dict * in #dative) hattaluwaz

(after [[go #gatehouse] | $]) %% Only describe it on the inside
	(* is pristine)
	(now) (* is #in #gate)

(narrate taking *)
	(* is pristine)
	Nu aškan ḫašḫon. %% "I opened the gate."
	(now) (update needed)

(instead of [[put * #hearth/#fire] $Details])
	(#fire is #in #hearth)
	(describe action [[put * #fire] $Details])
	Nu GIŠ ḫattalu lukket. %% "The bolt ignited."
	(now) (bolt is burning)
	(now) (update needed)
	(tick)

(instead of [[put * #river] $Details])
	(describe action [[put * #river] $Details])
	(now) ~(bolt is burning)
	(now) (update needed)
	(tick)

(* provides light)
	(bolt is burning)

