#me
(current player *)
(name * in #nominative/#bare) ūk
(name * in #genitive) ammel
(name * in #dative/#accusative/#ablative) ammuk
(* is #in #riverbank)

#riverbank
(room *)
(* uses preverb #at)
(name * in #nominative) wappuš
(name * in #genitive) wappuwaš
(name * in #dative) wappui
(name * in #accusative) wappun
(name * in #ablative) wappuwaz
(name * in #bare) wappu
(from * go #north to #watchtower)

#river
(name * in #nominative/#genitive) ḫapaš
(name * in #dative) ḫapi
(name * in #accusative) ḫapan
(name * in #ablative) ḫapaz
(name * in #bare) ḫapa
(dict * in $Case)
	*(dict #water in $Case)
(* is #in #riverbank)

(instead of [[take *] $])
	(current player $Player)
	(if) (#cup is #heldby $Player) ~(cup has water) (then)
		($Dest = #cup)
	(elseif) (#amphora is #heldby $Player) ~(amphora has water) (then)
		($Dest = #amphora)
	(else)
		(fail) %% Fall back to the usual "I can't hold the water" message
	(endif)
	Nu (#accusative #water) (#dative $Dest) tēḫḫun. %% "I put the water in the DEST."
	(if) ($Dest = #cup) (then) %% Gotta fill the vessel after printing the message, otherwise it'll look wrong ("I put the water in the cup of water")
		(now) (cup has water)
	(elseif) ($Dest = #amphora) (then)
		(now) (amphora has water)
	(endif)
	(now) (update needed)
	(tick)

(prevent [[take *] $Details])
	(describe failed action [[take *] $Details])
	Nu wātar natta taruḫḫun ḫarkun. %% "I was not able to hold the water."

#watchtower
(room *)
(* uses preverb #infront)
(name * in #nominative) auriš
(name * in #genitive) auriyaš
(name * in #dative) auriya
(name * in #accusative) aurin
(name * in #ablative) auriyaz
(name * in #bare) auri
%% (* has modifier $Mod) ($Mod = {E2})
(from * go #south to #riverbank)
(from * go #west to #street)
(from * go #east to #wall)
(from * go #north through #gate to #gatehouse)

#gate
(door *)
(* wants relation #at)
(* blocks passage)
	{ (#bolt is #in *) (or) (#bolt is pristine) }
(describe * blocking passage) Nu āškaš ḫattalwanza ēšta.
(room description *) (* blocks passage) ḫattalwantan āškan %% "closed door"
(short name *) āškan
(name * in #nominative) āškaš
(name * in #genitive) āškaš
(name * in #dative) āški
(name * in #accusative) āškan
(name * in #ablative) āškaz
(name * in #bare) āška
(dict * in #nominative/#bare) %% Adjective "closed" currently not displayed outside of the error message and room description
	(* blocks passage)
	ḫattalwanza
(dict * in #genitive)
	(* blocks passage)
	ḫattalwantaš
(dict * in #dative)
	(* blocks passage)
	ḫattalwanti
(dict * in #accusative)
	(* blocks passage)
	ḫattalwantan
(dict * in #ablative)
	(* blocks passage)
	ḫattalwantaz

#street
(room *)
(* uses preverb #at)
(name * in #nominative/#genitive) palšaš
(name * in #dative) palši
(name * in #accusative) palšan
(name * in #ablative) palšaz
