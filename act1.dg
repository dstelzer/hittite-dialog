#me
(current player *)
(name * in #nominative/#bare) uuk
(name * in #genitive) ammel
(name * in #dative/#accusative/#ablative) ammuk
(* is #in #riverbank)

#riverbank
(room *)
(name * in #nominative) wappuc
(name * in #genitive) wappawac
(name * in #dative) wappi
(name * in #accusative) wappun
(name * in #ablative) wappuwaz
(name * in #bare) wappu
(from * go #north to #watchtower)

#river
(name * in #nominative/#genitive) hapac
(name * in #dative) hapi
(name * in #accusative) hapan
(name * in #ablative) hapaz
(name * in #bare) hapa
(dict * in $Case)
	*(dict #water in $Case)
(* is #in #riverbank)

(instead of [[take *] $])
	(current player $Player)
	(if) (#cup is #heldby $Player) ~(cup has water) (then)
		($Dest = #cup)
		(now) (cup has water)
	(elseif) (#amphora is #heldby $Player) ~(amphora has water) (then)
		($Dest = #amphora)
		(now) (amphora has water)
	(else)
		(fail) %% Fall back to the usual "I can't hold the water" message
	(endif)
	Nu (#accusative $Dest) (#ablative #water) cunnahon. %% "I filled the DEST with water."
	(now) (update needed)
	(tick)

#watchtower
(room *)
(name * in #nominative) auric
(name * in #genitive) auriyac
(name * in #dative) auriya
(name * in #accusative) aurin
(name * in #ablative) auriyaz
(name * in #bare) auri
(* has modifier $Mod) ($Mod = {E2})
(from * go #south to #riverbank)
(from * go #west to #street)
(from * go #east to #wall)
(from * go #north through #gate to #gatehouse)

#gate
(door *)
(* blocks passage)
	{ (#bolt is #in *) (or) (#bolt is pristine) }
(describe * blocking passage)
	Nu ackac ciyanza ēcta. %% The gate was sealed.
(short name *) acki
(name * in #nominative)
	ackac (if) (* blocks passage) (then) ciyanza (else) haccanza (endif)
(name * in #genitive)
	ackac (if) (* blocks passage) (then) ciyandac (else) haccantac (endif)
(name * in #dative)
	acki (if) (* blocks passage) (then) ciyanti (else) haccanti (endif)
(name * in #accusative)
	ackan (if) (* blocks passage) (then) ciyantan (else) haccantan (endif)
(name * in #ablative)
	ackaz (if) (* blocks passage) (then) ciyantaz (else) haccantaz (endif)
(name * in #bare) acka

#street
(room *)
(name * in #nominative/#genitive) palcac
(name * in #dative) palci
(name * in #accusative) palcan
(name * in #ablative) palcaz
(name * in #bare) palca
(from * go #east to #watchtower)

#ladder
(item *)
(name * in #nominative) ilac
(name * in #genitive) ilanac
(name * in #dative) ilani
(name * in #accusative) ilan
(name * in #ablative) ilanaz
(name * in #bare) ila
(* is #in #street)

(instead of [[go *] $Details])
	($Details = [$Raw $Verb $Adv $Acc $ $Abl])
	(if) (current room #corner) (or) (current room #gatehouse) (then)
		(try [[go #window] [$Raw $Verb $Adv $Acc [#window] $Abl]])
	(elseif) (current room #backroom) (then)
		(try [[go #roof] [$Raw $Verb $Adv $Acc [#roof] $Abl]])
	(else)
		(describe negative action [[go *] $Details])
		Nu (span @akk) ūl kuitki parku ēcta. %% "Nothing was high up."
		(tick) (stop)
	(endif)

#wall
(room *)
(header *) Nu kutti kattan econ. %% I was below the wall
(name * in #nominative) kuzza
(name * in #genitive) kuttac
(name * in #dative) kutti
(name * in #accusative) kuttan
(name * in #ablative) kuttaz
(name * in #bare) kut
(dict * in *(grammatical case $)) kattan
(from * go #west to #watchtower)
(from * go #north to #corner)

#corner
(room *)
(neuter *)
(name * in #nominative/#accusative/#bare) halhaltomar
(name * in #genitive) halhaltomarac
(name * in #dative) halhaltomari
(name * in #ablative) halhaltomaraz
(* has modifier #wall)
(from * go #south to #wall)
(from * go #west through #window to #gatehouse)

#window
(door *)
(neuter *)
(* blocks passage)
	(current room $Room)
	~(#ladder is #in $Room)
(describe * blocking passage) Nu luttāi parku ēcta. %% "The window is high up"
(name * in #nominative/#accusative/#bare) luttaai
(dict * in #nominative/#accusative/#bare) luttai
(name * in #genitive) luttiyac
(name * in #dative) luttiya
(name * in #ablative) luttiyaz
(* has modifier #gatehouse)
	~(current room #gatehouse)

#gatehouse
(room *)
(neuter *)
(name * in #nominative/#accusative/#bare) hilammar
(name * in #genitive) hilamnac
(name * in #dative) hilamni
(name * in #ablative) hilamnaz
(* has modifier $Mod) ($Mod = {E2})
(from * go #east through #window to #corner)
(from * go #south through #gate to #watchtower)
(from * go #west to #foyer)
(from * go #north to #backroom)

#bolt
(item *)
(neuter *)
(name * in #nominative/#accusative/#bare)
	(if) (bolt is burning) (then) warān (endif)
	GIC hattalu
(name * in #genitive)
	(if) (bolt is burning) (then) warantac (endif)
	GIC hattaluwac
(name * in #dative)
	(if) (bolt is burning) (then) waranti (endif)
	GIC hattaluwi
(name * in #ablative)
	(if) (bolt is burning) (then) warantaz (endif)
	GIC hattaluwaz

(after [[go #gatehouse] $]) %% Only describe it on the inside
	(* is pristine)
	(now) (* is #in #gate)

(narrate taking *)
	(* is pristine)
	Nu ackan hachon. %% "I opened the gate."
	(now) (update needed)

(instead of [[put * #hearth/#fire] $Details])
	(#fire is #in #hearth)
	(describe action [[put * #fire] $Details])
	Nu GIC hattalu lukket. %% "The bolt ignited."
	(now) (bolt is burning)
	(now) (update needed)
	(tick)

(instead of [[put * #river] $Details])
	(describe action [[put * #river] $Details])
	(now) ~(bolt is burning)
	(now) (update needed)
	(tick)

(* provides light)
	(bolt is burning)

#foyer
(room *)
(name * in #nominative) arkiwic
(name * in #genitive) arkiwac
(name * in #dative) arkiwi
(name * in #accusative) arkiwin
(name * in #ablative) arkiwaz
(* has modifier $Mod) ($Mod = {E2})

(from * go #east to #gatehouse)
(from * go #north to #storeroom)

#hearth
(holder *)
(name * in #nominative/#genitive) haccac
(name * in #dative) hacci
(name * in #accusative) haccan
(name * in #ablative) haccaz
(name * in #bare) hacca
(* is #in #foyer)

#fire
(neuter *)
(name * in #nominative/#accusative/#bare) pahhur
(name * in #genitive) pahhuenac
(name * in #dative) pahhueni
(name * in #ablative) pahhuenaz
(* is #in #hearth)

(prevent [[take $Obj from #hearth] $Details])
	(* is #in #hearth)
	(describe negative action [[take $Obj from #hearth] $Details])
	Nu pahhur ayyanza ēcta. %% "The fire was hot."

#cup
(item *)
(name * in #nominative) DUG agannic
(name * in #genitive) DUG aganniyac
(name * in #dative) DUG aganniya
(name * in #accusative) DUG agannin
(name * in #ablative) DUG aganniyaz
(* has modifier #water)
	(cup has water)
(dict * in $Case)
	(cup has water)
	*(dict #water in $Case)
(* is #in #hearth)

#watchman
(animate *)
(name * in #nominative) techallic LÚ halliyatallac %% Sleeping watchman
(name * in #genitive) techalliyac LÚ halliyatallac
(name * in #dative) techalliya LÚ halliyatalli
(name * in #accusative) techallin LÚ halliyatallan
(name * in #ablative) techalliyaz LÚ halliyatallaz
(name * in #bare) techalli LÚ halliyatalla
(* is #in #foyer)

#storeroom
(room *)
(name * in #nominative/#genitive) antakac
(name * in #dative) antaki
(name * in #accusative) antakan
(name * in #ablative) antakaz
(name * in #bare) antaka
(inherently dark *)
(from * go #south to #foyer)

#amphora
(item *)
(name * in #nominative) DUG palhic
(name * in #accusative) DUG palhin
(name * in #genitive) DUG palhac
(name * in #dative) DUG palhi
(name * in #ablative) DUG palhaz
(dict * in $Case)
	(amphora has water)
	*(dict #water in $Case)
(* has modifier #water)
	(amphora has water)
(* is #in #storeroom)

(instead of [[put * #hearth/#fire] $])
	(#fire is #in #hearth)
	(amphora has water)
	(now) (#fire is nowhere)
	(now) ~(amphora has water)
	Nu waatar pahheni tehhon. %% "I put the water on the fire..."
	N=an kictanunun. %% "...and extinguished it."
	(now) (update needed)

%% Never on-stage, but used by the parser
#water
(name * in #nominative/#accusative) waatar
(dict * in #nominative/#accusative) watar
(name * in #genitive) witenac
(name * in #dative) witeni
(name * in #ablative) witenaz

#backroom
(room *)
(neuter *)
(name * in #nominative/#accusative/#bare) ickica
(name * in #genitive) ickicac
(name * in #dative) ickici
(name * in #ablative) ickicaz
(* has modifier #watchtower)
(from * go #south to #gatehouse)
(from * go #up to #roof)
(from * go #north to #hattuca)

(prevent [[go #roof] $Details])
	(current room *)
	~(#ladder is #in *)
	(describe negative action [[go #roof] $Details])
	Nu cuhha parku ēcta. %% "The roof is high up"

(prevent [[go #roof] $Details])
	(current player $Player)
	(#amphora is #heldby $Player)
	(describe negative action [[go #roof] $Details])
	Nu palhic nakkic ēcta. %% "The amphora is heavy."

#roof
(room *)
(neuter *)
(name * in #nominative/#accusative/#bare) cuhha
(name * in #genitive) cuhhac
(name * in #dative) cuhhi
(name * in #ablative) cuhhaz
(from * go #down to #backroom)
(from * go #north to #precinct)

#precinct
(room *)
(neuter *)
(name * in #nominative/#accusative/#dative/#bare) hali
(name * in #genitive) haliyac
(name * in #ablative) haliyaz
(* has modifier @karimnac)

%% For later: "temple" is É^karimmi, neuter: karimmi, karimnac, karimni, karimnaz

(instead of [[go *] $Details])
	(current player $Player)
	(if) (#cup is #heldby $Player) (cup has water) (then)
		(describe action [[go *] $Details])
		(div @narration) { The tablet breaks off here, as the soldier finally enters the temple precinct. }
		(game over { To be continued... } )
	(else)
		(describe negative action [[go *] $Details])
		Nu caknuwanza econ. Nu waatar (span @akk) uul harkon. %% "I was impure. I did not have water."
	(endif)

#hattuca
(room *)
(name * in #nominative/#genitive) Hattucac
(name * in #dative) Hattuci
(name * in #accusative) Hattucan
(name * in #ablative) Hattucaz
(* has modifier $Mod) ($Mod = {URU})

(instead of [[go *] $Details])
	(describe negative action [[go *] $Details])
	Nu Hattucac (span @akk) ina KUR LU2 KUR2 ēcta. %% "Hattuca is within enemy land."

(metacommand [test watchtower])
	(now) (#ladder is #in #corner)
	(now) (#ladder is handled)
	(now) (#street is visited)
	(now) (#bolt is pristine)
	(now) (#bolt is #in #gate)
	(enter #gatehouse)

(metacommand [test roof])
	(now) (#bolt is #heldby #player)
	(now) (bolt is burning)
	(now) (amphora has water)
