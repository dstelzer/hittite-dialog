(instead of [[put * #hearth/#fire] $])
	(#fire is #in #hearth)
	(amphora has water)
	(now) (#fire is nowhere)
	(now) ~(amphora has water)
	Nu wātar paḫḫeni tēḫḫun. %% "I put the water on the fire..."
	N=an kištanunun. %% "...and extinguished it."
	(now) (update needed)

%% Never on-stage, but used by the parser
#water
(name * in #nominative/#accusative) wātar
(dict * in #nominative/#accusative) watar
(name * in #genitive) witenaš
(name * in #dative) witeni
