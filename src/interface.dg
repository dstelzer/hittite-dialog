%% Metadata

%% We don't use the standard (story title) because that's set in each act individually
(overall story title) Ḫattušumna Laḫḫa \( Hittite Adventure \)
(story noun) An educational adventure
(story ifid) 58715A25-1E91-4BAC-ACED-F1E534F9C33D
(story author) Daniel Stelzer, Tim Leonard, and Daniel Gaskell
(story release 1)

%% Style definitions and related predicates go here
%% See also platform_*.dg

%% Akkadograms
(style class @akk)
	font-style: italic;
	text-transform: uppercase;

%% Styling for determiners needs to be handled in the interpreter CSS, since it needs to be superscript only in transcription, not in cuneiform
%% So this is an empty style class
(style class @dtm)

(interface (dtm $<Closure))
(dtm $Closure) %% Make sure of no space on the right
	(span @dtm) { (query $Closure) (no space) } (no space)
	(if) ~(superscripts supported) (then) ^ (no space) (endif)
(interface (dtm2 $<Closure))
(dtm2 $Closure) %% For determiners on the right side
	(if) ~(superscripts supported) (then) (no space) ^ (endif)
	(no space) (span @dtm) { (no space) (query $Closure) }

%% Horizontal rules to flag each description
(hr)
	~(given first message)
(hr)
	(in debugger)
	(div @hr) { (space) - (space) - (space) - (space) - (space) - }
(hr)
	(div @hr) (space 1)

(style class @hr)
	height: 0.1em;
	width: 100\%;
	background-color: var\(--text\);
	aria-role: separator;
	margin-top: 0.5em;
	margin-bottom: 0.5em;

%% "Errors" in the player's input
(style class @error)
	data-language: en;
	font-family: sans-serif;
	margin-top: 1em;
	margin-bottom: 1em;

%% Meta messages
(style class @meta)
	data-language: en;
	font-family: sans-serif;
	margin-top: 1em;
	margin-bottom: 1em;

%% Actual errors in the game's programming
(style class @realerror)
	color: red;
	font-weight: bold;
	font-family: sans-serif;
	data-language: en;
	margin-top: 1em;
	margin-bottom: 1em;

(style class @hittite)
	data-language: ht;
	text-indent: 0;

(style class @prompt)
	data-language: en;

(style class @gameover)
	font-weight: bold;
	margin-top: 1em;
	margin-bottom: 1em;
	data-language: en;

%% Rarely but occasionally needed
(style class @bold)
	font-weight: bold;
	aria-role: strong;

%% Title
(style class @title)
	data-language: ht;
	text-transform: uppercase;
	font-weight: bold;
	aria-role: strong;
(style class @engtitle)
	data-language: en;
	text-transform: uppercase;
	font-weight: bold;
	aria-role: strong;
(style class @subtitle)
	data-language: en;
	font-style: italic;
	aria-role: emphasis;

%% Emphasis
(style class @italic)
	font-style: italic;
	aria-role: emphasis;
(style class @emphemph)
	font-style: normal;
	aria-role: emphasis;
(emph $Closure)
	(if) (currently italic) (then)
		(now) ~(currently italic)
		(span @emphemph) (query $Closure)
		(now) (currently italic)
	(else)
		(now) (currently italic)
		(span @italic) (query $Closure)
		(now) ~(currently italic)
	(endif)
