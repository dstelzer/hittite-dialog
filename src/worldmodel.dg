%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Program entry, main loop, status bar, score

(program entry point)
	(div @initial-spacer) {}
	(update environment around player)
	(exhaust) *(startup)
	(stoppable) (intro)
	*(repeat forever) (read-parse-act) (fail)

(startup) (fail) %% Put calculations here that need to run at startup

(intro)
%%	(world log {Banner})
%%	(banner)
	(world log {Updating})
	(update description)

