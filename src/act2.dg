%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Watchman region (west)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

#watchman
(animate *)
(name * in #nominative) ḫalliyatallaš
(name * in #genitive) halliyatallaš
(name * in #dative) ḫalliyatalli
(name * in #accusative) ḫalliyatallan
(name * in #ablative) ḫalliyatallaz
(name * in #bare) ḫalliyatalla
(determiner *) LU₂
(dict * in $) LU2 LÚ
(* is #in #guardwalk1)

@(guard is moving west) ~(guard is moving east)

(guard is relevant) %% Don't spend the rest of the game narrating the guard's actions
	(current room $Room)
	($Room is one of [#kitchen #guardwalk1 #guardwalk2 #guardwalk3 #honeystorage #fruitstorage])

(on every tick)
	(* is in room $Room)
	(if) ($Room = #guardwalk1) (guard is moving east) (then)
		(if) (adjacent #guardwalk1) (or) (#guardwalk1 is visited) (guard is relevant) (then)
			(par) Nu (#nominative *) aušta.
		(endif)
		(now) (guard is moving west)
	(elseif) ($Room = #guardwalk3) (guard is moving west) (then)
		(if) (adjacent #guardwalk3) (or) (#guardwalk3 is visited) (guard is relevant) (then)
			(par) Nu (#nominative *) aušta.
		(endif)
		(now) (guard is moving east)
	(elseif) (guard is moving east) (then)
		(from $Room go #east to $Next)
		(move guard from $Room to $Next)
	(else)
		(from $Room go #west to $Next)
		(move guard from $Room to $Next)
	(endif)

(move guard from $Start to $End)
	(par)
	(if)
		(guard is relevant)
		{
			($Start is visited) (or) ($End is visited) (or)
			(adjacent $Start) (or) (adjacent $End)
		}
	(then)
		Nu (#nominative *)
		(if) (adjacent $End) (or) ($End is visited) (then)
			(#dative $End)
		(endif)
		(if) (adjacent $Start) (or) ($Start is visited) (then)
			(#ablative $Start)
		(endif)
		(if) (current room $End) (then)
			uet
		(else)
			pait
		(endif)
		.
	(endif)
	(if) (current room $End) (then)
		Nu=mu (#nominative *) aušta.
		(death ensues) %% Don't actually move the guard in this case, to simulate an undo
	(else)
		(now) (* is #in $End)
	(endif)
	(if) ($Start is visited) (or) ($End is visited) (then)
		(now) (map update needed) %% Symbol moves on the map
	(endif)
	(if) (adjacent $Start) (or) (adjacent $End) (then)
		(now) (update needed) %% Main room description mentions adjacent guard so needs to be updated
	(endif)

(perform [[go $Room] $])
	(* is #in $Room)
	Nu (#nominative *) apiya ēšta. Nu=mu (#nominative *) aušta.
	(death ensues)

(bonus room description paragraph)
	(* is in room $Guard)
	(adjacent $Guard)
	Nu (#nominative *)
	(if) (current room $Player) ($Player is one of [#guardwalk1 #guardwalk2 #guardwalk3]) (then)
		%% In the street, give the full name
		(#dative $Guard)
	(else)
		%% Elsewhere, just say "in the street"
		palši
	(endif)
	ēšta.

#guardwalk1 %% Upper street
(room *)
(* uses preverb #at)
(name * in #nominative/#genitive) šarāzziyaš palšaš
(name * in #dative) šarāzziya palši
(name * in #accusative) šarāzziyan palšan
(name * in #ablative) šarāzziyaz palšaz
(name * in #bare) šarāzziya palša
(short name *) %% Call it "upper" when already in the street
	(current room #guardwalk2)
	šarāzziya
(short name *) %% Otherwise call it "street"
	palši

(from * go #east to #kitchen)
(from * go #west to #guardwalk2)

#guardwalk2 %% Middle street
(room *)
(* uses preverb #at)
(name * in #nominative/#genitive) ištarniyaš palšaš
(name * in #dative) ištarniya palši
(name * in #accusative) ištarniyan palšan
(name * in #ablative) ištarniyaz palšaz
(name * in #bare) ištarniya palša
(short name *) %% Call it "street" when in the building
	(current room #honeystorage)
	palši
(short name *) %% Otherwise call it "middle"
	ištarniya

(from * go #west to #guardwalk3)
(from * go #east to #guardwalk1)
(from * go #north to #honeystorage)

#guardwalk3 %% Lower street
(room *)
(* uses preverb #at)
(name * in #nominative/#genitive) katteraš palšaš
(name * in #dative) katteri palši
(name * in #accusative) katteran palšan
(name * in #ablative) katteraz palšaz
(name * in #bare) kattera palša
(short name *) %% Call it "street" when in the building
	(current room #fruitstorage)
	palši
(short name *) %% Otherwise call it "lower"
	katteri

(from * go #north to #fruitstorage)
(from * go #east to #guardwalk2)

#honeystorage
(storage *)
(contents *) militaš

(from * go #south to #guardwalk2)

#fruitstorage
(storage *)
(contents *) šešaš

(from * go #south to #guardwalk3)

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Darkness region (down)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

#reedjar
(holder *)
(* wants relation #in)
(logogram *)
(name *) PISAN %% "container"
(determiner *) GIŠ
(* has modifier #reed) %% Conveniently the gen sg and gen pl look the same for a-stems
(* is #in #kitchen)

#reed
(item *)
(* has modifier #oily) (reed is oiled) %% substances.dg for definition
(name * in #nominative/#genitive) nataš
(name * in #dative) nati
(name * in #accusative) natan
(name * in #ablative) nataz
(name * in #bare) nata

(* accepts substance #oil) %% Doesn't actually become filled with it though
(* accepts substance #fire)

(instead of [[put $X $Y] $])
	{ ($X = *) ($Y is filled with #oil) (or) ($Y = *) ($X is filled with #oil) }
	(* is #heldby #me)
	Nu (#accusative #oil) (#dative *) tēḫḫun. %% I put the oil on the reed.
	(now) (reed is oiled)
	(now) (update needed)

(perform [[drop/put * | $] $])
	N=aš ḫarkta. %% It perished/was lost.
	(reset the reed)
	(now) (update needed)

(reset the reed)
	(now) (* is #in #reedjar)
	(now) ~(reed is oiled)
	(now) ~(* is filled with $)
	(now) ~(reed burning timer $)
(startup) (reset the reed) %% Ensure consistency

(global variable (reed burning timer $))

(on every tick)
	(* is filled with #fire)
	(if) ~(reed burning timer $) (then) %% Just ignited: start the timer
		(if) (reed is oiled) (then)
			(now) (reed burning timer 3)
		(else)
			(now) (reed burning timer 2)
		(endif)
	(elseif) (reed burning timer 1) (or) (reed burning timer 0) (then) %% Timer has run out
		TODO the reed burned out
		(reset the reed)
		(now) (update needed)
	(else)
		(reed burning timer $Old)
		($Old minus 1 into $New)
		(now) (reed burning timer $New)
		(log) { Reed timer ticks down to $New }
	(endif)

#oiljar
(name * in #nominative) palḫiš %% pithos
(name * in #accusative) palḫin
(name * in #genitive) palḫaš
(name * in #dative) palḫi
(name * in #ablative) palḫaz
(determiner *) DUG

(* is filled with #oil)
(* has modifier #oil)
(* is #in #kitchen)

%% Now for the dark maze itself

(late on every tick) %% Remove the player from darkness if they got trapped
	(current room $Room)
	(inherently dark $Room)
	~{ %% No light source
		*($Obj has ancestor $Room)
		($Obj is filled with #fire)
	}
	(par)
	Nu pedaš dankuešta. %% The room became dark.
	Nu apēz paršun. %% I fled from that place.
	(enter #kitchen)

#dm-grain %% N
(storage *)
(inherently dark *)
(contents *) halkiyaš

(from * go #up to #kitchen)
(from * go #west to #dm-pottery)
(from * go #east to #dm-wine)

#dm-pottery %% NW
(storage *)
(inherently dark *)
(contents *) GIR₄
(dict * in $) GIR4

(from * go #east to #dm-grain)
(from * go #south to #dm-veg)

%% This one has the crucial lamp

#lamp
(item *)
(name * in #nominative/#genitive) šašannaš
(name * in #dative) šašanni
(name * in #accusative) šašannan
(name * in #ablative) šašannaz
(determiner *) DUG
(* is #in #dm-pottery)

(* accepts substance #oil)
(* accepts substance #fire)
	(* is filled with #oil) %% Doesn't accept fire until it's filled
	(or)
	(* is filled with #fire) %% But then keeps burning once the oil's gone
(* has modifier #empty) ~(* is filled with $)
(* has modifier #oily) (* is filled with #oil)
%% Will receive "burning" modifier from substances.dg

(instead of [[put $X $Y] $])
	{ ($X = *) ($Y is filled with #oil) (or) ($Y = *) ($X is filled with #oil) }
	(* is #heldby #me)
	Nu (#accusative #oil) (dtm {DUG})(name * in #dative) anda tēḫḫun. %% I put the oil in the lamp.
	%% Doesn't use (#dative *) because that would include the "empty" modifier
	(now) (* is filled with #oil)
	(now) (update needed)

#empty
(adjective *)
(name * in #nominative/#genitive) dannattaš
(name * in #dative) dannatti
(name * in #accusative) dannattan
(name * in #ablative) dannattaz
(name * in #bare) dannatta

#dm-wine %% NE
(storage *)
(inherently dark *)
(contents *) wiyanaš

(from * go #west to #dm-grain)
(from * go #south to #dm-legumes)

#dm-veg %% SW
(storage *)
(inherently dark *)
(contents *) SAR

(from * go #east to #dm-cheese)
(from * go #north to #dm-pottery)

