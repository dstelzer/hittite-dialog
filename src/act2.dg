(from * go #west to #dm-veg)
(from * go #east to #dm-legumes)

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Final bookkeeping
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%% We're going to need so many of these...
(room *(storage $))
(*(storage $) uses preverb #in)
(name (storage $Obj) in #nominative/#genitive) (contents $Obj) antakaš
(name (storage $Obj) in #dative) (contents $Obj) antaki
(name (storage $Obj) in #accusative) (contents $Obj) antakan
(name (storage $Obj) in #ablative) (contents $Obj) antakaz
(name (storage $Obj) in #bare) (contents $Obj) antaka
(short name (storage $Obj)) %% Duplicated from actions.dg which is not ideal
	(inherently dark $Obj)
	(current player $Player)
	~($Player has a light source)
	~($Obj has a light source)
	dankui %% "Dark"
(short name (storage $Obj)) (contents $Obj)
(medium short name (storage $Obj)) %% Likewise
	(inherently dark $Obj)
	(current player $Player)
	~($Player has a light source)
	~($Obj has a light source)
	dankui %% "Dark"
(medium short name (storage $Obj)) (#dative $Obj)

%% And finally, the circumstances in which each verb gets unlocked
%% All of these are automatically unlocked from tablet 1
(verb #v-look unlocked)
(verb #v-go unlocked)
(verb #v-cross unlocked)
(verb #v-take unlocked)
(verb #v-drop unlocked)
(verb #v-put unlocked)

%% This one pops up when you meet a person again, because it's funny
(verb #v-slay unlocked) (#washhouse is visited)

%% These are the new ones in tablet 2
(verb #v-wear unlocked) (#garment is handled)
(verb #v-wait unlocked) (#kitchen is visited) %% When an every-turn-moving NPC appears
(verb #v-cut unlocked) (#knife is handled)
