#chopped
(adjective *)
(name * in #nominative/#bare) arkanza
(name * in #genitive) arkandaš
(name * in #dative) arkandi
(name * in #accusative) arkandan
(name * in #ablative) arkandaz

#dough
(item *)
(name * in #nominative/#genitive) išnaš
(name * in #dative) išni
(name * in #accusative) išnan
(name * in #ablative) išnaz
(name * in #bare) išna
(* is #in #trough)

%% Add ingredients to the dough
(instead of [[put $Ingredient *] $Details])
	($Ingredient is one of [#fruit #cheese])
	($Ingredient is #heldby #me)
	
	%% Since we're using (instead of $) we need to do our checks here
	(if)
		($Ingredient = #fruit) ~(fruit is chopped)
	(or)
		($Ingredient = #cheese) ~(cheese is chopped)
	(then)
		(describe negative action [[put $Ingredient *] $Details])
		N=aš (#nominative #chopped) natta ēšta. %% It was not chopped.
		(tick) (stop)
	(endif)
	
	(describe action [[put $Ingredient *] $Details])
	(now) ($Ingredient is nowhere) %% We handle that by just removing them from the world, which updates the description of the dough/bread
	(now) (update needed)

(prevent [[put * #oven] $Details])
	{ ~(#cheese is nowhere) (or) ~(#fruit is nowhere) }
	(describe negative action [[put * #oven] $Details])
	(if) ~(#cheese is nowhere) (then)
		Nu=ši (#nominative #cheese) anda natta ēšta. %% The cheese was not in it.
	(endif)
	(if) ~(#fruit is nowhere) (then)
		Nu=ši (#nominative #fruit) anda natta ēšta. %% The fruit was not in it.
	(endif)
	(div @error) {
		The narrator seems to be making (span @italic) iyatti , a kind of bread "studded" with chopped pieces of fruit and cheese.
	}

(perform [[put * #oven] $])
	(now) (* is nowhere)
	(now) (#bread is #in #oven)
	(now) (update needed)

#bread
(item *)
(name * in #nominative) iyattiš
(name * in #genitive) iyattiyaš
(name * in #dative) iyattiya
(name * in #accusative) iyattin
(name * in #ablative) iyattiyaz
(name * in #bare) iyatti
(determiner *) NINDA

($Case $Obj) %% Here's where we handle the studding
	($Obj is one of [#dough #bread])
	(if) ($Obj has determiner) (then)
		(dtm {(determiner $Obj)})
	(endif)
	(name $Obj in $Case)
	(if) (#cheese is nowhere) (or) (#fruit is nowhere) (then)
		(if) (#cheese is nowhere) (then)
			(span @akk) ištu GA.KIN.AG
		(endif)
		(if) (#fruit is nowhere) (then)
			šešaz
		(endif)
		(name #studded in $Case)
	(endif)

(dict $Obj in $Case)
	($Obj is one of [#dough #bread])
	(#cheese is nowhere)
	ištu GA.KIN.AG
	(name #studded in $Case)
(dict $Obj in $Case)
	($Obj is one of [#dough #bread])
	(#fruit is nowhere)
	(name #fruit in #ablative)
	(name #fruit in $Case) %% In case of "take fruit"
	(name #studded in $Case)

#studded %% Used for both bread and dough
(adjective *)
(name * in #nominative/#bare) tiyanza
(name * in #genitive) tiyantaš
(name * in #dative) tiyanti
(name * in #accusative) tiyantan
(name * in #ablative) tiyantaz

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Dog region (north)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

(player is in dog region)
	(current room $Room)
	(dogs allowed in $Room)

#dog
(animate *)
(holder *) %% For room descriptions
(* wants relation #heldby)
(logogram *)
(name *) UR.GI₇
(* is #in #dogmaze)

(after [[go/cross $] $])
	(player is in dog region)
	(dog movement)
	(now) (dog is active)
(after [[go/cross $] $]) %% We also have to do one more tick of movement when the player leaves, to keep parity
	~(player is in dog region)
	(dog is active)
	(dog movement)
	(now) ~(dog is active)

(dog movement)
	(#dog is in room $Start)
	(current room $Player)
	%% If 2+ steps away from the player, take one step toward the player
	(if)
		(shortest path from $Start to $Player is $Path)
		($Path = [$First $ | $]) %% At least two entries in the list
		(from $Start go $First to $Next)
		(dogs allowed in $Next)
		~($First is one of [#up #down])
	(then)
		(move dog from $Start to $Next)
	(elseif) %% If anything goes wrong in the above, fall back to moving randomly
		(collect $Next)
			*(from $Start go $Dir to $Next)
			~($Dir is one of [#up #down]) %% Cannot move vertically
			(dogs allowed in $Next)
		(into $Options)
		(randomly select $Chosen from $Options)
	(then)
		(move dog from $Start to $Chosen)
	(else)
		(div @realerror) { ERROR: The dog is stuck! Dog is in $Start , player is in $Player . What's going on? Please report this! }
	(endif)
	
	%% For debugging, we also want to make sure the parity is intact
	(check dog parity)

(interface (check dog parity)) %% Don't complain if we comment it out
(check dog parity)
	(#dog is in room $Dog)
	(current room $Player)
	(at most once) {
		(shortest path from $Dog to $Player is $Path)
	(or)
		($Dog = $Player) ($Path = [])
	}
	(length of $Path into $Length)
	(log) {
		Distance from dog to human: $Length (line)
		(if) ($Length modulo 2 into 1) (then)
			Odd parity
		(else)
			EVEN parity
		(endif)
	}

(move dog from $Start to $End)
	(par) Nu (#nominative #dog) (#ablative $Start) (#dative $End) pait.
	(now) (#dog is #in $End)
	(if) ($Start is visited) (or) ($End is visited) (then)
		(now) (map update needed)
	(endif)
	(if) (current room $Start) (or) (current room $End) (then)
		(now) (update needed)
	(endif)

