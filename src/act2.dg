(* has modifier #temple)
(name * in #nominative/#genitive) ḫilaš
(name * in #dative) ḫili
(name * in #accusative) ḫilan
(name * in #ablative) ḫilaz
(name * in #bare) ḫila

(origin *)

(from * go #north to #temple)
(from * go #east through #washdoor to #washhouse)
(from * go #west through #builddoor to #building)

#temple
(room *)
(neuter *)
(* uses preverb #in)
(name * in #nominative/#accusative/#bare) karimmi
(name * in #genitive) karimnaš
(name * in #dative) karimni
(name * in #ablative) karimnaz

(prevent [[go *] $Details]) %% Test garment first since it's easier to get
	~(#garment is #wornby #me)
	(describe negative action [[go *] $Details]) %% I did not...
	Nu (name #garment in #accusative) natta waššiyanun.
(prevent [[go *] $Details])
	~(#bread is #heldby #me)
	(describe negative action [[go *] $Details]) %% I did not...
	Nu (name #bread in #accusative) natta ḫarkun. %% I was not holding the bread.

(perform [[go *] $])
	(div @error) { The tablet ends as the narrator enters the temple building itself. His disguise and the fresh-baked bread must have been effective, as the next part of the text begins with him in the inner sanctum, stolen god in hand. }
	(game over {To be continued...})

