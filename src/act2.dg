(story title) Ḫattušumna Laḫḫa Tablet 1: The Bakery
(tablet title) Tablet 1: The Bakery

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Basic setup and courtyard region
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

(direction numbers enabled)
(given first message)

#me
(current player *)
(name * in #nominative/#bare) ūk
(name * in #genitive) ammel
(name * in #dative/#accusative/#ablative) ammuk
(* is #in #courtyard)

(intro)
	Nu (#dative #courtyard) ešun. %% "I was in the courtyard."
	Nu (#nominative #dog) (#dative #building) pait. %% "A dog went into the building."
	Nu (#nominative #baker) (#ablative #building) pait. %% "The baker came out of the building."
	Nu (#nominative #baker) (#dative #washhouse) pait. %% "The baker went into the washhouse."
	(now) (update needed)

#courtyard
(room *)
(* uses preverb #in)
(* has modifier #temple)
(name * in #nominative/#genitive) ḫilaš
(name * in #dative) ḫili
(name * in #accusative) ḫilan
(name * in #ablative) ḫilaz
(name * in #bare) ḫila

(origin *)

(from * go #north to #temple)
(from * go #east through #washdoor to #washhouse)
(from * go #west through #builddoor to #kitchen)

#temple
(room *)
(neuter *)
(* uses preverb #in)
(name * in #nominative/#accusative/#bare) karimmi
(name * in #genitive) karimnaš
(name * in #dative) karimni
(name * in #ablative) karimnaz

(prevent [[go *] $Details])
	~(#garment is #wornby #me)
	(describe negative action [[go *] $Details]) %% I did not...
	TODO I did not wear the garment
(prevent [[go *] $Details])
	~(#bread is #heldby #me)
	(describe negative action [[go *] $Details]) %% I did not...
	Nu (#accusative #bread) natta ḫarkun. %% I was not holding the bread.

(perform [[go *] $])
	TODO end of tablet 2

#building
(room *)
(neuter *)
(name * in #nominative/#accusative/#bare) pēr
(name * in #genitive) parnaš
(name * in #dative) parni
(name * in #ablative) parnaz

(from * go #east through #builddoor to #courtyard)
(from * go #west to #kitchen)
(from * go #north to #dogmaze)

#builddoor
(door *)
(holder *)
(* wants relation #at)
(* blocks passage) (#bolt is #in *)
(describe * blocking passage) Nu āškaš ḫattalwanza ēšta.
(* has modifier #building)
(short name *) (#genitive #building)
(medium short name *) (#dative *)
(name * in #nominative) āškaš
(name * in #genitive) āškaš
(name * in #dative) āški
(name * in #accusative) āškan
(name * in #ablative) āškaz
(name * in #bare) āška

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Washhouse and baker (east)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%% The baker's garment is lying in the courtyard. If you try to take it out of the courtyard, the baker interrupts you, unless you've sealed him in the washhouse or killed him.

#garment
(item *)
(clothing *)
(logogram *)
(name * in #bare) TUG₂
(dict * in $) TÚG TUG2
(* is #in #washhouse)

(baker is incapacitated)
	(#bolt is $ #washdoor) %% Trapped
(baker is incapacitated)
	(#baker is nowhere) %% Killed

(perform [[go #temple] $] without prefix)
	~(baker is incapacitated)
	(#garment has ancestor #me)
	(intercepted by the baker)
(perform [[cross #builddoor] $] without prefix)
	~(baker is incapacitated)
	(#garment has ancestor #me)
	(intercepted by the baker)

(intercepted by the baker)
	%% I left the courtyard.
	Nu (#ablative #courtyard) pāun.
	%% The baker left the washhouse.
	Nu (#nominative #baker) (#ablative #washhouse) pait.
	%% The baker saw me.
	Nu=mu (#nominative #baker) aušta.
	%% The watchman killed me.
	Nu=mu=kan (#nominative #watchman) kuenta.
	(death ensues) %% See actions.dg for what this does

#washhouse
(room *)
(* uses preverb #at)
(name * in #nominative) šakuniš %% no longer "washhouse" but "spring/well"
(name * in #genitive) šakuniyaš
(name * in #dative) šakuniya
(name * in #accusative) šakuniyan %% TODO - not šakunin?
(name * in #ablative) šakuniyaz
(name * in #bare) šakuni

(on every tick)
	(current room *)
	(#baker is in room *)
	(par) TODO The baker washed himself using the pool.

#pool
(* is #in #washroom)
(* is filled with #water)
(* has modifier #water) %% Show off the genitive some more
(name * in #nominative) lūliš
(name * in #genitive) lūliyaš
(name * in #dative) lūliya
(name * in #accusative) lūlin
(name * in #ablative) lūliyaz
(name * in #bare) lūli

#washdoor
(door *)
(holder *)
(* wants relation #at)
(* blocks passage) (#bolt is #in *)
(describe * blocking passage) Nu āškaš ḫattalwanza ēšta.
(* has modifier #washhouse)
(short name *) (#genitive #washhouse)
(medium short name *) (#dative *)
(name * in #nominative) āškaš
(name * in #genitive) āškaš
(name * in #dative) āški
(name * in #accusative) āškan
(name * in #ablative) āškaz
(name * in #bare) āška

#bolt
(item *)
(neuter *)
(determiner *) GIŠ
(* has modifier #burnt)
(name * in #nominative/#accusative/#bare) ḫattalu
(name * in #genitive) ḫattaluwaš
(name * in #dative) ḫattaluwi
(name * in #ablative) ḫattaluwaz
(* is #heldby #me)

#burnt
(adjective *)
(neuter *) %% Only applies to ḫattalu
(name * in #nominative/#accusative/#bare) lukkan
(name * in #genitive) lukkandaš
(name * in #dative) lukkandi
(name * in #ablative) lukkandaz

#baker
(animate *)
(logogram *)
(name * in #bare) NINDA.DU₃.DU₃
(determiner *) LU₂
(dict * in $) DÙ DU3 LÚ LU2
(* is #in #washhouse)

