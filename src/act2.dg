%% Central kitchen
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

#kitchen
(room *)
(logogram *)
(name * in #bare) MUḪALDIM
(* has modifier $X) ($X = {E₂}) %% Hack to make the determiner work right: E₂ is the modifier, LÚ is the determiner, MUḪALDIM is the main name
(determiner *) LU₂

(from * go #east to #building)
(from * go #west to #guardmaze)
(from * go #down to #cheesemaze)

