%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Dog region (north)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

#dog
(animate *)
(logogram *)
(name * in #bare) UR.GI₇
(* is #in #dogmaze)

(on every tick)
	(player is in dog region)
	(dog movement)
	(now) (dog is active)
(on every tick) %% We also have to do one more tick of movement when the player leaves, to keep parity
	~(player is in dog region)
	(dog is active)
	(dog movement)
	(now) ~(dog is active)

(dog movement)
	(#dog is in room $Start)
	(current room $Player)
	%% If 2+ steps away from the player, take one step toward the player
	(if)
		(shortest path from $Start to $Player is $Path)
		($Path = [$First $ | $]) %% At least two entries in the list
		(from $Start go $First to $Next)
		~($Next = #building)
		~($First is one of [#up #down])
	(then)
		(move dog from $Start to $Next)
	(elseif) %% If anything goes wrong in the above, fall back to moving randomly
		(collect $Next)
			*(from $Start go $Dir to $Next)
			~($Dir is one of [#up #down]) %% Cannot move vertically
			~($Next = #building) %% Cannot leave the dog region
		(into $Options)
		(randomly select $Chosen from $Options)
	(then)
		(move dog from $Start to $Chosen)
	(else)
		(div @realerror) { ERROR: The dog is stuck! Dog is in $Start , player is in $Player . What's going on? Please report this! }
	(endif)

(move dog from $Start to $End)
	Nu (#nominative #dog) (#ablative $Start) (#dative $End) pait.
	(now) (#dog is #in $End)
	(now) (map update needed)
	(if) (current room $Start) (or) (current room $End) (then)
		(now) (update needed)
	(endif)

