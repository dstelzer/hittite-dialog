(name * in #accusative) šešan
(name * in #ablative) šešaz
(name * in #bare) šeša
(* is #in #fruitstorage)

(* has modifier #chopped) (fruit is chopped)

(perform [[cut * with $] $])
	(now) (fruit is chopped)
	(now) (update needed)

