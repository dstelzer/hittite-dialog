(story title) Ḫattušumna Laḫḫa Tablet 3: The Conspiracy
(tablet title) Tablet 3: The Conspiracy

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% The Beginning
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

(direction numbers enabled)
(given first message)

#me
(current player *)
(animate *)
(name * in #nominative/#bare) ūk
(name * in #genitive) ammel
(name * in #dative/#accusative/#ablative) ammuk

(* is #in #sanctum)

(startup) %% Because the startup process takes a long time for this game, we should show the player that their computer hasn’t frozen
	(inline status bar @p-meta) { %% Actually the speed has been improved quite a lot now, so this is no longer really a concern, but there’s no reason to remove it; maybe someone has a really low-end machine
		Generating puzzle...please wait!
	}
(intro) %% No intro
	(now) (update needed)
	(now) (map update needed)

(tutorial)
	~(taught logograms)
	(div @tutorial) {
		If you haven’t played tablet 2, don’t worry—there’s only one thing you need to know from it. Words written in ALL CAPITALS are “logograms”, special cuneiform signs used as shorthand for entire words. The CAPITALS indicate that we’re transcribing the names of the signs, not the actual Hittite pronunciation. (par)
		Good luck!
	}
	(now) (taught logograms)
	%% Genitive and ablative do show up marginally here—the garment belonged to the dead scribe, and the final message says you left the temple. But those aren’t really important and players can figure them out as they go.

#sanctum
(room *)
(neuter *)
(* uses preverb #in)
(name * in #nominative/#accusative/#bare) tunnakkiš
(name * in #genitive) tunnakkešnaš
(name * in #dative) tunnakkešni
(name * in #ablative) tunnakkišnaz

(origin *)
(from * go #west to #backroom)
(from * go #south to #temple)

#god
(item *)
(name * in #nominative) šiuš
(name * in #genitive) šiunaš
(name * in #dative) šiuni
(name * in #accusative) šiun
(name * in #ablative) šiunaz
(* has modifier @ammel) %% My

(* is #heldby #me)

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% The Development
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

#backroom
(room *)
(* uses preverb #in)
(name * in #nominative) appezziš antakaš %% lit. rear room
(name * in #genitive) appezziyaš antakaš
(name * in #dative) appezzi antaki
(name * in #accusative) appezzin antakan
(name * in #ablative) appezziyaz antakaz
(short name *) appezzi

(from * go #east to #sanctum)

(after [[go *] $])
	(select)
		(fix tablet order)
	(or)
	(stopping)

#scribe
(holder *)
(* wants relation #heldby)
(logogram *)
(name *) DUB.SAR
(* has modifier #dead)

(* is #in #backroom)

%% Normally dead bodies don’t stick around as objects, so we have to do some special action handling to deal with this case
(prevent [[$Verb | $Objects] $Details])
	($Verb is one of [slay wash kiss dance bow question])
	(* is one of $Objects)
	(describe negative action [[$Verb | $Objects] $Details]) %% I just didn’t do that

#dead
(adjective *)
(name * in #nominative) akkanza
(name * in #genitive) akkandaš
(name * in #dative) akkandi
(name * in #accusative) akkandan
(name * in #ablative) akkandaz

#garment
(item *)
(clothing *)
(logogram *)
(name *) TUG₂
(dict *) TUG2 TÚG
(* has modifier #scribe) ~(* is #heldby #scribe)

(* is #heldby #scribe)

#box
(item *)
(* is #heldby #scribe)
(logogram *)
(name *) PISAN
(determiner *) GIŠ
(holder *)
(* wants relation #in)

(fix tablet order) %% Make sure the tablets end up in numerical order
	(collect $Tablet)
		*(tablet $Tablet)
	(into $TabList)
	(reverse $TabList into $RevTabList)
	(exhaust) {
		*($Tablet is one of $RevTabList)
		(now) ($Tablet is #in #box)
	}

(item *(tablet $))
(logogram *(tablet $))
(determiner (tablet $)) KAM
(determiner comes after *(tablet $))

%% Because both DUB and KAM can match any tablet, disambiguation falls apart on a sentence like DUB 1 KAM ōḫḫun
%% This needs to be fixed properly at some point, but it’s the day before the deadline, so it’s time for awful hacks instead

([DUB (number $) KAM] is unsplittable)
([DUB (number $) ^ KAM] is unsplittable)
([DUB (number $)] is unsplittable)
([(number $) KAM] is unsplittable)
([(number $) & KAM] is unsplittable)

(parse ($Phrase is unsplittable) into noun list [$Single])
	(parse $Phrase into single noun $Single)
	(just) %% No ambiguity allowed for an unsplittable phrase!
	%% This would be a nice feature to add to the parser itself at a later date

#tablet1
(name *) DUB 1
(tablet *)
(* is #in #box) %% Since this one is already placed in the world, it won’t be rewritten by the puzzle machinery—which is good, because this one shouldn’t give testimony, it should lay out the design of the puzzle

#tablet2 %% All tablets will be populated and moved to the #box by act3_machinery.dg
(name *) DUB 2
(tablet *)

#tablet3
(name *) DUB 3
(tablet *)

#tablet4
(name *) DUB 4
(tablet *)

#tablet5
(name *) DUB 5
(tablet *)

#tablet6
(name *) DUB 6
(tablet *)

#tablet7
(name *) DUB 7
(tablet *)

#tablet8
(name *) DUB 8
(tablet *)

#tablet9
(name *) DUB 9
(tablet *)

(perform [[examine (tablet $Tablet)] $]) %% The one place in the game where examining is useful, because the Hittites had no specific word for “read”—only “look at a tablet” and “read a tablet aloud”
	(par) (testimony for $Tablet)
	(select)
		(div @error) {
			Hittite had no specific word for “read”: only “look at” and “speak out loud”. In this case, the narrator seems to be reading silently: he looks at the tablet, then provides the text of that tablet in the next paragraph.
		}
	(or)
	(stopping)

(testimony for #tablet1)
	Nu (dtml {F}) Gulzawiyaš šiuniyanza kiššan tēt: %% Thus spoke Gulzawiya the god-touched:
	mān=wa (span @akk) ina UD.20 (dtm2 {KAM}) (dtml {D}) Armaš aki, %% When the moon dies (i.e. is eclipsed) on the 20th day (of the month), (20 chosen because it’s an HZL sign in its own right, not a combination of multiple)
	nu=wa=kan 2 kupiyatallieš ḫaššun kunanzi. %% Two conspirators will kill the king.
	Nu ḫaššuš 5 antuḫšuš kupiyatiya punušta. %% The king questioned five people about the conspiracy.
	Nu parkueššanteš ašantan memiyan memiškanzi. %% The pure ones speak the real words.
	(now) (first tablet was read)

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% The Climax
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

#temple
(room *)
(neuter *)
(* uses preverb #in)
(name * in #nominative/#accusative/#bare) karimmi
(name * in #genitive) karimnaš
(name * in #dative) karimni
(name * in #ablative) karimnaz

(from * go #north to #sanctum)
(from * go #south to #freedom)

(prevent [[go *] $Details]) %% Force the player to explore the back room first
	~(#garment is #wornby #me)
	(describe negative action [[go *] $Details])
	Nu (name #garment) natta waššiyanun. %% I was not wearing a garment
	(div @error) { What exactly happened to the baker’s garment from the previous tablet is not clear. The word (name #garment) here might mean “appropriate clothing”—that is, a disguise—or it could mean that the protagonist discarded his unclean clothing and is now naked in the inner sanctum. }

(animate *(suspect $))
(*(suspect $) is #in #temple) %% Put them all in one room for now

#dubsar
(suspect *)
(number 1 means *)
(logogram *)
(name *) GAL DUB.SAR

#mecedi
(suspect *)
(number 2 means *)
(logogram *)
(name *) LU₂.(no space) (span @akk) mešedi
(* has modifier $X) ($X = {GAL})

#gectin
(suspect *)
(number 3 means *)
(logogram *)
(name *) GEŠTIN
(determiner *) LU₂.MEŠ
(* has modifier $X) ($X = {GAL})

#tuhkanti
(suspect *)
(number 4 means *)
(name * in #nominative) tuḫkantiš
(name * in #genitive) tuḫkantiyaš
(name * in #dative) tuḫkantiya
(name * in #accusative) tuḫkantin
(name * in #ablative) tuḫkantiyaz
(name * in #bare) tuḫkanti

#tawannana %% changed to ḫaššuššara; Tim thought the “MUNUS.LUGAL = tawannana vs ḫaššuššara” misreading was implausible
(suspect *)
(number 5 means *)
(name * in #nominative/#genitive) ḫaššuššaraš
(name * in #dative) ḫaššuššari
(name * in #accusative) ḫaššuššaran
(name * in #ablative) ḫaššuššaraz
(name * in #bare) ḫaššuššara

%% (bonus room description paragraph) %% Explain the unusual title
%% 	(current room #temple)
%% 	(select)
%% 		(div @error) { The word (span @hittite) tawannana is unexpected here, since that is a title of the Hittite queen specifically, not a foreign one. The scribe copying this tablet likely misinterpreted a logogram for “queen” and replaced it with the wrong Hittite word. }
%% 	(or)
%% 		(fail)
%% 	(stopping)

(real name * in $Case)
	(* uses name code $Code)
	(dtml {F})
	(female name $Code in $Case)

(real name (suspect $S) in $Case)
	($S uses name code $Code)
	(dtml {M})
	(male name $Code in $Case)

#realname %% In case players try to address the people by their personal names
(* is #in #temple)
(hidden *)
(dict * in $Case) %% Accept all the names
	*(male name $ in $Case)
	*(female name $ in $Case)
(refuse [$Action $])
	(* is one of $Action)
	(div @error) {
		The use of a personal name in this line is unexpected, as it is not clear which of the officials it refers to. Fortunately, the following lines refer to the officials by their titles instead.
	}

#king
(animate *)
(name * in #nominative) ḫaššuš
(name * in #genitive) ḫaššuwaš
(name * in #dative) ḫaššui
(name * in #accusative) ḫaššun
(name * in #ablative) ḫaššuwaz
(name * in #bare) ḫaššu

(* is #in #temple)

(select avenger $Avenger who is not $Victim)
	(if) ($Victim = #mecedi) (then) %% The bodyguard can’t jump in, so someone else has to
		($Avenger = #tuhkanti)
	(elseif) ($Victim = #tuhkanti) (then) %% Vice versa
		($Avenger = #mecedi)
	(elseif) (random from 1 to 2 into 1) (then) %% Both available, pick at random
		($Avenger = #tuhkanti)
	(else)
		($Avenger = #mecedi)
	(endif)

(perform [[slay $Victim | $] $]) %% It’s not that easy
	~(current player $Victim) %% You can kill yourself just fine
	(current room #temple)
	(select avenger $Avenger who is not $Victim)
	Nu=mu=kan (#nominative $Avenger) kuenta. %% The avenger slew me.
	(death ensues)

(perform [[question $] $]) %% This does nothing but the verb exists so it should be possible
	Nu=mu (#nominative #king) punušta. %% The king questioned me.
	Nu=mu=kan (#nominative #mecedi) kuenta. %% The bodyguard slew me.
	(death ensues)

(perform [$Action $Details] without prefix) %% We’ll be putting the prefix back in, but this is needed in order to take precedence over the implementation in actions.dg
	(fake signal $FSig)
	($FSig matches $Action)
	
	(describe action [$Action $Details])
	(wrong signal)

(perform [$Action $Details] without prefix)
	(real signal $RSig)
	($RSig matches $Action)
	
	(describe action [$Action $Details])
	
	(real assassin $Target)
	(if) ($Target is one of $Action) (then)
		($Target kills the king)
	(else)
		(wrong signal)
	(endif)

(wrong signal)
	Nu=mu (#nominative #king) punušta. %% The king questioned me.
	Nu=mu=kan (#nominative #mecedi) kuenta. %% The bodyguard slew me.
	Nu aggaḫḫun. %% I died.
	(div @tutorial) {
		Unfortunately, it seems that was not the right solution. You are welcome to (link) \/undo and try again, but brute-forcing this sort of logic puzzle is often frustrating instead of fun—so it may be more enjoyable to (link) \/restart and try again with a new puzzle. (par)
		Which will it be? >
		*(repeat forever)
		(get input $Words)
		(if) ($Words = [\/undo]) (or) ($Words = [undo]) (then)
			Very well.
		(elseif) ($Words = [\/restart]) (or) ($Words = [restart]) (then)
			Very well.
			(restart)
		(else)
			Please choose (link) \/undo or (link) \/restart .
			(fail)
		(endif)
	}
	%% If we got here, we chose to “undo” (actually continue)
	(div @error) {
		The text must be corrupt at this point, as the hero must survive to continue the story. Ignoring the last few lines, we continue on...
	}
	(stop)

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% The End
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

#freedom
(room *)
(* uses preverb #in)
(* has modifier #temple)
(name * in #nominative/#genitive) ḫilaš %% The “courtyard” that was south of the temple in act 2
(name * in #dative) ḫili
(name * in #accusative) ḫilan
(name * in #ablative) ḫilaz
(name * in #bare) ḫila

(prevent [[go *] $]) %% Can’t just leave without solving the puzzle!
	Nu (#ablative #temple) pāun. %% I went from the temple.
	Nu=mu (#nominative #king) aušta. %% The king saw me.
	Nu=mu (#nominative #king) punušta. %% The king questioned me.
	Nu=mu=kan (#nominative #mecedi) kuenta. %% The bodyguard slew me.
	(death ensues)

($Assassin kills the king)
	%% Here we go!
	Nu=kan (#nominative $Assassin) (#accusative #king) kuenta. %% X slew the king.
	(select avenger $Avenger who is not $Assassin)
	(if) (guilty $Avenger) (then)
		N=an=kan (#nominative #gectin) kuenta. %% Avoid edge case
	(else)
		N=an=kan (#nominative $Avenger) kuenta. %% Y slew him/her.
	(endif)
	
	(par) (hr)
	Nu zuppari dāḫḫun. %% I took a torch.
	Nu (#accusative #temple) zuppariyaz lukkun. %% I ignited the temple with the torch.
	(if) ~(#god is #heldby #me) (then)
		Nu (#accusative #god) dāḫḫun. %% I grabbed the god.
	(endif)
	Nu (#ablative #temple) pāun. %% I left the temple.
	Nu ḫappiraz pāun. %% I left the city.
	Nu šiun āppa arnunun. %% I brought the god back home.
	
	(par) (hr)
	(div @colophon) (colophon)
	(div @error) { Cuneiform tablets often end with a short “colophon”, providing the title, tablet number, and the name of the scribe who wrote it. In other words, this is... }
	
	(game over {The end})

(parse metacommand [\/win])
	(real assassin $Ass)
	(real signal $Sig)
	($Sig wants $Case)
	(select)
		(div @meta) {
			The winning command is: (span @hittite) { nu ($Case $Ass) (name $Sig) } .
		}
	(or)
		($Ass kills the king)
	(stopping)

(colophon)
	DUB 3 (dtm2 {KAM}) TIL (line)
	(span @akk) ša “Ḫattušumna Laḫḫa” (line)
	ŠU (dtm {1}) DI.KUD.DINGIR Ištelšar DUB.SAR (line)
	(span @akk) U₃ (dtml {M}) DI.KUD.DINGIR Gaškel DUB.DU₃.DU₃ (line) %% unattested logogram for “tablet maker”
	(span @akk) pani (dtml {M}) (span @dont-syllabify) TIM UR.MAḪ-muwa UM.MI.A (line)
	(span @akk) išṭuru

(style class @colophon)
	margin-left: 2em;
	margin-right: 2em;
	margin-top: 1em;
	margin-bottom: 1em;
	data-language: ht;
	font-weight: bold;

(style class @dont-syllabify) %% Hack to make m^Tim work properly: it needs to underlyingly be in uppercase to prevent syllabification, but then needs to display in title case in the transcription. This is handled by special CSS in aa_cuneiform.css.

(verb #v-look unlocked) %% This finally does something useful!
(verb #v-go unlocked)
%% (verb #v-cross unlocked)
(verb #v-take unlocked)
(verb #v-drop unlocked)
(verb #v-put unlocked)
(verb #v-slay unlocked) %% This doesn’t
(verb #v-wear unlocked)
%% (verb #v-wait unlocked)

%% (verb #v-question unlocked) (first tablet was read) %% Disabled for now
%% We use per-object flags for the signal verbs so they only pop up after reading the relevant tablets
(verb *(possible signal verb $V) unlocked) ($V is unlocked)

(avoid ablative case) %% But not genitive, for this tablet
