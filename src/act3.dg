#backroom
(room *)
(* uses preverb #in)
(name * in #nominative) appezziš antakaš %% lit. rear room
(name * in #genitive) appezziyaš antakaš
(name * in #dative) appezzi antaki
(name * in #accusative) appezzin antakan
(name * in #ablative) appezziyaz antakaz
(short name *) appezzi

(from * go #east to #sanctum)

(after [[go *] $])
	(select)
		(fix tablet order)
	(or)
	(stopping)

