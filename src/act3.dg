#tawannana
(suspect *)
(number 5 means *)
(name * in #nominative/#genitive) tawannanaš
(name * in #dative) tawannani
(name * in #accusative) tawannanan
(name * in #ablative) tawannanaz
(name * in #bare) tawannana

(on every tick) %% Explain the unusual title
	(current room #sanctum)
	(select)
		(div @error) { The word (span @htt) tawannana is unexpected here, since that is a title of the Hittite queen specifically, not a foreign one. The scribe copying this tablet likely misinterpreted a logogram. }
	(or)
	(stopping)

#king
(animate *)
(name * in #nominative) ḫaššuš
(name * in #genitive) ḫaššuwaš
(name * in #dative) ḫaššui
(name * in #accusative) ḫaššun
(name * in #ablative) ḫaššuwaz
(name * in #bare) ḫaššu

(* is #in #temple)

(real name * in $Case)
	(* uses name code $Code)
	(dtm {f})
	(female name $Code in $Case)

(real name (suspect $S) in $Case)
	($S uses name code $Code)
	(dtm {1})
	(male name $Code in $Case)

