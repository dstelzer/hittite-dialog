#box
(item *)
(* is #heldby #scribe)
(logogram *)
(name *) PISAN
(determiner *) GIŠ
(holder *)
(* wants relation #in)

(fix tablet order) %% Make sure the tablets end up in numerical order
	(collect $Tablet)
		*(tablet $Tablet)
	(into $TabList)
	(reverse $TabList into $RevTabList)
	(exhaust) {
		*($Tablet is one of $RevTabList)
		(now) ($Tablet is #in #box)
	}

(item *(tablet $))
(logogram *(tablet $))
(determiner (tablet $)) KAM
(determiner comes after *(tablet $))

#tablet1 %% All tablets will be populated and moved to the #box by act3_machinery.dg
(name *) DUB 1
(tablet *)

