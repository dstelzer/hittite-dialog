(story title) Ḫattušumna Laḫḫa Tablet 1: The Watchtower
(tablet title) Tablet 1: The Watchtower

#me
(current player *)
(animate *)
(name * in #nominative/#bare) ūk
(name * in #genitive) ammel
(name * in #dative/#accusative/#ablative) ammuk
(* is #in #riverbank)

(intro) %% No special intro
	(now) (update needed)
	%% Don't update map immediately

#riverbank
(room *)
(* uses preverb #at)
(name * in #nominative) wappuš
(name * in #genitive) wappuwaš
(name * in #dative) wappui
(name * in #accusative) wappun
(name * in #ablative) wappuwaz
(name * in #bare) wappu
(from * go #north to #watchtower)

(origin *) %% Map origin

(instead of [[put $Obj *] $Details])
	(try [[put $Obj #riverbank] $Details])

#river
(name * in #nominative/#genitive) ḫapaš
(name * in #dative) ḫapi
(name * in #accusative) ḫapan
(name * in #ablative) ḫapaz
(name * in #bare) ḫapa
(* is #in #riverbank)

(* is filled with #water) %% substances.dg

(instead of [[put $Dest *] $])
	($Dest accepts substance #water)
	~($Dest is filled with $)
	Nu (#accusative #water) (#dative $Dest modifierless) tēḫḫun.
	(now) ($Dest is filled with #water)
	(now) (update needed)
	(tick)

(instead of [[put $Obj *] $]) %% Pour other substances out into the river
	(item $Obj)
	($Obj is filled with $Substance)
	~($Substance = #fire) %% This gets its own description in actions.dg
	Nu (#accusative $Obj modifierless) (#dative #water) tēḫḫun.
	(now) ~($Obj is filled with $)
	(now) (update needed)
	(tick)

(instead of [[take *] $])
	(player can hold #water in $Dest) %% If this fails, fall back to "I can't hold the water"
	Nu (#accusative #water) (#dative $Dest modifierless) tēḫḫun. %% I put the water in the X.
	(now) ($Dest is filled with #water)
	(now) (update needed)
	(tick)

(prevent [[take *] $Details])
	(describe failed action [[take *] $Details])
	Nu (#accusative #water) natta taruḫḫun ḫarkun. %% "I was not able to hold the water."

#watchtower
(room *)
(* uses preverb #infront)
(name * in #nominative) auriš
(name * in #genitive) auriyaš
(name * in #dative) auriya
(name * in #accusative) aurin
(name * in #ablative) auriyaz
(name * in #bare) auri
%% (* has modifier $Mod) ($Mod = {E2})
(from * go #south to #riverbank)
(from * go #west to #street)
(from * go #east to #wall)
(from * go #north through #gate to #gatehouse)

#gate
(door *)
(* wants relation #at)
(* blocks passage)
	{ (#bolt is #in *) (or) (#bolt is pristine) }
(describe * blocking passage) Nu āškaš ḫattalwanza ēšta.
(room description *) (* blocks passage) ḫattalwantan āškan %% "closed door"
(short name *) āškan
(name * in #nominative) āškaš
(name * in #genitive) āškaš
(name * in #dative) āški
(name * in #accusative) āškan
(name * in #ablative) āškaz
(name * in #bare) āška
(dict * in #nominative/#bare) %% Adjective "closed" currently not displayed outside of the error message and room description
	(* blocks passage)
	ḫattalwanza
(dict * in #genitive)
	(* blocks passage)
	ḫattalwantaš
(dict * in #dative)
	(* blocks passage)
	ḫattalwanti
(dict * in #accusative)
	(* blocks passage)
	ḫattalwantan
(dict * in #ablative)
	(* blocks passage)
	ḫattalwantaz

#street
(room *)
(* uses preverb #at)
(name * in #nominative/#genitive) palšaš
(name * in #dative) palši
(name * in #accusative) palšan
(name * in #ablative) palšaz
(name * in #bare) palša
(from * go #east to #watchtower)

#ladder
(item *)
(neuter *)
(name * in #nominative) ilan
(name * in #genitive) ilanaš
(name * in #dative) ilani
(name * in #accusative) ilan
(name * in #ablative) ilanaz
(name * in #bare) ila
(* is #in #street)

(instead of [[cross *] $Details])
	($Details = [$Raw $Verb $Adv $ $Dat $Abl])
	(if) (current room #corner) (or) (current room #gatehouse) (then)
		(try [[cross #window] [$Raw $Verb $Adv #window $Dat $Abl]])
	(elseif) (current room #backroom) (then)
		(try [[go #roof] [$Raw $Verb $Adv #roof $Dat $Abl]])
	(else)
		(fail) %% Default message will say that non-doors can't be crossed
	(endif)

#wall
(room *)
(* uses preverb #under)
(name * in #nominative) kuzza
(name * in #genitive) kuttaš
(name * in #dative) kutti
(name * in #accusative) kuttan
(name * in #ablative) kuttaz
(name * in #bare) kut
(from * go #west to #watchtower)
(from * go #north to #corner)

#corner
(room *)
(neuter *)
(* uses preverb #nextto)
(name * in #nominative/#accusative/#bare) ḫalḫaltomar
(name * in #genitive) ḫalḫaltomaraš
(name * in #dative) ḫalḫaltomari
(name * in #ablative) ḫalḫaltomaraz
