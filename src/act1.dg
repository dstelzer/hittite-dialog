(name * in #nominative/#accusative/#bare) ḫilammar
(name * in #genitive) ḫilamnaš
(name * in #dative) ḫilamni
(name * in #ablative) ḫilamnaz
(from * go #east through #window to #corner)
(from * go #south through #gate to #watchtower)
(from * go #west to #foyer)
(from * go #north to #backroom)

#bolt
(item *)
(neuter *)
(determiner *) GIŠ
(name * in #nominative/#accusative/#bare) ḫattalu
(name * in #genitive) ḫattaluwaš
(name * in #dative) ḫattaluwi
(name * in #ablative) ḫattaluwaz

(* accepts substance #fire)

(after [[cross #window] | $]) %% Only describe it on the inside
	(* is pristine)
	(now) (* is #in #gate)

(narrate taking *)
	(* is pristine)
	Nu āškan ḫašḫun. %% "I opened the gate."
	(now) (update needed)

#foyer
(room *)
(* uses preverb #in)
(name * in #nominative) arkiwiš
(name * in #genitive) arkiwaš
(name * in #dative) arkiwi
(name * in #accusative) arkiwin
(name * in #ablative) arkiwaz
(name * in #bare) arkiwi
(determiner *) E₂
(dict * in $) E2 É

(from * go #east to #gatehouse)
(from * go #north to #storeroom)

#hearth
(holder *)
(* wants relation #in)
(name * in #nominative/#genitive) ḫaššaš
(name * in #dative) ḫašši
(name * in #accusative) ḫaššan
(name * in #ablative) ḫaššaz
(name * in #bare) ḫašša
(* is #in #foyer)

(* is filled with #fire)
(#fire is #in *)
(on every tick) %% Remove the fire object when needed
	(#fire is #in *)
	~(* is filled with #fire)
	(now) (#fire is nowhere)

(instead of [[put $Obj #fire] $Details])
	(current room #foyer)
	(try [[put $Obj #hearth] $Details])

(prevent [[put #amphora *] $Details])
	~(#amphora is filled with $) %% No water to pour out
	(describe failed action [[put #amphora *] $Details])
	Nu (#nominative #amphora modifierless) mekki šalliš ēšta. %% The amphora was very big.

(prevent [[take $Obj | $From] $Details])
	($Obj is #in #hearth)
	(#fire is #in #hearth)
	(describe failed action [[take $Obj | $From] $Details])
	Nu paḫḫur än ēšta. %% "The fire was hot."
	%% ä = a-a-a°

