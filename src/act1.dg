(from * go #south to #wall)
(from * go #west through #window to #gatehouse)

#window
(door *)
(neuter *)
(* blocks passage)
	(current room $Room)
	~{ ($Room is one of [#corner #gatehouse]) (#ladder is #in $Room) } %% Don't pathfind through it
(describe * blocking passage) N=at parku ēšta. %% "The window is high up"
(name * in #nominative/#accusative/#bare) luttāi
(dict * in #nominative/#accusative/#bare) luttai
(name * in #genitive) luttiyaš
(name * in #dative) luttiya
(name * in #ablative) luttiyaz
