%% Now how do we print these in Hittite?
%% We do a lot of messing around with case...which currently ends up being unnecessary, because with the rewrite of the testimony, the names are never in any case except the nominative
%% But I'm keeping it here in case the writing changes again

($Suspect in $Case name-only)
	(real name $Suspect in $Case)

($Suspect in $Case title-only)
	($Case $Suspect)

($Suspect in $Case name and title)
	(logogram $Suspect)
	(span @akk) (akkadian preposition for $Case) %% preposition goes before all
	(real name $Suspect in $Case) %% personal name
	(name $Suspect) %% job title
($Suspect in $Case name and title)
	~(logogram $Suspect)
	(real name $Suspect in $Case)
	($Case $Suspect)

(source $Suspect $Case)
	($Suspect is elimination-revealed) %% Only name as target, only job as source
	($Suspect in $Case title-only)
(source $Suspect $Case)
	($Suspect is other-revealed) %% Name + job as target, source doesn't matter
	($Suspect in $Case title-only)
(source $Suspect $Case) %% Name + job as source, target doesn't matter
	($Suspect in $Case name and title)

(advanced target $Suspect $Case) %% Always name
	($Suspect in $Case name-only)

(basic target $Suspect $Case)
	($Suspect is elimination-revealed) %% Only name as target, only job as source
	($Suspect in $Case name-only)
(basic target $Suspect $Case)
	($Suspect is other-revealed) %% Name + job as target, source doesn't matter
	($Suspect in $Case name and title)
(basic target $Suspect $Case) %% Name + job as source, target doesn't matter
	($Suspect in $Case name-only)

(real signal)
	(real signal $S)
	(signal $S)
(fake signal)
	(fake signal $S)
	(signal $S)

(testimony for $Tablet)
	($Tablet has source $Source)
	($Tablet has target $Target)
	($Tablet has type $Type)
	
	%% First, the source
	(span @akk) Umma (source $Source #nominative) (no space):
	
	%% When we generated the puzzle, we only had two types of edge: 0 and 1
	%% 0 for basic, 1 for advanced
	%% But sometimes this can lead to awkwardness when a single speaker has multiple type-1 edges to opposite-polarity targets: it sounds wrong for them to say two complicated sentences with "someone" in them if they know both of the "someone"s!
	%% So when that happens, we change all but the first to type-2
	(if) ($Type = 2) (then) %% Special advanced edge
		%% It would be nice for this text to say "X is the mastermind" or "X is the assassin", but I haven't found clean ways to express that in Hittite
		nu=wa (advanced target $Target #nominative) kupiyatin kupta. %% "X conspired a conspiracy."
	(elseif) ($Type = 1) (then) %% Advanced edge
		(if) ($Source and $Target agree) (then) %% X is not guilty
			nu=wa (advanced target $Target #nominative) natta paprišzi.
		(elseif) (real assassin $Target) (then)
			(real signal $Sig) ($Sig wants $Case)
			mān=wa
			(if) ($Case = #dative) (then) (no space) =ši
			(elseif) ($Case = #accusative) (then) (no space) =an
			(else) (div @realerror) { Signal $Sig does not take case? } (endif)
			kuiški (real signal) , %% When someone Z's them,
			nu=wa=kan (advanced target $Target #nominative) (#accusative #king) kuenzi. %% X will kill the king
			(now) ($Sig is unlocked)
		(elseif) (fake assassin $Target) (then)
			(fake signal $Sig) ($Sig wants $Case)
			mān=wa
			(if) ($Case = #dative) (then) (no space) =ši
			(elseif) ($Case = #accusative) (then) (no space) =an
			(else) (div @realerror) { Signal $Sig does not take case? } (endif)
			kuiški (fake signal) , %% When someone Z's them,
			nu=wa=kan (advanced target $Target #nominative) (#accusative #king) kuenzi. %% X will kill the king.
			(now) ($Sig is unlocked)
		(elseif) (real mastermind $Target) (then)
			(real signal $Sig) ($Sig wants $Case)
			mān=wa
			(if) ($Case = #dative) (then) (no space) =ši
			(elseif) ($Case = #accusative) (then) (no space) r=an
			(else) (div @realerror) { Signal $Sig does not take case? } (endif)
			(advanced target $Target #nominative) (real signal) , %% When X Z's them,
			nu=wa kuiški (#accusative #king) kuenzi. %% someone will kill the king.
			(now) ($Sig is unlocked)
		(elseif) (fake mastermind $Target) (then)
			(fake signal $Sig) ($Sig wants $Case)
			mān=wa
			(if) ($Case = #dative) (then) (no space) =ši
			(elseif) ($Case = #accusative) (then) (no space) r=an
			(else) (div @realerror) { Signal $Sig does not take case? } (endif)
			(advanced target $Target #nominative) (fake signal) , %% When X Z's them,
			nu=wa kuiški (#accusative #king) kuenzi. %% someone will kill the king.
			(now) ($Sig is unlocked)
		(else)
			(div @realerror) { ERROR: There should never be an advanced edge pointing to the fake default. Something is deeply wrong! }
		(endif)
	(else) %% Basic edge
		(if) ($Source and $Target agree) (then)
			nu=wa (basic target $Target #nominative) parkuešzi.
		(else)
			nu=wa (basic target $Target #nominative) paprišzi.
		(endif)
	(endif)
