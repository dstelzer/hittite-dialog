(extension version)
	Hittite action processing version 260713.

(action logging) (fail)

(action log $Closure)
	(action logging)
	(log) (query $Closure)
(action log $) %% Always succeed

(avoid ablative case) (fail) %% Individual games can override these to customize
(avoid genitive case) (fail) %%   how actions are parsed and reported

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Look: not really an action, but we implement it as one for now
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

(update description)
	(update environment around player)
	%% No longer using a status area for this
	(hr)
	(div @status) (describe environment)

(redraw separate panels)
	(using separate panels)
	(compass rose panel) %% Compass rose must come before automap for flag reasons
	(verbs list panel)
	(automap panel)
	(meta panel)
(redraw separate panels)

(meta panel)
	(inline status bar @p-meta) (meta verbs list)
(meta verbs list)
	~(meta verbs introduced)
	Use (link) /about for info.
(meta verbs list)
	(span @metaverb) (link) /undo ,
	(span @metaverb) (link) /save ,
	(span @metaverb) (link) /restore ,
	(span @metaverb) (link) /again ,
	(span @metaverb) (link) /about

(style class @p-meta)
	data-language: en;
	font-family: sans-serif;
(style class @metaverb)
	white-space: nowrap;

(automap panel) ~(given first message)
(automap panel) ~(map update needed)
(automap panel)
	(inline status bar @p-map) (automap)
	(now) ~(map update needed)

(style class @p-map)
	font-size: larger; %% Make it a bit bigger
	overflow-x: scroll; %% And scroll if it becomes an issue

(header (room $Room))
	($Room uses preverb $Prep)
	Nu=za
	(if) ($Prep is one of [#in #on #behind]) (then) %% anda, šēr, appa
		(no space) =kan
	(endif)
	(location name $Room)
	(preverb $Prep)
	ešun.
(short name (inherently dark $Room))
	(current player $Player)
	~($Player has a light source)
	~($Room has a light source)
	dankui %% "Dark"
(short name (logogram $Room)) (name $Room in #bare)
(short name (room $Room)) (name $Room in #dative)
(short name (door $Door)) (name $Door in #accusative)
(short name $Obj) $Obj %% Don't crash

(location name $Room) (#dative $Room) %% Some rooms override this

#darkness
(add * to scope) *(adjacent $Room) (inherently dark $Room)
(inherently dark *) %% Make the "go to a dark room" rules apply to this
(name * in #dative) dankui
(refuse [$Action $]) %% Prevent any interaction with this noun
	(* is one of $Action)
	~{ ($Action = [go *]) (or) ($Action = [travel *]) }
	(div @error) { Since the "dark" is insubstantial, it's unclear what this action would entail. }

(describe environment)
	
	%% Compass rose belongs off to one side, but in debugger it has to be inline
	(if) (interpreter supports status bar) ~(using separate panels) (then)
		(compass rose)
		(automap)
	(endif)
	
	%% First paragraph: "I was at [location]."
	(current room $Loc)
	(action log {Current room: $Loc} )
	(header $Loc)
	
	%% Second paragraph: Nu apiya ("there", or kā "here"?) OBJECTS-ACC ōḫḫun.
	(collect $Obj)
		*($Obj is #in $Loc)
		~(hidden $Obj)
	(into $HereList)
	(action log {Here: $HereList} )
	(if) (nonempty $HereList) (then)
		(par) Nu apiya
		(room description $HereList)
		ōḫḫun.
	(endif)
	
	%% Subsequent lines: Nu OBJECT-NOM CONTAINER-DAT anda ēšta/ešer
	(collect $Obj)
		*($Obj has ancestor $Loc)
		($ is $ $Obj)
	(into $ContainerList)
	(action log {Containers: $ContainerList} )
	(exhaust) {
		*($Container is one of $ContainerList)
		($Container wants relation $Rel)
		(collect $Obj)
			*($Obj is $ $Container)
		(into $ContentsList)
		(line) Nu
		(if) ($Rel is one of [#in #on #behind]) (then) %% anda, šēr, appa
			(no space) =kan
		(endif)
		(#nominative $ContentsList)
		(#dative $Container)
		(preverb $Rel)
		(if) ($ContentsList = [$]) (then) ēšta (else) ešer (endif)
		.
	}
	%% We also include the player if something is "on" them
	(if) (current player $Player) ($ is #on $Player) (then)
		(collect $Obj)
			($Obj is #on $Player)
		(into $OnList)
		(line) Nu (#nominative $OnList) (#dative $Player)
		(if) ($ContentsList = [$]) (then) ēšta (else) ešer (endif)
		.
	(endif)
	
	%% Third paragraph: Nu INVENTORY-ACC ḫarkun.
	(current player $Player)
	(collect $Obj)
		*($Obj is #heldby $Player)
	(into $HeldList)
	(action log {Held: $HeldList} )
	(if) (nonempty $HeldList) (then)
		(par) Nu
		(#accusative $HeldList)
		ḫarkun.
	(endif)
	
	%% Extra bonus paragraph: if avoiding genitive case, we need to mention water being in vessels too
	(if) (avoid genitive case) (then)
		(collect $Obj)
			*($Obj has ancestor $Loc)
			*(item $Obj)
			($Obj is filled with #water)
		(into $WaterList)
		(action log {Water: $WaterList} )
		(if) (nonempty $WaterList) (then)
			(line) Nu (#dative $WaterList) (#nominative #water) ēšta.
		(endif)
	(endif)
	
	%% Fourth paragraph: Nu CLOTHES-ACC waššiyanun.
	(collect $Obj)
		*($Obj is #wornby $Player)
	(into $WornList)
	(action log {Worn: $WornList} )
	(if) (nonempty $WornList) (then)
		(par) Nu
		(#accusative $WornList)
		waššiyanun.
	(endif)
	
	%% Extra bonus paragraph if needed
	(par) (bonus room description paragraph)
	
	%% Final paragraph: verbs
	(if) ~(using separate panels) (then)
		(par) (div @verbs) (verbs list)
	(endif)
	
	%% Compass rose belongs off to one side, but in debugger it has to be inline
	(if) ~(interpreter supports status bar) ~(using separate panels) (then)
		(compass rose)
		(automap)
	(endif)

(hidden (current player $)) %% Extend this predicate to hide things from room descriptions when necessary

(bonus room description paragraph) %% By default nothing

%% Some objects override this to add more detail if (and only if) they're on their own
(room description [$Single]) (room description $Single)
(room description $Whatever) (#accusative $Whatever)

(using separate panels) %% Only do this if it won't interfere with the normal stuff
	(interpreter supports status bar) (interpreter supports inline status bar)

(verbs list) ~(given first message)
(verbs list)
	(span @bold) { Verbs: }
	(collect $Verb)
		*(verb $Verb)
		(verb $Verb unlocked)
	(into $VerbList)
	(listing $VerbList {(hittite name $_)} @, 0)

(hittite name $Obj) (span @hittite) (name $Obj) %% TODO workaround for Dialog bug

(verbs list panel)
	(inline status bar @p-verbs) (verbs list)
(style class @p-verbs)
	margin-left: 2em;
	text-indent: -2em;
	data-language: en; %% Verbs are in @hittite spans inside this

(style class @verbs)
	width: 100\%;
	text-align: center;
	font-style: italic;
	data-language: en;

(interface ($<Dir on the compass rose is $>Obj))
($Dir on the compass rose is $Obj)
	(current room $Loc)
	(from $Loc go $Dir to $Obj)
	{ (room $Obj) (or) (door $Obj) }
($ on the compass rose is []) %% Use [] if there's no room that way

(length of single word $Word is $Length)
	(split word $Word into $List)
	(accumulate 1) *($ is one of $List) (into $Length)
(short name of $Obj needs $Num characters)
	(collect words) (short name $Obj) (into $Name)
	(if) ($Name = [$Word]) (then)
		(length of single word $Word is $Intermediate)
	(endif)
	(if) (direction numbers enabled) (then)
		($Intermediate plus 2 into $Num) %% 1 for digit 1 for space
	(else)
		($Intermediate = $Num)
	(endif)

(print name of [] number $ with alignment $ in $Width characters) %% Empty space
	(space $Width)
(print name of $Obj number $N with alignment $Align in $Width characters)
	
	%% First, figure out the alignment needed
	(short name of $Obj needs $Needed characters)
	(if) ($Needed > $Width) (then)
		(div @realerror) { $Obj too long! } (fail)
	(endif)
	($Width minus $Needed into $Excess)
	(if) ($Align = @l) (then) %% Left
		($Left = 0)
		($Right = $Excess)
	(elseif) ($Align = @r) (then) %% Right
		($Left = $Excess)
		($Right = 0)
	(elseif) ($Align = @u) (then) %% Center, top (offset left if odd)
		($Excess divided by 2 into $Right)
		($Excess minus $Right into $Left)
	(else) %% Center, bottom (offset right if odd)
		($Excess divided by 2 into $Left)
		($Excess minus $Left into $Right)
	(endif)
	
	%% Then, do the actual printing
	%% This should only be done in a fixed-width div or span, for obvious reasons
	(space $Left)
	(print name of $Obj number $N)
	(space $Right)

%% If the interpreter supports text alignment, we can also do a simpler thing
(print name of [] number $)
	(space 1) %% Keep alignment roughly consistent by ensuring the divs are never entirely empty
(print name of $Obj number $N)
	(if) (direction numbers enabled) (then) (link) $N (space 1) (endif)
	(if) (interpreter supports text alignment) (then)
		(medium short name $Obj) %% We can allow slightly longer names then, if some objects need them
	(else)
		(short name $Obj)
	(endif)

(medium short name $Obj) (short name $Obj) %% Most objects won't though

%% Fancy one involving injecting into specific HTML elements
%% This should be changed to use (status panel $) when I get that proposal through
%% Right now it's using a hacked interpreter that makes (inline status bar $) act like (status panel $) eventually will
(compass rose panel) ~(given first message)
(compass rose panel) ~(map update needed)
(compass rose panel)
	(#north on the compass rose is $North)
	(#east on the compass rose is $East)
	(#south on the compass rose is $South)
	(#west on the compass rose is $West)
	(#up on the compass rose is $Up)
	(#down on the compass rose is $Down)
	
	(inline status bar @c-north) (print name of $North number 2)
	(inline status bar @c-up) (print name of $Up number 5)
	(inline status bar @c-west) (print name of $West number 4)
	(inline status bar @c-rose) (rose star)
	(inline status bar @c-east) (print name of $East number 3)
	(inline status bar @c-down) (print name of $Down number 6)
	(inline status bar @c-south) (print name of $South number 1)

%% Set alignment for all the individual boxes
(style class @c-north)
	text-align: center;
(style class @c-up)
	text-align: right;
(style class @c-west)
	text-align: right;
(style class @c-rose)
	text-align: center;
	font-size: 2em;
(style class @c-east)
	text-align: left;
(style class @c-down)
	text-align: left;
(style class @c-south)
	text-align: center;

%% Normal one that works on any backend
(compass rose) ~(given first message)
(compass rose)
	(#north on the compass rose is $North)
	(#east on the compass rose is $East)
	(#south on the compass rose is $South)
	(#west on the compass rose is $West)
	(#up on the compass rose is $Up)
	(#down on the compass rose is $Down)
	
	(div @compass) {
		(div @compassline) { %% Line 1: north and up
			(if) (empty $Up) (then) %% Give more space to north
				(space 9)
				(print name of $North number 2 with alignment @u in 15 characters)
				(space 9)
			(else)
				(space 10)
				(space 1)
				(print name of $North number 2 with alignment @u in 10 characters)
				(space 2)
				(print name of $Up number 5 with alignment @r in 10 characters)
			(endif)
		}
		(div @compassline) { %% Line 2: west, rose, east
			(print name of $West number 4 with alignment @r in 15 characters)
			(space 1) (rose star) (space 1)
			(print name of $East number 3 with alignment @l in 15 characters)
		}
		(div @compassline) { %% Line 3: down, south
			(if) (empty $Down) (then) %% As above with up
				(space 9)
				(print name of $South number 1 with alignment @d in 15 characters)
				(space 9)
			(else)
				(print name of $Down number 6 with alignment @l in 10 characters)
				(space 2)
				(print name of $South number 1 with alignment @d in 10 characters)
				(space 1)
				(space 10)
			(endif)
		}
	}

(rose star) (unlock wait on the compass rose) (link [0]) ✧ %% See under WAIT
(rose star) ✧ %% U+2727 WHITE FOUR POINTED STAR
(style class @compass)
	width: 33ch; %% 15 3 15, or 9 15 9, or 10 1 10 2 10
	float: right;
(style class @compassline)
	font-family: monospace, monospace;
	width: 100\%;
	height: 1em;

(verb @look/@oḫḫun/@ōḫḫun/@uḫḫun/@ūḫḫun means @ōḫḫun)
(@ōḫḫun wants cases [])
(@ōḫḫun wants cases [#accusative])
(translate [$ ōḫḫun $ [] | $] into [look])
(translate [$ ōḫḫun $ $Acc | $] into [examine $Acc])
(perform [[look] $])
	(now) (update needed)
	(now) (map update needed)
(perform [[examine (room $Room)] $] without prefix)
	(current room $Current)
	{
		(from $Current go $Dir to $Room)
	(or)
		*(from $Current go $Dir to $Door)
		(from $Current through $Door to $Room)
	}
	%% Now we know the direction
	Nu (#accusative $Room) (#dative $Dir) ōḫḫun.
(perform [[examine (direction $Dir)] $] without prefix)
	(current room $Current)
	{
		(from $Current go $Dir to $Room)
	(or)
		(from $Current go $Dir to $Door)
		(from $Current through $Door to $Room)
	}
	%% Now we know the room
	Nu (#accusative $Room) (#dative $Dir) ōḫḫun.
(perform [[examine $] $]) %% Not a useful action in this game for anything else
	(now) (update needed)
	(now) (map update needed)

#v-look
(verb *)
(name *) ōḫḫun

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% GO (and TRAVEL)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

(verb @go/@paun/@pāun means @pāun)
(@pāun wants cases [#dative])
(translate [$ pāun $ $ $Dat | $] into [go $Dat])
	(adjacent $Dat) (or) (direction $Dat)
(translate [$ pāun $ $ $Dat | $] into [travel $Dat])
	~{ (adjacent $Dat) (or) (direction $Dat) }

%% Disprefer travelling
%% Argument is a complex action: [raw verb [adv] [acc] [dat] [abl]]
(unlikely [$ pāun $ $ $Dat $])
	*($Room is one of $Dat)
	~(adjacent $Room)
%% _Really_ disprefer travelling to multiple places
(very unlikely [$ pāun $ $ $Dat $])
	*($Room is one of $Dat)
	~(adjacent $Room)
	($Dat = [$ $ | $]) %% At least two entries

(scope for @pāun is #go-policy)
#go-policy
($Obj is in scope for *)
	*(adjacent $Obj)
($Obj is in scope for *)
	*(room $Obj)
	($Obj is visited)
($Obj is in scope for *)
	*(direction $Obj)

(adjacent $Room)
	(current room $Loc)
	{ (from $Loc go $ to $Room) (or) (from $Loc through $ to $Room) }
(adjacent (current room $Room))
(adjacent #darkness)

%% For these specific actions, don't require targets to be in the same room
~(refuse [[go $] $])
~(refuse [[travel $] $])

(instead of [[go (direction $Dir)] $Details])
	(current room $Room)
	(if) (from $Room go $Dir to $Next) (room $Next) (then)
		(try [[go $Next] $Details])
	(elseif) (from $Room go $Dir to $Next) (door $Next) (then)
		(try [[cross $Next] $Details])
	(else)
		(div @error) { This line is likely an error. The narrator describes going (name $Dir) , but it's unclear what would be in that direction. }
		(stop)
	(endif)

(prevent [[go $Dest] $Details])
	(current room $Source)
	(from $Source through $Door to $Dest)
	(action log {Found door $Door})
	($Door blocks passage)
	(describe failed action [[go $Dest] $Details])
	(describe $Door blocking passage)

(describe $Door blocking passage) %% This should be overridden for each door if possible
	Nu (#nominative $Door) ḫattalwantaš ēšta. %% "The DOOR was closed."
(($Door is closed) blocks passage)
($ is closed) (fail) %% TODO do we even want this in the world model?

(prevent [[go (inherently dark $Dest)] $]) %% See also under CROSS
	(current player $Player)
	~($Player has a light source)
	~($Dest has a light source)
	Nu pēdan kuit dankui ēšta, %% "Because the place was dark..."
	parā natta taruḫḫun pāun. %% "...I was not able to go onward."

($Parent has a light source)
	*($Obj has ancestor $Parent)
	($Obj provides light)

(prevent [[go (current room $Dest)] $Details])
	(describe failed action [[go $Dest] $Details])
	Nu=za apēdani pēdi karū ešun. %% "I was already in that place."

(prevent [[go $Dest] $])
	~(room $Dest)
	(div @error) { This line is likely a scribal error. The verb (span @hittite) pāun "go" is generally used with locations, not objects; for things like doors and thresholds, the verb (span @hittite) šarraḫḫun "pass through" is used instead. }

(prevent [[go $Dest] $])
	(current room $Source)
	~{ (from $Source go $ to $Dest) (or) (from $Source through $ to $Dest) }
	(div @realerror) { ERROR: no immediate connection from source $Source to destination $Dest! How was this action created? }

(perform [[go $Dest] $])
	(enter $Dest)

%% "Travel" is the action invoked when the room isn't adjacent; it plots out a route and tries to move along it

(prevent [[travel $Dest] $Details])
	(current room $Source)
	~(first step from $Source to $Dest is $)
	(describe failed action [[travel $Dest] $Details])
	(div @error) { It seems there was no easy route between those locations, since the narrator states it as a simple fact that he could not travel from one to the other. }

(perform [[travel $Dest] $])
	(current room $Source)
	(shortest path from $Source to $Dest is $Path)
	(action log {Path: $Path})
	(convert direction list $Path to numbers $Numbers)
	(parse number list $Numbers)
	(inhibit next tick)

#v-go
(verb *)
(name *) pāun

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% CROSS
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%% Default Dialog uses the same verb for going to a room and going through a door, but in Hittite there are separate verbs for them

(verb @cross/@šarraḫḫun means @šarraḫḫun)
(@šarraḫḫun wants cases [#accusative])
(translate [$ šarraḫḫun $ $Acc | $] into [cross $Acc])

(prevent [[cross $Door] $])
	~(door $Door)
	(div @error) { This line is likely a scribal error. The verb (span @hittite) šaraḫḫun "pass through" is generally used with things like doors and thresholds. For going to a place, the verb (span @hittite) pāun is used instead. }

(prevent [[cross $Door] $Details])
	($Door blocks passage) %% See above under GO for details
	(describe failed action [[cross $Door] $Details])
	(describe $Door blocking passage)

(prevent [[cross $Door] $Details]) %% Copied from GO
	(current room $Room)
	(from $Room through $Door to $Dest)
	(inherently dark $Dest)
	(current player $Player)
	~($Player has a light source)
	~($Dest has a light source)
	Nu pēdan kuit dankui ēšta, %% "Because the place was dark..."
	(describe raw failed action [[cross $Door] $Details]) %% "raw" = no connective, caps, or punctuation
	.

(prevent [[cross $Door] $])
	~{ (current room $Room) (from $Room through $Door to $Dest) (room $Dest) }
	(div @realerror) { ERROR: Cannot go through $Door ! What's going on? }

(perform [[cross $Door] $])
	(current room $Room)
	(from $Room through $Door to $Dest)
	(enter $Dest)

#v-cross
(verb *)
(name *) šarraḫḫun

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% GO shorthand: raw numbers
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%% 0: wait (not attested) (TODO: how does this look in cuneiform?)
%% 1: south
%% 2: north
%% 3: east
%% 4: west
%% 5: up (not attested)
%% 6: down (not attested)

(parse number list $Numbers)
	(stoppable) {
		(exhaust) {
			*($Num is one of $Numbers)
			(use direction number $Num)
		}
	}

(use direction number ~(number $Num))
	(div @realerror) { ERROR: How did non-number $Num get into the direction list? }
	(stop)
(use direction number $Num)
	{ ($Num > 6) }
	(div @error) {
		Only the numbers 1 through 4 were used as shorthand for directions \( plus 5 and 6 in this particular text
		(if) (unlock wait on the compass rose) (then)
			, and 0 for waiting
		(endif)
		\) , so it's not clear what $Num would mean.
	}
	(stop)

(use direction number 0) %% See under WAIT
	(wait)
	(tick)
(use direction number $Num)
	(number $Num means direction $Dir)
	(current room $Room)
	(if) (from $Room go $Dir to $Next) (then)
		(line) $Num (space 3)
		(if) (room $Next) (then)
			(try [[go $Next] [[$Num] pāun [] [] $Next []]])
		(elseif) (door $Next) (then)
			(try [[cross $Next] [[$Num] šarraḫḫun [] $Next [] []]])
		(else)
			(div @realerror) { ERROR: $Dir from $Room is $Next which is neither room nor door! }
			(stop)
		(endif)
		(tick)
	(else)
		(div @error) {
			The number $Num here presumably means going (name $Dir)(no space)ward, but it's unclear what would be in that direction.
		}
		(stop)
	(endif)

(number 1 means direction #south)
(number 2 means direction #north)
(number 3 means direction #east)
(number 4 means direction #west)
(number 5 means direction #up)
(number 6 means direction #down)

(convert direction list [] to numbers [])
(convert direction list [$Head|$Tail] to numbers [$NewHead|$NewTail])
	(number $NewHead means direction $Head)
	(convert direction list $Tail to numbers $NewTail)

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% TAKE
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

(verb @take/@dāḫḫun/@daḫḫun means @dāḫḫun)
(@dāḫḫun wants cases [#accusative])
(@dāḫḫun wants cases [#accusative #ablative])
(translate [$ dāḫḫun $ $Acc $ []] into [take $Acc])
(translate [$ dāḫḫun $ $Acc $ $Abl] into [take $Acc from $Abl])

(unlikely [$ $ $ $Accs $ $Abls]) %% Note: input is complex action, not action! [[raw] verb [advs] [accs] [dats] [abls]]
	*($Acc is one of $Accs)
	*($Abl is one of $Abls)
	~($Acc has parent $Abl)

(instead of [[take $Obj] $Details]) %% Change to TAKE FROM if there's a holder
	~(avoid ablative case)
	($Obj is $ $Holder)
	~(room $Holder)
	~(current player $Holder)
	(action log {Redirecting TAKE $Obj to TAKE $Obj FROM $Holder})
	(if) ($Details = [$Raw $Verb $Adv $Obj [] []]) (then) %% Last two should always be empty
		(try [[take $Obj from $Holder] [$Raw $Verb $Adv $Obj [] $Holder]])
	(else)
		(div @realerror) { ERROR: Something went wrong converting TAKE to TAKE FROM. Details are $Details . }
	(endif)

(prevent [[take $Obj from $Holder] $Details])
	~($Obj is $ $Holder)
	($Holder wants relation $Rel)
	(describe failed action [[take $Obj from $Holder] $Details])
	Nu (#nominative $Obj) natta (#dative $Holder) (preverb $Rel) ēšta. %% "The OBJ was not REL the HOLDER."

(prevent [[take $Obj | $From] $Details]) %% Or is this message better?
	~(item $Obj)
	(describe failed action [[take $Obj | $From] $Details])
	(if) (neuter $Obj) (then)
		N=at mekki nakki
	(else)
		N=aš mekki nakkiš
	(endif)
	ēšta. %% "It was very heavy."

(prevent [[take $Obj | $] $Details])
	(current player $Player)
	($Obj is #heldby $Player)
	(describe failed action [[take $Obj] $Details])
	(if) (neuter $Obj) (then)
		N=at
	(else)
		N=an
	(endif)
	karū ḫarkun. %% "I already held it"

(perform [[take $Obj | $] $])
	(narrate taking $Obj)
	(current player $Player)
	(now) ($Obj is #heldby $Player)
	(now) ($Obj is handled)
	(now) (update needed)

(narrate taking $) %% Nothing by default

#v-take
(verb *)
(name *) dāḫḫun

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% DROP
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

(adverb @kattan/@katta/@down means @katta)

(verb @put/@tēḫḫun/@teḫḫun means @tēḫḫun)
(@tēḫḫun wants cases [#accusative #adverb])
(translate [$ tēḫḫun $Advs $Acc | $] into [drop $Acc]) (@katta is one of $Advs)

(prevent [[drop $Obj] $Details])
	(current player $Player)
	~($Obj has ancestor $Player)
	(describe failed action [[drop $Obj] $Details])
	(if) (neuter $Obj) (then)
		N=at
	(else)
		N=an
	(endif)
	natta ḫarkun. %% "I did not hold it."

(perform [[drop $Obj] $])
	(current room $Room)
	(now) ($Obj is #in $Room)
	(now) (update needed)

(verb #v-put) %% Ensure PUT is listed before DROP when both are unlocked

#v-drop
(verb *)
(name *) katta tēḫḫun

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% PUT
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%% (verb $ means $) already done above
(@tēḫḫun wants cases [#adverb #accusative #dative]) %% Preverb is currently ignored but is handled as #adverb
(translate [$ tēḫḫun $ $Acc (object $Dat) | $] into [put $Acc $Dat])

%% TODO: consider the preverb/postposition

%% We also handle tēḫḫun without dat or adv here, but only to give an error message
(@tēḫḫun wants cases [#accusative])
(translate [$ tēḫḫun [] $Acc [] | $] into [put $Acc])
(refuse [[put $] | $])
	(div @error) {
		This sentence seems to be incomplete. The verb (span @hittite) tēḫḫun should include a destination: either a noun in the dative, or an adverb like (span @hittite) katta "down" \( on the ground \) .
	}

(prevent [[put $Obj $Dest] $Details])
	(current player $Player)
	~($Obj has ancestor $Player)
	(describe failed action [[put $Obj $Dest] $Details])
	(if) (neuter $Obj) (then)
		N=at
	(else)
		N=an
	(endif)
	natta ḫarkun. %% "I did not hold it."

(prevent [[put $Obj $Dest] $Details])
	~(holder $Dest)
	(describe failed action [[put $Obj $Dest] $Details])
	(div @error) { Spatial relations in Hittite are a complicated topic, and it's not clear what arrangement the scribe was envisioning between the (span @hittite) (#accusative $Obj) and the (span @hittite) (#dative $Dest). Whatever that arrangement was, it doesn't seem to have worked. }

(perform [[put $Obj $Dest] | $])
	(now) ($Obj is #in $Dest) %% TODO always #in?
	(now) (update needed)

#v-put
%% (verb *) %% See above re ordering
(name *) tēḫḫun

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% SLAY
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

(verb @kuenun/@slay means @kuenun)

(@kuenun wants cases [#adverb #accusative]) (avoid ablative case) %% Allow no ablatives when they haven't been taught yet

(@kuenun wants cases [#adverb #accusative #ablative]) %% needs =kkan

(translate [$ kuenun $ $Acc $ $Abl] into [slay $Acc with $Abl])

%% Kuenun and taruḫḫun are mostly synonyms, but take different particles
(refuse [[slay $ with $] [$ @kuenun $Advs | $]])
	~(@kan is one of $Advs)
	(div @error) { This sentence is likely a scribal error. The verb (span @hittite) kuenun "slay" requires the sentence particle =kan to be attached to the first word of the sentence, as in (span @hittite) { n=an=kan kuenun } "I slew him". }
(refuse [[slay $ with $] [$ @taruḫḫun $Advs | $]])
	~(@za is one of $Advs)
	(div @error) { This sentence is likely a scribal error. The verb (span @hittite) taruḫḫun , when it's used to mean "overpower \(a person\)", needs the clitic =za attached to the first word of the sentence, as in (span @hittite) { nu=za=an taruḫḫun } "I overpowered him". }

(prevent [[slay ~(animate $Obj) with $Tool] $Details])
	(describe negative action [[slay $Obj with $Tool] $Details]) %% negative, not failed: "did not" instead of "could not"
	(if) (neuter $Obj) (then)
		N=at
	(else)
		N=aš
	(endif)
	antuḫšaš natta ēšta. %% It was not a person.

(prevent [[slay $Target with $Obj] $Details])
	~(avoid ablative case)
	(current player $Player)
	~($Obj is #heldby $Player)
	(describe failed action [[slay $Target with $Obj] $Details])
	Nu (#accusative $Obj) natta ḫarkun. %% I did not hold the $Obj.

(perform [[slay $Obj with $] $]) %% Remove a person from the game; prevent this if someone should be un-slayable
	(now) ($Obj is nowhere)
	(now) (update needed)

#v-slay
(verb *)
(name *) =kan kuenun

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% EXTINGUISH and BURN
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

(verb @kištanunun/@extinguish means @kištanunun)
(@kištanunun wants cases [#accusative])
(translate [$ kištanunun $ $Acc | $] into [extinguish $Acc])

(prevent [[extinguish $Obj] $Details])
	~($Obj is filled with #fire)
	(describe negative action [[extinguish $Obj] $Details])
	(if) (neuter $Obj) (then)
		N=at
	(else)
		N=aš
	(endif)
	warān natta ēšta. %% It was not burning.

(prevent [[extinguish $] $])
	(when the player lacks access to #water)

(perform [[extinguish $Fire] $] without prefix)
	(player can access #water via $Water)
	(if) (item $Fire) (then)
		($Source = $Fire)
		($Dest = $Water)
	(elseif) (item $Water) (then)
		($Source = $Water)
		($Dest = $Fire)
	(else)
		(div @realerror) { ERROR: Neither fire source $Fire nor water source $Water is portable! }
		(stop)
	(endif)
	(try [[put $Source $Dest] [[] tēḫḫun [] $Source $Dest []]])

(instead of [[put $Source $Dest] $])
	{
		($Source is filled with #fire)
		($Dest is filled with #water)
		Nu (#accusative $Source) (#dative #water) tēḫḫun. %% "I put the SRC in the water."
		($Fire = $Source)
		($Water = $Dest)
	(or)
		($Source is filled with #water)
		($Dest is filled with #fire)
		Nu (#accusative #water) (#dative $Dest) tēḫḫun. %% "I put water on the DEST."
		($Water = $Source)
		($Fire = $Dest)
	}
	Nu (#accusative #fire) kištanunun. %% "I extinguished the fire."
	(now) ~($Fire is filled with $)
	(if) (item $Water) (then) (now) ~($Water is filled with $) (endif) %% Only portable sources are exhausted when used this way
	(now) (update needed)

(verb @lukkun/@burn means @lukkun)
(@lukkun wants cases [#accusative])
(translate [$ lukkun $ $Acc | $] into [burn $Acc])

(prevent [[burn $Obj] $Details])
	~($Obj accepts substance #fire) %% Not flammable
	(describe failed action [[burn $Obj] $Details])

(prevent [[burn $] $])
	(when the player lacks access to #fire)

(perform [[burn $Wood] $] without prefix)
	(player can access #fire via $Fire)
	(if) (item $Wood) (then)
		($Source = $Wood)
		($Dest = $Fire)
	(elseif) (item $Fire) (then)
		($Source = $Fire)
		($Dest = $Wood)
	(else)
		(div @realerror) { ERROR: Neither fire source $Fire nor flammable $Wood is portable! }
		(stop)
	(endif)
	(try [[put $Source $Dest] [[] tēḫḫun [] $Source $Dest []]])

(instead of [[put $Source $Dest] $Details])
	{
		($Source is filled with #fire)
		($Dest accepts substance #fire)
		($Wood = $Dest)
	(or)
		($Source accepts substance #fire)
		($Dest is filled with #fire)
		($Wood = $Source)
	}
	(describe action [[put $Source $Dest] $Details])
	Nu (#accusative $Wood) lukkun.
	(now) ($Wood is filled with #fire)
	(now) (update needed)

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% WEAR
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

(verb @waššiyanun/@wear means @waššiyanun)
(@waššiyanun wants cases [#accusative])
(translate [$ waššiyanun $ $Acc | $] into [wear $Acc])

(interface (clothing $))
(prevent [[wear ~(clothing $Obj)] $Details])
	(describe failed action [[wear $Obj] $Details]) %% "I could not wear the X."

(prevent [[wear $Obj] $Details])
	(current player $Player)
	($Obj is #wornby $Player)
	(describe failed action [[wear $Obj] $Details])
	(if) (neuter $Obj) (then)
		N=at
	(else)
		N=an
	(endif)
	karū waššiyanun. %% "I already wore it."

(prevent [[wear $Obj] $Details])
	(current player $Player)
	~($Obj has ancestor $Player)
	(describe failed action [[wear $Obj] $Details])
	(if) (neuter $Obj) (then)
		N=at
	(else)
		N=an
	(endif)
	natta ḫarkun. %% "I did not hold it."

(perform [[wear $Obj] $])
	(current player $Player)
	(now) ($Obj is #wornby $Player)
	(now) (update needed)

#v-wear
(verb *)
(name *) waššiyanun

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% WAIT
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

(verb @ḫuškanun/@wait means @ḫuškanun)
(@ḫuškanun wants cases [])
(translate [$ ḫuškanun | $] into [wait])

(perform [[wait] $])
	%% Do nothing

(wait) %% For use in the number routines above
	(par) (try [[wait] [[ḫuškanun] ḫuškanun [] [] [] []]])

#v-wait
(verb *)
(name *) ḫuškanun

(unlock wait on the compass rose)
	(verb * unlocked)
	~(in debugger) %% Looks bad in the compass rose

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% CHOP
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

(verb @arkaḫḫun/@cut means @arkaḫḫun)
(@arkaḫḫun wants cases [#accusative #ablative])
(translate [$ arkaḫḫun $ $Acc $ $Abl] into [slay $Acc with $Abl])
	(animate $Acc) (sharp $Abl)
(translate [$ arkaḫḫun $ $Acc $ $Abl] into [cut $Acc with $Abl])

(prevent [[cut $Acc with $Abl] $Details])
	~(sharp $Abl)
	(describe failed action [[cut $Acc with $Abl] $Details])
	Nu (#nominative $Abl) GIR₂ natta ēšta. %% The ABL was not a knife.

%% In case of a weird CUT KNIFE WITH KNIFE thing
(prevent [[cut $Acc with $Abl] $Details])
	(sharp $Acc)
	(describe failed action [[cut $Acc with $Abl] $Details])

(perform [[cut $ with $] $])
	%% Do nothing by default - override for food items that can get cut
	%% By default it just says "you cut it" with no mechanical effect

(sharp $) (fail) %% Must exist in an act for this verb to be useful

#v-cut
(verb *)
(name *) arkaḫḫun

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% WASH
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

(verb @warpun/@wash means @warpun)
(@warpun wants cases [#accusative #ablative])
(translate [$ warpun $ $Acc $ $Abl] into [wash $Acc with $Abl])

(prevent [[wash $Acc with $Abl] $Details])
	~($Abl is filled with #water)
	(describe failed action [[wash $Acc with $Abl] $Details])
	Nu (#nominative $Abl) (#nominative #water) natta ēšta. %% The X was not water.

(perform [[wash $ with $] $])
	%% Nothing special happens, it just works
	%% See act2.dg for one place where this is useful

#v-wash
(verb *)
(name *) warpun

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% SIGNALS: KISS, DANCE, BOW
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%% These are only relevant in act 3
(interface (signal $>Verb))
(interface ($<Verb matches $<Action))
(interface (possible signal verb $>Verb))
(interface ($<Verb wants $>Case))

(verb @kuwaššun/@kiss means @kuwaššun)
(@kuwaššun wants cases [#accusative])
(translate [$ kuwaššun $ $Acc | $] into [kiss $Acc])

(prevent [[kiss ~(animate $Obj)] $Details])
	(describe negative action [[kiss $Obj] $Details]) %% negative, not failed: "did not" instead of "could not"
	(if) (neuter $Obj) (then)
		N=at
	(else)
		N=aš
	(endif)
	antuḫšaš natta ēšta. %% It was not a person.

(perform [[kiss $Obj] $Details] without prefix) %% Default perform just fails
	(describe negative action [[kiss $Obj] $Details])
	(div @error) { It is unclear why the text feels the need to specify that the protagonist did not do such an unlikely thing. }
	(tick) (stop)

#v-kiss
(verb *)
(name *) kuwaššun
(signal *) kuwašzi
(* matches [kiss $])
(* wants #accusative)
(possible signal verb *)

(verb @tarkun/@dance means @tarkun)
(@tarkun wants cases [#dative])
(translate [$ tarkun $ $ $Dat | $] into [dance with $Dat])

(prevent [[dance with ~(animate $Obj)] $Details])
	(describe negative action [[dance with $Obj] $Details]) %% negative, not failed: "did not" instead of "could not"
	(if) (neuter $Obj) (then)
		N=at
	(else)
		N=aš
	(endif)
	antuḫšaš natta ēšta. %% It was not a person.

(perform [[dance with $Obj] $Details] without prefix) %% Default perform just fails
	(describe negative action [[dance with $Obj] $Details])
	(div @error) { It is unclear why the text feels the need to specify that the protagonist did not do such an unlikely thing. }
	(tick) (stop)

#v-dance
(verb *)
(name *) tarkun
(signal *) tarkuzzi
(* matches [dance with $])
(* wants #dative)
(possible signal verb *)

(verb @kaninanun/@bow means @kaninanun)
(@kaninanun wants cases [#dative])
(translate [$ kaninanun $ $ $Dat | $] into [bow to $Dat])

(prevent [[bow to ~(animate $Obj)] $Details])
	(describe negative action [[bow to $Obj] $Details]) %% negative, not failed: "did not" instead of "could not"
	(if) (neuter $Obj) (then)
		N=at
	(else)
		N=aš
	(endif)
	antuḫšaš natta ēšta. %% It was not a person.

(perform [[bow to $Obj] $Details] without prefix) %% Default perform just fails
	(describe negative action [[bow to $Obj] $Details])
	(div @error) { It is unclear why the text feels the need to specify that the protagonist did not do such an unlikely thing. }
	(tick) (stop)

#v-bow
