%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Miscellaneous verbs used in the text
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

(third person verb @ēšta/@ešer)

(verb @ešun/@be means @ešun)
(@ešun wants cases [#dative])
(@ešun wants cases [#accusative #dative]) %% =za is usually [#accusative #reflexive]
(@ešun wants cases [#accusative]) %% in case of incomplete sentence
(translate [$ ešun | $] into [be])
(prevent [[be] $])
	(div @error) {
		It is unclear why this sentence was included. In this context, we expect a description of what the narrator was doing, rather than just where he was.
	}

(verb @taruḫḫun/@can means @taruḫḫun)
(@taruḫḫun wants cases [#adverb #accusative]) (avoid ablative case)
(@taruḫḫun wants cases [#adverb #accusative #ablative]) ~(avoid ablative case)
(translate [$ taruḫḫun $ $Acc $ $Abl] into [slay $Acc with $Abl]) %% On its own, make it a synonym for "slay"

(adverb @taruḫḫun/@can means @taruḫḫun) %% Triggers an error in parser.dg

(verb @ḫarkun/@hold means @ḫarkun)
(@ḫarkun wants cases [#accusative])
(translate [$ ḫarkun $ $Acc | $] into [hold $Acc])

(instead of [[hold $Obj] [$Raw | $]]) %% Reinterpret as TAKE if not held
	(current player $Player)
	~($Obj is #heldby $Player)
	(try [[take $Obj] [$Raw dāḫḫun [] $Obj [] []]])

(perform [[hold $] $]) %% If already held, no special behavior: "I held it" is fine

(verb @ḫašḫun/@open means @ḫašḫun)
(@ḫašḫun wants cases [#accusative])
(translate [$ ḫašḫun $ $Acc | $] into [open $Acc])

(prevent [[open $Obj] $Details]) %% Just fail with default message; anything in this game that is openable gets opened automatically with no action required
	(describe failed action [[open $Obj] $Details])

(verb @aggaḫḫun/@die means @aggaḫḫun)
(@aggaḫḫun wants cases [])
(translate [$ aggaḫḫun | $] into [die])

(perform [die] without prefix)
	(death ensues)

(death ensues) %% Note: call this in (perform $) rules ideally, not (on every tick) unless you're prepared to deal with the consequences
	Nu aggaḫḫun.
	(div @error) {
		The text must be corrupt at this point, as the hero must survive to continue the story. Ignoring the last few lines, we continue on...
	}
	(stop)

(verb @punuššun/@question means @punuššun)
(@punuššun wants cases [#accusative #dative]) %% Dative is irrelevant but allowed
(@punuššun wants cases [#accusative])
(translate [$ punuššun $ $Acc | $] into [question $Acc])

(prevent [[question ~(animate $Obj)] $Details])
	(describe negative action [[question $Obj] $Details]) %% negative, not failed: "did not" instead of "could not"
	(if) (neuter $Obj) (then)
		N=at
	(else)
		N=aš
	(endif)
	antuḫšaš natta ēšta. %% It was not a person.

%% No default perform rule - the default one in worldmodel.dg will produce a contradiction and a message confused about that contradiction, which seems like a reasonable behavior for this weird action

#v-question
(verb *)
(name *) punuššun
%% TODO - should this appear at all? It's never helpful

(verb @paršun/@flee means @paršun) %% Synonym for "go"
(@paršun wants cases [#dative])
(translate [$ paršun $ $ $Dat | $] into [go $Dat])
