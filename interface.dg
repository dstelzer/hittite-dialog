%% Style definitions and related predicates go here

%% Akkadograms
(style class @akk)
	font-style: italic;

%% Tutorial
(style class @tutorial)
	color: cyan;
	margin-top: 1em;
	margin-bottom: 1em;
	language: en;

%% "Errors" in the player's input
(style class @error)
	color: yellow;
	language: en;

%% Actual errors in the game's programming
(style class @realerror)
	color: red;
	font-weight: bold;
	language: en;

(style class @status)
	background-color: black;

%% Emphasis
(style class @italic)
	font-style: italic;
	aria-role: emphasis;
(style class @emphemph)
	font-style: normal;
	aria-role: emphasis;
(emph $Closure)
	(if) (currently italic) (then)
		(now) ~(currently italic)
		(span @emphemph) (query $Closure)
		(now) (currently italic)
	(else)
		(now) (currently italic)
		(span @italic) (query $Closure)
		(now) ~(currently italic)
	(endif)
