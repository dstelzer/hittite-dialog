%% Metadata

(story title) Ḫattušumna Laḫḫa \( Hittite Adventure \)
(story ifid) 58715A25-1E91-4BAC-ACED-F1E534F9C33D
(story author) Daniel Stelzer, Tim Leonard, and Daniel Gaskell
(story release 0)

%% Style definitions and related predicates go here
%% See also platform_*.dg

%% Akkadograms
(style class @akk)
	font-style: italic;
	text-transform: uppercase;

%% Styling for determiners needs to be handled in the interpreter CSS, since it needs to be superscript only in transcription, not in cuneiform
%% So this is an empty style class
(style class @dtm)

%% TODO keep this from interfering with parsing
(interface (dtm $<Closure))
(dtm $Closure) %% Make sure of no space on the right
	(span @dtm) { (query $Closure) (no space) } (no space)
	(if) ~(superscripts supported) (then) ^ (no space) (endif)
(interface (dtm2 $<Closure))
(dtm2 $Closure) %% For determiners on the right side
	(if) ~(superscripts supported) (then) (no space) ^ (endif)
	(no space) (span @dtm) { (no space) (query $Closure) }

%% "Errors" in the player's input
(style class @error)
	data-language: en;

%% Meta messages
(style class @meta)
	data-language: en;
	font-family: sans-serif;

%% Actual errors in the game's programming
(style class @realerror)
	color: red;
	font-weight: bold;
	data-language: en;

(style class @hittite)
	data-language: ht;

%% Rarely but occasionally needed
(style class @bold)
	font-weight: bold;
	aria-role: strong;

%% Title
(style class @title)
	data-language: ht;
	text-transform: uppercase;
	font-weight: bold;
	aria-role: strong;

%% Emphasis
(style class @italic)
	font-style: italic;
	aria-role: emphasis;
(style class @emphemph)
	font-style: normal;
	aria-role: emphasis;
(emph $Closure)
	(if) (currently italic) (then)
		(now) ~(currently italic)
		(span @emphemph) (query $Closure)
		(now) (currently italic)
	(else)
		(now) (currently italic)
		(span @italic) (query $Closure)
		(now) ~(currently italic)
	(endif)
