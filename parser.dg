(extension version)
	(line) Hittite parser version 0.6.

(parser logging) (fail)

(parser log $Closure)
	(parser logging)
	(log) (query $Closure)
(parser log $) %% Always succeed

%% Rewrite predicate: take the verb from the end of the sentence and move it to the front, then take clitics in Wackernagel position (attached to the first word) and make them a separate object

(rewrite $Input into $Output) %% Input: [na = an witeni dahhun]
	(parser log {Rewriting})
	(parser log { Input: $Input } )
	(convert $Input into normalized transcription $One) %% One: [na = an witeni daḫḫun]
	(parser log { One: $One } )
	(apply optional replacements to $One into $OnePointFive) %% Try to fix invalid words if possible; does nothing to already-valid words
	(parser log { 1.5: $OnePointFive } )
	(separate clitics from $OnePointFive into $Two) %% Two: [[an] witeni dahhun]
	(parser log { Two: $Two } )
	(transpose verb from $Two into $Three) %% Three: [dahhun an witeni]
	(parser log { Three: $Three } )
	(purify verb from $Three into $Output) %% Output: [daḫḫun an witeni]
	(parser log { Output: $Output } )

%% This block of code should be discarded once we can handle it in the frontend, it's horribly inefficient to do this kind of text processing in Dialog itself
(convert [] into normalized transcription [])
(convert [$Head | $Tail] into normalized transcription [$NewHead | $NewTail])
	(convert single word $Head into normalized transcription $NewHead)
	(convert $Tail into normalized transcription $NewTail)

(convert single word $Old into normalized transcription $New)
	(split word $Old into $OldLetters)
	(convert letters $OldLetters into $NewLetters)
	(join words $NewLetters into $New)

(convert letters [] into [])
(convert letters [$Head | $Tail] into [$NewHead | $NewTail])
	(replace letter $Head with $NewHead)
	(convert letters $Tail into $NewTail)

(replace letter @c with @š)
(replace letter @h with @ḫ)
(replace letter @j with @ŋ) %% Does this ever come up?
(replace letter @⸗ with @=) %% Note that either both of these must be word separators, or neither must be!
(replace letter $X with $X) %% Everything else gets passed through

%% Likewise this one, which is even worse optimization-wise
(apply optional replacements to [] into [])
(apply optional replacements to [$Head | $Tail] into [$NewHead | $NewTail])
	(unknown word $Head) %% Don't try optional replacements if a word is already valid (TODO: does this ever make false positives?)
	(optional replacements turn $Head into valid word $NewHead)
	(apply optional replacements to $Tail into $NewTail)
(apply optional replacements to [$Head | $Tail] into [$Head | $NewTail])
	%% If it's not an unknown word, or it is but none of the substitutions worked, just pass it along and let the parser errors handle it
	(apply optional replacements to $Tail into $NewTail)

(optional replacements turn $Old into valid word $New)
	(split word $Old into $Letters)
	*(do optional letter replacements on $Letters into $NewLetters)
	(join words $NewLetters into $New)
	~(unknown word $New)
(do optional letter replacements on [] into [])
(do optional letter replacements on [$Head|$Tail] into [$NewHead|$NewTail])
	*(optionally replace $Head with $NewHead)
	*(do optional letter replacements on $Tail into $NewTail)

(optionally replace $X with $X) %% "No change" is always valid and should be the first default
(optionally replace @s with @š) %% Make this optional since the distinction could possibly matter: SU 'entrails' vs ŠU 'hand'. But proper S is rare.
(optionally replace @a with @ā) %% Likewise this could matter but usually doesn't
(optionally replace @e with @ē)
(optionally replace @i with @ī)
(optionally replace @o with @ō)
(optionally replace @u with @ū)
(optionally replace @u with @o) %% Since the output system replaces our phonemic transcription with standard bound transcription, people will be seeing U in the output, so they're likely to type it too
(optionally replace @u with @ō)

%% Sentence connectives can be discarded
(separate clitics from [(sentence connective $First) | $Rest] into [$Clitics | $Sentence])
	(separate clitics internal from $Rest into $Clitics and $Sentence)

%% Otherwise we need to preserve the first word (e.g. a noun that's been topicalized)
(separate clitics from [$First | $Rest] into [$Clitics $First | $Sentence])
	(separate clitics internal from $Rest into $Clitics and $Sentence)

%% For the "internal" predicate, we take an equals sign as marking a clitic
(separate clitics internal from [= $Clitic | $Rest] into [$Clitic | $Others] and $Sentence)
	(separate clitics internal from $Rest into $Others and $Sentence)

%% Anything else means no more clitics, we're done
%% If any clitics appear *after* this point, they must have been attached to other words (like nouns), rather than the start of the sentence - and we ignore that sort of clitic entirely
(separate clitics internal from $Sentence into [] and $Purged)
	(purge all clitics from $Sentence into $Purged)

%% Take the last element (which should always be the verb) and move it to the front
(transpose verb from $Input into [$Verb | $Remaining])
	(split last element from $Input into $Verb and $Remaining)

%% Utility to enable this
(split last element from [$Last] into $Last and [])
(split last element from [$Head | $Tail] into $Last and [$Head | $NewTail])
	(split last element from $Tail into $Last and $NewTail)

%% Purifying verbs is the easy part
(purify verb from [$RawVerb | $Rest] into [$PureVerb | $Rest])
	(verb $RawVerb means $PureVerb)
(purify verb from $Unrecognized into $Unrecognized) %% If it's not a recognized verb, the error will be reported later; we don't have to deal with it now

%% Noun list parsing: Hittite sentences tend to go
%% Conn=Clitics [Noun phrases...] Verb
%% So this is to parse a sequence of noun phrases into something like
%% [ [#accusative #Obj1] [#dative #Obj2] ]

%% Get rid of any clitics in the middle of the noun phrase, such as the emphasizing =pát or the conjunction =ya
(purge all clitics from [] into [])
(purge all clitics from [= $ | $Rest] into $NewRest)
	(purge all clitics from $Rest into $NewRest)
(purge all clitics from [$Head | $Rest] into [$Head | $NewRest])
	(purge all clitics from $Rest into $NewRest)

%% At top level we want to allow [], but in the recursive case we don't
(parse top-level [] into noun list [])
(parse top-level $Words into noun list $Nouns)
	*(parse $Words into noun list $Nouns)

%% Base case: a single noun
(parse $Words into noun list [$Noun])
	*(parse $Words into single noun $Noun)

%% Recursive case: more than one noun
~(parse [] into noun list $)

(parse [ù/u3/& | $Rest] into noun list $Nouns) %% Handle explicit "and"s
	(parse $Rest into noun list $Nouns) %% =ya etc will be purged already

(parse $Words into noun list $Nouns)
	*(split $Words anywhere into $Left and $Right)
	*(parse $Left into single noun $Single)
	*(parse $Right into noun list [$First | $Other]) %% We split off $First to make sure we're not breaking a single noun phrase in half, but this also guarantees that the right noun list is nonempty
	~($Single = $First) %% Make sure not to split in the middle of a noun phrase!
	($Nouns = [$Single $First | $Other])

%% We can't report errors from within (parse $ into noun list $) because the (collect $) block will exhaust the entire search tree, which includes the reporting. So we have a separate error-reporting predicate with the same logic that prints an error on the first failure, and uses only a single query.
(find first broken noun from [] and report it)
	(div @realerror) { ERROR: failed to find any broken nouns! }
(find first broken noun from [$First | $] and report it)
	(verb $First means $)
	This sentence's structure is unclear: (span @hittite) $First is a verb, and the verb should always be the last word in a Hittite sentence.
	(stop)
(find first broken noun from $Nouns and report it)
	{
		*(split $Nouns anywhere into $Left and $Right)
		(nonempty $Left) %% Forbid the split where everything is on the right
	(or)
		($Left = $Nouns) ($Right = []) %% We also want to allow a "split" where everything is on the left and nothing is on the right
	}
	(parser log { Split: $Left $Right } )
	{
		*(parse $Left into single noun $)
		(find first broken noun from $Right and report it)
	(or)
		*(parse $Left as invalid case $Case of $)
		"(no space)(uppercase)(print words $Left)(no space)" is likely a scribal error; this is a valid noun, but the (name $Case) case doesn't make sense in this context.
		(stop)
	(or)
		*(parse $Left as not-here object $)
		It's unclear what (print quoted $Left) is meant to refer to;
		(if) ($Left = [$]) (then) %% Single word
			this noun (emph {is}) used on the tablet, but what it describes
		(else)
			these words (emph {are}) used on the tablet, but what they describe
		(endif)
		is not currently near our protagonist.
		(stop)
	(or)
		The nouns in this line are obscure, and it's unclear what (print quoted $Left) means.
		(stop)
	}

%% Now how do we recognize a single noun?
~(parse [] into single noun $)

(parse $Words into single noun $Noun)
	*(parser case $Case)
	*(parse $Words as $Case $Obj)
	($Noun = [$Case $Obj])

#nominative
(grammatical case *) %% Only used in printing, not parsing
(name *) nominative

#genitive
(grammatical case *) %% Only used in printing, not parsing
(name *) genitive

#accusative
(grammatical case *)
(parser case *)
(name *) accusative

#dative
(grammatical case *)
(parser case *)
(name *) dative/locative

#ablative
(grammatical case *)
(parser case *)
(name *) ablative/instrumental

#adverb
(grammatical case *)
(parser case *)
%% This one has no name

#bare %% Stem form, for use with Akkadian prepositions
(grammatical case *) %% Only used in printing, not parsing
(name *) bare stem

%% We include adverbs in the noun list, with the tag #adverb, because they can be interspersed with noun phrases
%% This also includes sentence particles like =kán and preverbs like anda
%% However, they shouldn't be printed like nouns (i.e. with conjunctions between them)
(parse [$Word] as #adverb $Meaning)
	(just) (adverb $Word means $Meaning)
~(name (object $) in #adverb) %% This is only for dictionary words, not objects
(name [] in #adverb)
(name (word $Word) in #adverb)
	$Word
(name (nonempty $List) in #adverb)
	(exhaust) { *($Word is one of $List) (name $Word in #adverb) }

(parse [ana/ina/pani | $Words] as #dative $Obj)
	{
		(parse $Words as #bare $Obj)
	(or)
		(parse $Words as #dative $Obj)
	}

(parse [ištu/itti/qadu | $Words] as #ablative $Obj)
	{
		(parse $Words as #bare $Obj)
	(or)
		(parse $Words as #ablative $Obj)
	}

~(parse [] as $ $) %% Avoid edge cases - require a single word at least
(parse $Words as $Case $Obj)
	(determine object $Obj)
		*($Obj is in scope)
	(from words)
		*(dict $Obj in $Case)
	(matching all of $Words)

(parse $Words as invalid case $Case of $Obj)
	*(grammatical case $Case)
	~(parser case $Case)
	(determine object $Obj)
		*($Obj is in scope)
	(from words)
		*(dict $Obj in $Case)
	(matching all of $Words)

(parse $Words as not-here object $Obj)
	*(parser case $Case)
	(determine object $Obj)
		*(object $Obj)
		~($Obj is in scope)
	(from words)
		*(dict $Obj in $Case)
	(matching all of $Words)

%% Our representation of a complex action is [verb [adv] [acc] [dat] [abl]] (eventually with the raw wording preposed), so now we need to convert a noun list into that
(empty action with verb $Verb is [$Verb [] [] [] []])

%% Noun phrases

(add noun phrases [] to action $Act into $Act)

(add noun phrases [[#adverb $Adv] | $Rest] to action [$Verb $Advs $Acc $Dat $Abl] into $Out)
	(add noun phrases $Rest to action [$Verb [$Adv|$Advs] $Acc $Dat $Abl] into $Out)

(add noun phrases [[#accusative/#bare $Acc] | $Rest] to action [$Verb $Adv $Accs $Dat $Abl] into $Out)
	(add noun phrases $Rest to action [$Verb $Adv [$Acc|$Accs] $Dat $Abl] into $Out)

(add noun phrases [[#dative $Dat] | $Rest] to action [$Verb $Adv $Acc $Dats $Abl] into $Out) %% Don't consider bare nouns as datives, it has too many false positives
	(add noun phrases $Rest to action [$Verb $Adv $Acc [$Dat|$Dats] $Abl] into $Out)

(add noun phrases [[#ablative $Abl] | $Rest] to action [$Verb $Adv $Acc $Dat $Abls] into $Out) %% Don't consider bare nouns as ablatives, it has too many false positives
	(add noun phrases $Rest to action [$Verb $Adv $Acc $Dat [$Abl|$Abls]] into $Out)

%% Silence compiler warnings
(interface (pronoun $<Word)) %% Not currently used

#1s
(pronoun *)

#2s
(pronoun *)

#3sc
(pronoun *)

#3sn
(pronoun *)

#1p
(pronoun *)

#2p
(pronoun *)

#3pc
(pronoun *)

#3pn
(pronoun *)

#reflexive
(pronoun *)

%% Change some of these to variables or whatever eventually TODO
(first person singular #1s)
(second person singular #2s)
(third person singular common #3sc)
(third person singular neuter #3sn)
(third person singular $Which)
	*(third person singular common $Which) (or) *(third person singular neuter $Which)
(first person plural #1p)
(second person plural #2p)
(third person plural common #3pc)
(third person plural neuter #3pn)
(third person plural $Which)
	*(third person plural common $Which) (or) *(third person plural neuter $Which)
(reflexive #reflexive)

(sentence particle @kan)

%% Clitics
(convert clitic @mu into noun phrase [#accusative (first person singular $)])
(convert clitic @mu into noun phrase [#dative (first person singular $)])
(convert clitic @naš into noun phrase [#accusative (first person plural $)])
(convert clitic @naš into noun phrase [#dative (first person plural $)])

(convert clitic @ta/@du into noun phrase [#accusative (second person singular $)])
(convert clitic @ta/@du into noun phrase [#dative (second person singular $)])
(convert clitic @šmaš into noun phrase [#accusative (second person plural $)])
(convert clitic @šmaš into noun phrase [#dative (second person plural $)])

(convert clitic @šmaš into noun phrase [#dative (third person plural $)])
(convert clitic @ši into noun phrase [#dative (third person singular $)])
(convert clitic @an into noun phrase [#accusative (third person singular common $)])
(convert clitic @at into noun phrase [#accusative (third person singular neuter $)])
(convert clitic @at into noun phrase [#accusative (third person plural neuter $)])
(convert clitic @e/@i into noun phrase [#accusative (third person plural neuter $)])
(convert clitic @uš/@aš into noun phrase [#accusative (third person plural common $)])

(convert clitic @z/@za into noun phrase [#accusative (reflexive $)])
(convert clitic @z/@za into noun phrase [#dative (reflexive $)])

(convert clitic (sentence particle $Part) into noun phrase [#adverb $Part]) %% Sentence particles work kind of like adverbs, so we deal with them there

(convert clitic @wa/@war into noun phrase [#adverb @war]) %% Causes an error if it appears

(interface (convert clitics $<Input into noun phrase list $>Output))
(convert clitics [] into noun phrase list [])
(convert clitics [$First|$Rest] into noun phrase list [$NewFirst|$NewRest])
	*(convert clitic $First into noun phrase $NewFirst)
	*(convert clitics $Rest into noun phrase list $NewRest)

%% We can't report this from within (convert clitics $ into noun phrases $) because the (collect $) block will exhaust the entire search tree, which includes the reporting. So we have a separate error-reporting predicate with the same logic that prints an error on the first failure, and uses only a single query.
(find first broken clitic from $Clitics and report it)
	*($This is one of $Clitics)
	~(convert clitic $This into noun phrase $)
	The clitic $This is not found elsewhere on the tablet. Its interpretation is unclear.
	(stop)

(interface (deduplicate $<Input into $>Output))
%% Remove duplicates in case they appear
(deduplicate [$Verb $Advs $Accs $Dats $Abls] into [$Verb $NewAdvs $NewAccs $NewDats $NewAbls])
	(remove duplicates from $Advs into $NewAdvs)
	(remove duplicates from $Accs into $NewAccs)
	(remove duplicates from $Dats into $NewDats)
	(remove duplicates from $Abls into $NewAbls)

(interface (convert parsed line $<Input from raw $<Raw into $>Output))
%% Now put it together
(convert parsed line [$Verb $Clitics | $Nouns] from raw $Raw into [$Raw | $Action])
	(empty action with verb $Verb is $First)
	*(add noun phrases $Nouns to action $First into $Second)
	*(convert clitics $Clitics into noun phrase list $ExtraNouns)
	*(add noun phrases $ExtraNouns to action $Second into $Third)
	(deduplicate $Third into $Action)

%% A couple special rules for predictable grammatical cases
(name (neuter $Obj) in #accusative)
	(name $Obj in #nominative)
(dict (neuter $Obj) in #accusative)
	*(dict $Obj in #nominative)
(dict $Obj in $Case)
	($Case $Obj)

(sentence connective @nu)
(sentence connective @na) %% Form that's used before clitics starting with /a/
(sentence connective @n) %% Some people transcribe n=an instead of na=an

%% Utilities

(listing [] $ $ 0)
	nothing
(listing [$Head | $Rest] $PrintClosure $Conjunction $NPrinted)
	(if) (empty $Rest) ~($Conjunction = @,) (then)
		(if) ($NPrinted > 1) (then) , (endif)
		(if) ($NPrinted > 0) (then) $Conjunction (endif)
	(else)
		(if) ($NPrinted > 0) (then) , (endif)
	(endif)
	(query $PrintClosure $Head)
	($NPrinted plus 1 into $NPp1)
	(if) (nonempty $Rest) (then)
		(listing $Rest $PrintClosure $Conjunction $NPp1)
	(endif)

(listing $List $Closure $Conjunction) %% Convenience predicates
	(listing $List $Closure $Conjunction 0)
(listing $List $Closure)
	(listing $List $Closure @and)

%% Now, the parser!

(valid sentence [$ $Verb | $Nouns])
	*($Verb wants cases $Cases)
	~(noun list $Nouns and case list $Cases produce error $)

(show parser errors for [$Raw $Verb | $Nouns])
	*($Verb wants cases $Cases)
	%% Collect all the errors that happen in this particular instance
	(collect $Error)
		*(noun list $Nouns and case list $Cases produce error $Error)
	(into $ErrorList)
	%% If we're displaying errors, and we *have* errors, we should show them first
	(show parser errors $ErrorList for action [$Raw $Verb | $Nouns])

%% Error codes:
%%
%%	11	Missing adverb
%%	21	Excess adverb (currently not raised - excess adverbs are just ignored)
%%	12	Missing accusative
%%	22	Excess accusative
%%	13	Missing dative
%%	23	Excess dative
%%	14	Missing ablative
%%	24	Excess ablative
%%
%%	31	Should not have quotative =wa(r)
%%	36	Too many multiple objects

(noun list [$Adv $ $ $] and case list $Cases produce error 11)
	(empty $Adv)
	(#adverb is one of $Cases)
%% We do *not* check for excess adverbs at the moment, but that would be error 21 if we did
(noun list [$ $Acc $ $] and case list $Cases produce error 12)
	(empty $Acc)
	(#accusative is one of $Cases)
(noun list [$ $Acc $ $] and case list $Cases produce error 22)
	(nonempty $Acc)
	~(#accusative is one of $Cases)
(noun list [$ $ $Dat $] and case list $Cases produce error 13)
	(empty $Dat)
	(#dative is one of $Cases)
(noun list [$ $ $Dat $] and case list $Cases produce error 23)
	(nonempty $Dat)
	~(#dative is one of $Cases)
(noun list [$ $ $ $Abl] and case list $Cases produce error 14)
	(empty $Abl)
	(#ablative is one of $Cases)
(noun list [$ $ $ $Abl] and case list $Cases produce error 24)
	(nonempty $Abl)
	~(#ablative is one of $Cases)

(noun list [$Adv $ $ $] and case list $ produce error 31)
	(@war is one of $Adv)

(noun list [$|$Nouns] and case list $ produce error 36)
	%% Check if there are multiple nouns in multiple cases - we only want to deal with a single multiple object list at a time, to avoid combinatorics
	%% (Adverbs don't count for this)
	(accumulate 1)
		*($Case is one of $Nouns)
		(more than one $Case)
	(into $Count)
	($Count > 1)

(more than one [$ $ | $]) %% Succeeds if the argument is a list with more than one element

(show parser errors [] for action $)
	(div @realerror) { ERROR: there's an error, but no error code was returned! }
(show parser errors [$Single] for action [$Raw | $Action])
	This sentence, (print quoted $Raw), is difficult to interpret.
	(uppercase) (show parser error $Single for action [$Raw | $Action]).
(show parser errors [$A $B] for action [$Raw $Verb | $]) %% Exactly two errors might be a noun in the wrong case
	{
		($A is one of [12 13 14])
		($B is one of [22 23 24])
		($A modulo 10 into $Missing)
		($B modulo 10 into $Excess)
	(or)
		($A is one of [22 23 24])
		($B is one of [12 13 14])
		($A modulo 10 into $Excess)
		($B modulo 10 into $Missing)
	}
	This sentence, (print quoted $Raw), is likely a scribal error: the verb $Verb expects a noun in the (case of error $Missing), not the (case of error $Excess) .
(show parser errors $List for action [$Raw | $Action])
	This sentence, $Raw, is difficult to interpret, for multiple reasons.
	(uppercase) (listing $List {(show parser error $_ for action [$Raw | $Action])}).

(case of error 2) accusative
(case of error 3) dative
(case of error 4) ablative
(case of error $N) ERR: $N

(show parser error 11 for action $)
	there should be an adverb or sentence particle
(show parser error 21 for action $)
	there should not be an adverb or sentence particle
(show parser error 12 for action $)
	there should be an accusative noun
(show parser error 22 for action $)
	there should not be an accusative noun
(show parser error 13 for action $)
	there should be a dative noun
(show parser error 23 for action $)
	there should not be a dative noun
(show parser error 14 for action $)
	there should be an ablative noun
(show parser error 24 for action $)
	there should not be an ablative noun
(show parser error 31 for action $)
	the clitic =wa\(r\) marks a quotation \( which this sentence should not be \)
(show parser error 36 for action [$ $ $Acc $Dat $Abl])
	there are multiple nouns in
	(if) (more than one $Acc) (more than one $Dat) (more than one $Abl) (then)
		several different cases
	(elseif) (more than one $Acc) (more than one $Dat) (then)
		the accusative and dative cases
	(elseif) (more than one $Acc) (more than one $Abl) (then)
		the accusative and ablative cases
	(elseif) (more than one $Dat) (more than one $Abl) (then)
		the dative and ablative cases
	(else)
		ERROR: What cases??
	(endif)
(show parser error $Err for action $)
	ERROR: Error code $Err not recognized!

%% Main parser structure begins here

(global variable (previous command $)) %% For /again purposes

(parse commandline $Words)
	(if) ($Words = [$First | $]) (split word $First into [\/ | $]) (then) %% First word starts with `/` so it's an English metacommand
		(parse metacommand $Words)
		(stop)
	(else)
		(now) (previous command $Words)
	(endif)
	
	(if) (save undo 1) (then)
		(div @error) { The previous lines, starting with (print words $Words), are crossed out on the tablet and should be considered a scribal error. }
		(stop)
	(endif)
	
	(if) ($Words are direction list $Dirs) (then) %% Only IM, dots, and numbers
		(stoppable) (parse number list $Dirs)
		(stop)
	(endif)
	
	(now) ~(allowing parse errors)
	(parse action $Words)

([] are direction list [])
([(number $Head) | $Rest] are direction list [$Head | $NewRest])
	($Rest are direction list $NewRest)
([@im/@./@- | $Rest] are direction list $NewRest)
	($Rest are direction list $NewRest)

(parse metacommand [\/quit])
	~(interpreter supports quit)
	(div @meta) { To quit the game, close the browser tab or window. }
(parse metacommand [\/quit])
	(div @meta) { Thanks for playing! }
	(quit)

(parse metacommand [\/undo])
	~(interpreter supports undo)
	(div @meta) { Unfortunately, this interpreter does not support UNDO. }
(parse metacommand [\/undo])
	(undo)
	(div @realerror) { Undo failed! }

(parse metacommand [\/save])
	(if) (save $ComingBack) (then)
		(if) ($ComingBack = 0) (then)
			(div @meta) { Game state saved. Use /restore to come back to this point at any time. }
		(else)
			(div @meta) { Game state restored. }
		(endif)
	(else)
		(div @realerror) { Save failed! }
	(endif)

(parse metacommand [\/restore])
	(restore)
	(div @realerror) { Restore failed! }

(parse metacommand [\/again/\/g])
	(previous command $Words)
	(parse action $Words)
(parse metacommand [\/again/\/g])
	(div @realerror) { No previous command to repeat! }

(parse metacommand [\/help])
	TODO

(parse metacommand $Words)
	(div @meta) { The meta command (print quoted $Words) was not recognized. Try /help for more information. }

(interface (parse action $<Words))
(parse action $Words)
	($Raw = $Words)
	
	{
		(rewrite $Raw into [$Verb $Clitics | $Rest])
	(or)
		(report errors in $Raw) %% In case the above fails
		(stop) %% (report errors in $) will always (stop) but this helps the optimizer by reassuring it that $Verb, $Clitics, $Rest will always be bound by the previous branch
	}
	(parser log { Rewritten: $Verb $Clitics $Rest } )
	(if) ~($Verb wants cases $) (then) %% Not a recognized verb
		%% Is there a verb somewhere else in the sentence? That would mean the player messed up the sentence structure rather than using an invalid verb.
		(if) *($Alt is one of $Rest) (verb $Alt means $) (then)
			(div @error) {
				The structure of this sentence is unusual. "(no space)(uppercase)$Alt(no space)" is a verb, and the verb should always be at the end of a Hittite sentence.
			}
		(else)
			(div @error) {
				From its position in the sentence, we would expect "(no space)$Verb(no space)" to be the main verb. But this
				(if) (unknown word $Verb) (then)
					verb is not used for the protagonist's actions
				(else)
					word is not used as a verb
				(endif)
				elsewhere on the tablet, and it is difficult to interpret here.
			}
		(endif)
		(stop)
	(endif)
	(collect $Action)
		*(parse top-level $Rest into noun list $Nouns)
		(parser log { Noun list: $Nouns } )
		*(convert parsed line [$Verb $Clitics | $Nouns] from raw $Raw into $Action)
		(parser log { Considering: $Action } )
		(valid sentence $Action) %% Only include ones in the final result that don't cause parse errors
	(into $RawOptions)
	(parser log { Raw options: $RawOptions } )
	(remove duplicates from $RawOptions into $Options)
	(parser log { Options: $Options } )
	
	(if) ($Options = [$Only]) (then) %% Optimize the common case
		(parser log { Trying: $Only } )
		(try-complex $Only)
	(elseif) (empty $Options) (then) %% No successful parse, try to give a useful error
		(parser log { Running again to report errors } )
		(report errors in $Raw)
	(else)
		(parser log { Sieving } )
		(sieve action candidates $Options at level 0)
	(endif)

(report errors in $Words)
	(now) (allowing parse errors) %% Tell the parsing predicates that they should show their errors instead of just silently failing
	%% Multiqueries here are not really necessary because if-conditions discard choice points, but it helps optimization according to the stdlib comments
	(if)
		(rewrite $Words into [$Verb $Clitics | $Rest])
		(parser log {Reporting errors: Rewrote into $Verb $Clitics $Rest})
	(then)
	
		(if)
			*(parse top-level $Rest into noun list $Nouns)
			(parser log {Reporting errors: Got noun list $Nouns})
		(then)
		
			(if)
				*(convert parsed line [$Verb $Clitics | $Nouns] from raw $Words into $Action)
			(then)
			
				(parser log { Reporting errors: Parsed into action $Action, showing errors for that } )
				(div @error) (show parser errors for $Action)
				(stop)
			
			(elseif) (empty $Clitics) (then)
				(parser log { Reporting errors: Noun list worked, but no clitics?? } )
				(div @realerror) { Could not parse, unsure why! }
			
			(else)
				(parser log { Reporting errors: Reporting first broken clitic from $Clitics } )
				(div @error) (find first broken clitic from $Clitics and report it)
				(stop)
			(endif)
		
		(else)
			(parser log { Reporting errors: Reporting first broken noun from $Rest } )
			(div @error) (find first broken noun from $Rest and report it)
			(stop)
		(endif)
	
	(else)
		(parser log { Very high-level parsing failure } )
		(if) (empty $Words) (then)
			(stop)
		(else)
			(div @error) { This sentence seems to be incomplete. The tablet may be damaged at this point. }
		(endif)
		(stop)
	(endif)

(sieve action candidates [] at level $)
	(div @realerror) { Tried to sieve an empty list! } %% For safety
(sieve action candidates $All at level $Level) %% Level is how unlikely of actions we should consider
	(if) ($Level = 3) (then)
		($Options = $All)
	(else)
		(collect $A)
			*($A is one of $All)
			~(unlikely $A $Level)
		(into $Options)
	(endif)
	(if) (nonempty $Options) (then)
		(consider action candidates $Options)
	(else)
		($Level plus 1 into $Lp1)
		(sieve action candidates $All at level $Lp1)
	(endif)

(consider action candidates $List)
	(if) ($List = [$Only]) (then) %% Optimize the common case
		(try-complex $Only)
	(else)
		(length of $List into $N)
		(div @error) {
			This line could be interpreted in multiple ways:
			(enumerate possible actions $List 1)
			(line) It seems the intended interpretation is number...
		}
		(get input $Words)
		(if) ($Words = [$Number]) (number $Number) ($Number > 0) ~($Number > $N) (then)
			(nth $List $Number $Result)
			(try-complex $Result)
		(else)
			(div @error) {
				The previous concerns may be a scribal error. Ignoring that, we continue on to...
			}
			(now) (deferred commandline $Words)
			(stop)
		(endif)
	(endif)

(global variable (deferred commandline $))
(read-parse-act)
	(rebuild scope)
	(if) (deferred commandline $Words) (then)
		(now) ~(deferred commandline $)
		(stoppable) {
			(parse commandline $Words)
		}
		(par)
	(else)
		(redraw status bar)
		(tutorial)
		(prompt and input $Words)
		(stoppable) {
			(parse commandline $Words)
		}
		(par)
	(endif)

(prompt and input $Words)
	*(repeat forever)
	(line)
	> (get input $Words)
	~($Words = [\* | $]) %% Ignore lines starting with stars, for transcript comments

(redraw status bar)
	(update needed)
	(now) ~(update needed)
	(update description)
(redraw status bar) %% Don't fail

(unlikely $ $) (fail)

%% Action format: [[english version] [[raw words] verb [advs] acc dat abl]]
(describe action [$ [$ $Verb $Adv $Acc $Dat $Abl]])
	Nu
	(#accusative $Acc)
	(#dative $Dat)
	(#ablative $Abl)
	(#adverb $Adv)
	$Verb
	.
(describe action $Action)
	(span @realerror) { Improper action: $Action }
(describe failed action $Action)
	Nu (describe raw failed action $Action) .
(describe raw failed action [$ [$ $Verb $Adv $Acc $Dat $Abl]]) %% No connective, capital, or punctuation, for embedding in a larger context
	(#accusative $Acc)
	(#dative $Dat)
	(#ablative $Abl)
	(#adverb $Adv)
	natta %% Used in place of ŪL to avoid explaining heterograms too early
	taruḫḫun %% "able to" in asyndetic construction
	$Verb
(describe raw failed action $Action)
	(span @realerror) { Improper action: $Action }
(describe negative action [$ [$ $Verb $Adv $Acc $Dat $Abl]])
	Nu
	(#accusative $Acc)
	(#dative $Dat)
	(#ablative $Abl)
	(#adverb $Adv)
	natta
	$Verb
	.
(describe negative action $Action)
	(span @realerror) { Improper action: $Action }

(print words $Words)
	(exhaust) { *($Word is one of $Words) $Word }
(print quoted $Words)
	"(no space) (print words $Words) (no space)"

(enumerate possible actions [] $)
(enumerate possible actions [$Head|$Tail] $N)
	(line) (space 4) $N : (describe action [[unknown] $Head])
	($N plus 1 into $Np1)
	(enumerate possible actions $Tail $Np1)

%% If given [a [b c] d], this returns [a b d] and [a c d]
%% If given [[a b] [c d]], returns [a c] [a d] [b c] [b d] (in some order)
(expand groupings from [] into [])
(expand groupings from [$HeadIn|$TailIn] into [$HeadOut|$TailOut])
	(if) (nonempty $HeadIn) (then)
		*($HeadOut is one of $HeadIn)
	(else)
		($HeadOut = $HeadIn)
	(endif)
	*(expand groupings from $TailIn into $TailOut)

%% (try-complex $) will take an action with multiple nouns in a certain case and turn it into several individual actions with a single noun in that case
%% This actually works with any number of nouns in any number of cases; the parser just limits it to a single multiple object per action to avoid combinatorial headaches (PUT ALL ON ALL is unlikely to do anything good)
(try-complex [$Raw $Verb $Advs | $Nouns])
	*(expand groupings from $Nouns into $NounCombo)
	%% TODO: This should be (exhaust) but that breaks everything. Why?
	(if) (translate [$Raw $Verb $Advs | $NounCombo] into $EnglishAction) (then)
		(parser log { English action: $EnglishAction } )
		(parser log { (describe action [$EnglishAction [$Raw $Verb $Advs | $NounCombo]]) } )
		(try [$EnglishAction [$Raw $Verb $Advs | $NounCombo]])
		(tick)
	(else)
		(div @realerror) { ERROR: The Hittite sentence (print quoted $Raw) was parsed as $Verb, $Advs, and $NounCombo, but this could not be translated into an English action. Why not? }
	(endif)

%% (try $) then handles those single-noun actions
%% Implemented in worldmodel.dg

%% Replacement for (name $) for a cased language
($ [])
($Case [$Single])
	($Case $Single)
($Case [$Head | $Rest])
	($Case $Head)
	(span @akk) { Ù } %% Using the "Akkadian ampersand" instead of the clitic =ya because the clitic does messy things with the last consonant of the word
	(now) (heterograms used) %% Give a tutorial the first time this happens
	($Case $Rest)

(name (logogram $Obj) in #nominative/#accusative) (name $Obj in #bare)
(name (logogram $Obj) in #dative) (span @akk) ana (name $Obj in #bare)
(name (logogram $Obj) in #genitive) (span @akk) ša (name $Obj in #bare)
(name (logogram $Obj) in #ablative) (span @akk) ištu (name $Obj in #bare)

(interface ($<Case $<Obj))
($Case $Obj) %% Adds modifiers as needed; these can be objects, dict words, or closures
	(if) ($Obj has modifier $Mod) (then)
		(if) (object $Mod) (then)
			(#genitive $Mod)
		(elseif) (word $Mod) (then)
			$Mod
		(elseif) (nonempty $Mod) (then)
			(query $Mod)
		(endif)
	(endif)
	(name $Obj in $Case)
