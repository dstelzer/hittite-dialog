(extension version)
	(line) Hittite Parser version 0.1 by Daniel Stelzer

%% Rewrite predicate: take the verb from the end of the sentence and move it to the front, then take clitics in Wackernagel position (attached to the first word) and make them a separate object

(rewrite $Input into $Output)
	Input: $Input (line)
	(separate clitics from $Input into $Middle)
	Middle: $Middle (line)
	(transpose verb from $Middle into $Output)
	Output: $Output (line)

%% Separate clitics from the first word
(separate clitics from [$First | $Other] into $Out)
	($First splits into base $Base and clitic chain $Chain)
	(if) (sentence connective $Base) (then) %% No need to preserve sentence connectives
		($Out = [$Chain | $Other])
	(else)
		($Out = [$Chain $Base | $Other])
	(endif)

(separate clitics from $In into [[]|$In]) %% Fallback if that fails: empty clitic list

%% How do we know if something contains clitics?
($Word splits into base $Base and clitic chain $Chain)
	(split word $Word into $List)
	($List divides by letters into base $Base and clitic chain $Chain)

($List divides by letters into base $Base and clitic chain $Chain)
	(split $List by @= into $Left and $Right)
	(join words $Left into $Base)
	{
		($Right divides by letters into base $First and clitic chain $Rest)
		($Chain = [$First | $Rest])
	(or)
		%% If the first branch failed, that means we couldn't find any more clitics to split off
		(join words $Right into $First)
		($Chain = [$First])
	}

%% Take the last element and move it to the front
(transpose verb from $Input into $Output)
	(length of $Input into $Length)
	(nth $Input $Length $Verb) %% Verb is the last element
	($Length minus 1 into $Penultimate)
	(take $Penultimate from $Input into $Remaining)
	($Output = [$Verb | $Remaining])

%% Noun list parsing: Hittite sentences tend to go
%% Conn=Clitics [Noun phrases...] Verb
%% So this is to parse a sequence of noun phrases into something like
%% [ [#accusative #Obj1] [#dative #Obj2] ]

%% Base case: a single noun
(parse $Words into noun list $Nouns)
	(parse $Words into single noun $Noun)
	($Nouns = [$Noun])

%% Recursive case: multiple nouns
~(parse [] into noun list $)

(parse $Words into noun list $Nouns)
	*(split $Words anywhere into $Left and $Right)
	*(parse $Left into single noun $Single)
	*(parse $Right into noun list [$First | $Other])
	~($Single = $First) %% Make sure not to split in the middle of a noun phrase!
	($Nouns = [$Single $First | $Other])

%% Now how do we recognize a single noun?
~(parse [] into single noun $)

(parse $Words into single noun $Noun)
	*(grammatical case $Case)
	*(parse $Words as $Case $Obj)
	($Noun = [$Case $Obj])

(grammatical case #accusative)
(grammatical case #dative)
(grammatical case #ablative)
(grammatical case #bare)
(grammatical case #adverb)

%% We include adverbs in the noun list, with the tag #adverb
%% Because they can be interspersed with noun phrases
(parse [$Word] as #adverb $Word)
	(adverb $Word)

(adverb @appa)

(parse [ana/ina/pani | $Words] as #dative $Obj)
	{
		(parse $Words as #bare $Obj)
	(or)
		(parse $Words as #dative $Obj)
	}

(parse [ictu/itti/qadu | $Words] as #ablative $Obj)
	{
		(parse $Words as #bare $Obj)
	(or)
		(parse $Words as #dative $Obj)
	}

(parse $Words as $Case $Obj)
	(determine object $Obj)
		*(object $Obj)
	(from words)
		(dict $Obj in $Case)
	(matching all of $Words)

%% Our representation of an action is [verb [adv] [acc] [dat] [abl]], so now we need to convert a noun list into that
(empty action with verb $Verb is [$Verb [] [] [] []])

%% Noun phrases
(add noun phrases [] to action $Act into $Act)
(add noun phrases [[#adverb/#bare $Adv] | $Rest] to action [$Verb $Advs $Acc $Dat $Abl] into $Out)
	(add noun phrases $Rest to action [$Verb [$Adv|$Advs] $Acc $Dat $Abl] into $Out)
(add noun phrases [[#accusative/#bare $Acc] | $Rest] to action [$Verb $Adv $Accs $Dat $Abl] into $Out)
	(add noun phrases $Rest to action [$Verb $Adv [$Acc|$Accs] $Dat $Abl] into $Out)
(add noun phrases [[#dative/#bare $Dat] | $Rest] to action [$Verb $Adv $Acc $Dats $Abl] into $Out)
	(add noun phrases $Rest to action [$Verb $Adv $Acc [$Dat|$Dats] $Abl] into $Out)
(add noun phrases [[#ablative/#bare $Abl] | $Rest] to action [$Verb $Adv $Acc $Dat $Abls] into $Out)
	(add noun phrases $Rest to action [$Verb $Adv $Acc $Dat [$Abl|$Abls]] into $Out)

%% Change some of these to variables or whatever eventually - this is how the pronouns should be handled
(first person singular #1s)
(second person singular #2s)
(third person singular common #3sc)
(third person singular neuter #3sn)
(third person singular $Which)
	(third person singular common $Which) (or) (third person singular neuter $Which)
(first person plural #1p)
(second person plural #2p)
(third person plural common #3pc)
(third person plural neuter #3pn)
(third person plural $Which)
	(third person plural common $Which) (or) (third person plural neuter $Which)
(reflexive #reflexive)

(sentence particle @kan)

%% Clitics
(convert clitic @mu into noun phrase [#accusative (first person singular $)])
(convert clitic @mu into noun phrase [#dative (first person singular $)])
(convert clitic @nac into noun phrase [#accusative (first person plural $)])
(convert clitic @nac into noun phrase [#dative (first person plural $)])
(convert clitic @ta/@du into noun phrase [#accusative (second person singular $)])
(convert clitic @ta/@du into noun phrase [#dative (second person singular $)])
(convert clitic @cmac into noun phrase [#accusative (second person plural $)])
(convert clitic @cmac into noun phrase [#dative (second person plural $)])
(convert clitic @cmac into noun phrase [#dative (third person plural $)])
(convert clitic @ci into noun phrase [#dative (third person singular $)])
(convert clitic @an into noun phrase [#accusative (third person singular common $)])
(convert clitic @at into noun phrase [#accusative (third person singular neuter $)])
(convert clitic @at into noun phrase [#accusative (third person plural neuter $)])
(convert clitic @e/@i into noun phrase [#accusative (third person plural neuter $)])
(convert clitic @uc/@ac into noun phrase [#accusative (third person plural common $)])
(convert clitic @z/@za into noun phrase [#accusative (reflexive $)])
(convert clitic @z/@za into noun phrase [#dative (reflexive $)])
(convert clitic (sentence particle $Part) into noun phrase [#adverb $Part]) %% Sentence particles work kind of like adverbs, so we deal with them there

(interface (convert clitics $<Input into noun phrases $>Output))
(convert clitics [] into noun phrases [])
(convert clitics [$First|$Rest] into noun phrases [$NewFirst|$NewRest])
	{ *(convert clitic $First into noun phrase $NewFirst) (or) (uppercase) (show parser error 31 for action $First) (stop) }
	*(convert clitics $Rest into noun phrases $NewRest)

(interface (deduplicate $<Input into $>Output))
%% Remove duplicates in case they appear
(deduplicate [$Verb $Advs $Accs $Dats $Abls] into [$Verb $NewAdvs $NewAccs $NewDats $NewAbls])
	(remove duplicates from $Advs into $NewAdvs)
	(remove duplicates from $Accs into $NewAccs)
	(remove duplicates from $Dats into $NewDats)
	(remove duplicates from $Abls into $NewAbls)

(interface (convert parsed line $<Input into $>Output))
%% Now put it together
(convert parsed line [$Verb $Clitics | $Nouns] into $Action)
	(empty action with verb $Verb is $First)
	*(add noun phrases $Nouns to action $First into $Second)
	*(convert clitics $Clitics into noun phrases $ExtraNouns)
	*(add noun phrases $ExtraNouns to action $Second into $Third)
	(deduplicate $Third into $Action)

%% And now, to test it all out!
(old program entry point)
	*(repeat forever)
	> (get input $Raw)
	Input: $Raw (line)
	(rewrite $Raw into [$Verb $Clitics | $Rest])
	Rewritten: [$Verb $Clitics | $Rest] (line)
	*(parse $Rest into noun list $Nouns)
	Parsed: [$Verb $Clitics | $Nouns] (line)
	*(convert parsed line [$Verb $Clitics | $Nouns] into $Action)
	Action: $Action (line)
	(fail)

#lalac %% "tongue"
(dict * in #accusative)
	lalan
(dict * in #dative)
	lali
(dict * in #ablative)
	lalaz
(dict * in #bare)
	lala

#halkic %% "grain"
(dict * in #accusative)
	halkin
(dict * in #dative)
	halki
(dict * in #ablative)
	halkiz
(dict * in #bare)
	halki

#attac %% "father"
(dict * in #accusative)
	attan
(dict * in #dative)
	atti
(dict * in #ablative)
	attaz
(dict * in #bare)
	atta

#É %% "house"
(dict * in $)
	É

(sentence connective @nu)
(sentence connective @na) %% Form that's used before clitics starting with /a/

%% Utilities

(interface (length of $List into $>Number))

(length of [] into 0)
(length of [$ | $More] into $Np1)
	(length of $More into $N)
	($N plus 1 into $Np1)

(interface (nth $List $<Index $Element))

(nth [$Head | $] 1 $Head)
(nth [$ | $Tail] $N $Result)
	($N minus 1 into $Nm1)
	(nth $Tail $Nm1 $Result)

(take 0 from $ into [])
(take $N from [$Head | $MoreIn] into [$Head | $MoreOut])
	($N minus 1 into $Nm1)
	(take $Nm1 from $MoreIn into $MoreOut)

(split [$First $Second | $Tail] anywhere into [$First] and [$Second | $Tail])
(split [$First | $More] anywhere into [$First | $Left] and $Right)
	*(split $More anywhere into $Left and $Right)

(interface (remove duplicates from $<Input into $>Output))

(remove duplicates from [] into [])
	(just)
(remove duplicates from [$Head | $MoreIn] into $MoreOut)
	($Head is one of $MoreIn)
	(just)
	(remove duplicates from $MoreIn into $MoreOut)
(remove duplicates from [$Head | $MoreIn] into [$Head | $MoreOut])
	(remove duplicates from $MoreIn into $MoreOut)

(listing [] $ $ 0)
	nothing
(listing [$Head | $Rest] $PrintClosure $Conjunction $NPrinted)
	(if) (empty $Rest) (or) (empty $Conjunction) (then)
		(if) ($NPrinted > 1) (then) , (endif)
		(if) ($NPrinted > 0) (then) $Conjunction (endif)
	(else)
		(if) ($NPrinted > 0) (then) , (endif)
	(endif)
	(query $PrintClosure $Head)
	($NPrinted plus 1 into $NPp1)
	(if) (nonempty $Rest) (then)
		(listing $Rest $PrintClosure $Conjunction $NPp1)
	(endif)

(listing $List $Closure $Conjunction) %% Convenience predicates
	(listing $List $Closure $Conjunction 0)
(listing $List $Closure)
	(listing $List $Closure @and 0)

%% Now, the parser!

(valid sentence [$Verb | $Nouns])
	*($Verb wants cases $Cases)
	~(noun list $Nouns and case list $Cases produce error $)

(show parser errors for [$Verb | $Nouns])
	*($Verb wants cases $Cases)
	%% Collect all the errors that happen in this particular instance
	(collect $Error)
		*(noun list $Nouns and case list $Cases produce error $Error)
	(into $ErrorList)
	%% If we're displaying errors, and we *have* errors, we should show them first
	(show parser errors $ErrorList for action [$Verb | $Nouns])

%% Error codes:
%%	1$	Missing element
%%	2$	Excess element
%%	3$	Other
%%
%%	00	All good (not handled here)
%%
%%	11	Missing adverb
%%	21	Excess adverb (currently not raised)
%%	12	Missing accusative
%%	22	Excess accusative
%%	13	Missing dative
%%	23	Excess dative
%%	14	Missing ablative
%%	24	Excess ablative
%%
%%	30	Unrecognized verb (not handled here)
%%	31	Unrecognized clitic (not handled here)
%%	32	Unrecognized noun (not handled here)
%%	33	Recognized noun but not in scope (not handled here)
%%	36	Too many multiple objects

(noun list [$Adv $ $ $] and case list $Cases produce error 11)
	(empty $Adv)
	(#adverb is one of $Cases)
%% We do *not* check for excess adverbs at the moment
(noun list [$ $Acc $ $] and case list $Cases produce error 12)
	(empty $Acc)
	(#accusative is one of $Cases)
(noun list [$ $Acc $ $] and case list $Cases produce error 22)
	(nonempty $Acc)
	~(#accusative is one of $Cases)
(noun list [$ $ $Dat $] and case list $Cases produce error 13)
	(empty $Dat)
	(#dative is one of $Cases)
(noun list [$ $ $Dat $] and case list $Cases produce error 23)
	(nonempty $Dat)
	~(#dative is one of $Cases)
(noun list [$ $ $ $Abl] and case list $Cases produce error 14)
	(empty $Abl)
	(#ablative is one of $Cases)
(noun list [$ $ $ $Abl] and case list $Cases produce error 24)
	(nonempty $Abl)
	~(#ablative is one of $Cases)

(noun list [$|$Nouns] and case list $ produce error 36)
	%% Check if there are multiple nouns in multiple cases - we only want to deal with a single multiple object list at a time, to avoid combinatorics
	%% (Adverbs don't count for this)
	(accumulate 1)
		*($Case is one of $Nouns)
		(more than one $Case)
	(into $Count)
	($Count > 1)

(more than one [$ $ | $]) %% Succeeds if the argument is a list with more than one element

(show parser errors [] for action $)
	ERROR: there's an error, but no error code was returned!
(show parser errors [$Single] for action $Action)
	This sentence is difficult to interpret.
	(uppercase) (show parser error $Single for action $Action).
(show parser errors $List for action $Action)
	This sentence is difficult to interpret, for multiple reasons.
	(uppercase) (listing $List {(show parser error $_ for action $Action)}) .

(show parser error  0 for action $)
	ERROR: this error code should not be used!
(show parser error 11 for action $)
	there should be an adverb or sentence particle
(show parser error 21 for action $)
	there should not be an adverb or sentence particle
(show parser error 12 for action $)
	there should be an accusative/absolutive noun
(show parser error 22 for action $)
	there should not be an accusative/absolutive noun
(show parser error 13 for action $)
	there should be a dative/locative noun
(show parser error 23 for action $)
	there should not be a dative/locative noun
(show parser error 14 for action $)
	there should be an ablative/instrumental noun
(show parser error 24 for action $)
	there should not be an ablative/instrumental noun
(show parser error 30 for action $Verb)
	$Verb is not a verb found elsewhere on the tablet
(show parser error 31 for action $Clitic)
	$Clitic is not a clitic found elsewhere on the tablet
(show parser error 32 for action $Noun)
	$Noun is not a noun found elsewhere on the tablet
(show parser error 33 for action $Noun)
	it's unclear what "(no space)(print words $Noun)(no space)" is meant to refer to here
(show parser error 36 for action [$ $ $Acc $Dat $Abl])
	there are multiple nouns in
	(if) (more than one $Acc) (more than one $Dat) (more than one $Abl) (then)
		several different cases
	(elseif) (more than one $Acc) (more than one $Dat) (then)
		the accusative/absolutive and dative/locative cases
	(elseif) (more than one $Acc) (more than one $Abl) (then)
		the accusative/absolutive and ablative/instrumental cases
	(elseif) (more than one $Dat) (more than one $Abl) (then)
		the dative/locative and ablative/instrumental cases
	(else)
		ERROR: What cases??
	(endif)
(show parser error $Err for action $)
	ERROR: Error code $Err not recognized!

%% Main parser structure begins here

(parse commandline $Words)
	(if) (save undo 1) (then)
		The previous lines, starting with "(no space)(print words $Words)(no space)", are crossed out on the tablet.
		(stop)
	(endif)
	(now) ~(allowing parse errors)
	(parse action $Words)

(parse action $Words)
	%% TODO - handle AGAIN and OOPS here if desired
	%% TODO - handle English commands here
	($Words = $Raw)
	
	(rewrite $Raw into [$Verb $Clitics | $Rest])
	(if) ~($Verb wants cases $) (then) %% Not a recognized verb
		(uppercase) (show parser error 30 for action $Verb) . (stop)
	(endif)
	(collect $Action)
		*(parse $Rest into noun list $Nouns)
		*(convert parsed line [$Verb $Clitics | $Nouns] into $Action)
		Considering: $Action (line)
		(valid sentence $Action) %% Only include ones in the final result that don't cause parse errors
	(into $RawOptions)
	(remove duplicates from $RawOptions into $Options)
	
	(if) ($Options = [$Only]) (then) %% Optimize the common case
		(try-complex $Only)
	(elseif) (empty $Options) (then) %% No successful parse, try to give a useful error
		(report errors in $Raw)
	(else)
		(sieve action candidates $Options at level 0)
	(endif)

(report errors in $Words)
	(now) (allowing parse errors) %% Tell the parsing predicates that they should show their errors instead of just silently failing
	(if) %% Multiqueries here not really necessary because if-conditions discard choice points, but it helps optimization according to the stdlib comments
		{ (rewrite $Words into [$Verb $Clitics | $Rest]) (or) Could not split off clitics! TODO (stop) }
		{ *(parse $Rest into noun list $Nouns) (or) Could not parse nouns! TODO (stop) }
		{ *(convert parsed line [$Verb $Clitics | $Nouns] into $Action) (or) Could not convert! TODO (stop) }
	(then)
		(show parser errors for $Action)
	(else)
		This line cannot be parsed, and we're not sure why. Sorry!
	(endif)
	(stop)

(sieve action candidates $All at level $Level) %% Level is how unlikely of actions we should consider
	(if) ($Level = 3) (then)
		($Options = $All)
	(else)
		(collect $A)
			*($A is one of $All)
			~(unlikely $A $Level)
		(into $Options)
	(endif)
	(if) (nonempty $Options) (then)
		(consider action candidates $Options)
	(else)
		($Level plus 1 into $Lp1)
		(sieve action candidates $All at level $Lp1)
	(endif)

(consider action candidates $List)
	(if) ($List = [$Only]) (then) %% Optimize the common case
		(try-complex $Only)
	(else)
		(length of $List into $N)
		This line could be interpreted in multiple ways:
		(enumerate possible actions $List 1)
		(line) Which of these is intended? 
		(get input $Words)
		(if) ($Words = [$Number]) (number $Number) ($Number > 1) ~($Number > $N) (then)
			(nth $List $Number $Result)
			(try-complex $Result)
		(else)
			The previous line may be a scribal error. Ignoring it, we continue on to...
			(now) (deferred commandline $Words)
			(stop)
		(endif)
	(endif)

(global variable (deferred commandline $))
(read-parse-act)
	(rebuild scope)
	(if) (deferred commandline $Words) (then)
		(now) ~(deferred commandline $)
		(stoppable) {
			(parse commandline $Words)
		}
	(else)
		(redraw status bar)
		(prompt and input $Words)
		(stoppable) {
			(parse commandline $Words)
		}
	(endif)

(prompt and input $Words)
	*(repeat forever)
	(line)
	> (get input $Words)
	~($Words = [\* | $]) %% Ignore lines starting with stars, for transcript comments

(new program entry point)
	*(repeat forever)
	(read-parse-act)
	(fail)

(rebuild scope)
(redraw status bar)
(try-complex $Action)
	Trying: $Action (line)
(unlikely $ $) (fail)
(describe action $Action)
	Action: $Action (line)
(print words [])
(print words [$Head|$Tail])
	$Head (print words $Tail)

(@dahhun wants cases [#accusative])
(@tehhun wants cases [#accusative #dative])
(@paun wants cases [#dative])

(enumerate possible actions [] $)
(enumerate possible actions [$Head|$Tail] $N)
	(space 4) $N : (describe action $Head) (line)
	($N plus 1 into $Np1)
	(enumerate possible actions $Tail $Np1)

(program entry point)
	(new program entry point)
